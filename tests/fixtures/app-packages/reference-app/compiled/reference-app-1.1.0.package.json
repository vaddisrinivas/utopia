{
  "schemaVersion": "wonder.app-package.v2",
  "id": "reference-app",
  "version": "1.1.0",
  "collections": {
    "chore": {
      "id": "chore",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "status": { "type": "text" },
        "frequency_label": { "type": "text" },
        "estimated_minutes": { "type": "number" },
        "emoji": { "type": "text" }
      }
    },
    "assignment": {
      "id": "assignment",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "assignee_name": { "type": "text" },
        "due_label": { "type": "text" },
        "emoji": { "type": "text" }
      }
    },
    "household_member": {
      "id": "household_member",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "role": { "type": "text" },
        "active_assignments": { "type": "number" },
        "emoji": { "type": "text" }
      }
    },
    "completion": {
      "id": "completion",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "completed_at": { "type": "timestamp" },
        "completed_by": { "type": "text" },
        "emoji": { "type": "text" }
      }
    }
  },
  "queries": {
    "today_assignments": {
      "from": "records",
      "where": { "op": "eq", "field": "collection", "value": "assignment" }
    },
    "chore_list": {
      "from": "records",
      "where": { "op": "eq", "field": "collection", "value": "chore" }
    },
    "household_roster": {
      "from": "records",
      "where": { "op": "eq", "field": "collection", "value": "household_member" }
    },
    "completion_log": {
      "from": "records",
      "where": { "op": "eq", "field": "collection", "value": "completion" }
    }
  },
  "views": {
    "today_assignments": {
      "id": "today_assignments",
      "query": "today_assignments",
      "mode": "list",
      "fields": ["title", "assignee_name", "due_label"]
    },
    "chore_list": {
      "id": "chore_list",
      "query": "chore_list",
      "mode": "list",
      "fields": ["title", "estimated_minutes", "frequency_label"]
    },
    "household_roster": {
      "id": "household_roster",
      "query": "household_roster",
      "mode": "list",
      "fields": ["title", "role", "active_assignments"]
    },
    "completion_log": {
      "id": "completion_log",
      "query": "completion_log",
      "mode": "list",
      "fields": ["title", "completed_at", "completed_by"]
    }
  },
  "presentation": {
    "label": "Reference App",
    "homeSurface": "today",
    "surfaces": [
      { "id": "today", "label": "Today", "collections": ["assignment"], "views": ["today_assignments"] },
      { "id": "chores", "label": "Chores", "collections": ["chore"], "views": ["chore_list"] },
      { "id": "household", "label": "Household", "collections": ["household_member", "assignment"], "views": ["household_roster"] },
      { "id": "review", "label": "Review", "collections": ["completion"], "views": ["completion_log"] }
    ],
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "today",
      "screens": {
        "today": {
          "title": "Today",
          "subtitle": "Current assignments and due items.",
          "components": [
            {
              "kind": "metric",
              "title": "Open assignments",
              "subtitle": "Current work queue",
              "query": { "collections": ["assignment"], "limit": 8 },
              "tone": "amber"
            },
            {
              "kind": "recordList",
              "title": "Due items",
              "subtitle": "Current assignments",
              "query": { "collections": ["assignment"], "limit": 6 },
              "props": {
                "emptyText": "No assignments due right now.",
                "subtitleFields": ["assignee_name", "due_label"],
                "iconField": "emoji"
              },
              "action": {
                "kind": "propose",
                "label": "Open planner",
                "payload": { "route": "/records" }
              }
            }
          ]
        },
        "chores": {
          "title": "Chores",
          "subtitle": "Every routine task in one list.",
          "components": [
            {
              "kind": "recordList",
              "title": "Chore list",
              "subtitle": "Open or add a chore",
              "query": { "collections": ["chore"], "limit": 8 },
              "props": {
                "emptyText": "No chores ready yet.",
                "subtitleTemplate": "{estimated_minutes} min · {frequency_label}",
                "iconField": "emoji"
              },
              "action": {
                "kind": "propose",
                "label": "Add chore",
                "payload": { "route": "/composer/chore" }
              }
            }
          ]
        },
        "household": {
          "title": "Household",
          "subtitle": "Members and assigned work.",
          "components": [
            {
              "kind": "recordList",
              "title": "Members",
              "subtitle": "Assigned chore summary",
              "query": { "collections": ["household_member"], "limit": 6 },
              "props": {
                "emptyText": "No household members yet.",
                "subtitleTemplate": "{role} · {active_assignments} active",
                "iconField": "emoji"
              }
            },
            {
              "kind": "metric",
              "title": "Assigned chores",
              "subtitle": "Open work across the household",
              "query": { "collections": ["assignment"], "limit": 12 },
              "tone": "moss"
            }
          ]
        },
        "review": {
          "title": "Review",
          "subtitle": "Recent completions.",
          "components": [
            {
              "kind": "recordList",
              "title": "Completion log",
              "subtitle": "Recent work",
              "query": { "collections": ["completion"], "limit": 8 },
              "props": {
                "emptyText": "No completions recorded yet.",
                "subtitleTemplate": "{completed_at} · {completed_by}",
                "iconField": "emoji"
              }
            }
          ]
        }
      }
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": ["reference-renderer"]
}
