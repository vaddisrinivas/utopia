{
  "schemaVersion": "wonder.app-package.v2",
  "id": "expense-splitter",
  "version": "1.0.0",
  "collections": {
    "person": {
      "id": "person",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "email": { "type": "text", "indexed": true },
        "status": { "type": "text", "indexed": true }
      }
    },
    "expense": {
      "id": "expense",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "amount": { "type": "number", "indexed": true },
        "paid_by": { "type": "text", "indexed": true },
        "category": { "type": "text", "indexed": true },
        "status": { "type": "text", "indexed": true },
        "spent_at": { "type": "timestamp", "indexed": true },
        "notes": { "type": "text" }
      }
    },
    "split": {
      "id": "split",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "expense_id": { "type": "text", "indexed": true },
        "person_id": { "type": "text", "indexed": true },
        "share_amount": { "type": "number", "indexed": true },
        "paid_amount": { "type": "number", "indexed": true },
        "status": { "type": "text", "indexed": true },
        "notes": { "type": "text" }
      }
    },
    "payment": {
      "id": "payment",
      "fields": {
        "id": { "type": "text", "required": true, "indexed": true },
        "title": { "type": "text", "required": true, "indexed": true },
        "collection": { "type": "text", "required": true, "indexed": true },
        "updated_at": { "type": "timestamp", "required": true, "indexed": true },
        "properties": { "type": "json", "required": true },
        "from_person": { "type": "text", "indexed": true },
        "to_person": { "type": "text", "indexed": true },
        "amount": { "type": "number", "indexed": true },
        "paid_at": { "type": "timestamp", "indexed": true },
        "status": { "type": "text", "indexed": true }
      }
    }
  },
  "queries": {
    "people": {
      "from": "records",
      "where": { "field": "collection", "op": "eq", "value": "person" },
      "orderBy": [{ "field": "title", "direction": "asc" }],
      "limit": 50
    },
    "expenses": {
      "from": "records",
      "where": { "field": "collection", "op": "eq", "value": "expense" },
      "orderBy": [{ "field": "spent_at", "direction": "desc" }],
      "limit": 100
    },
    "open-debts": {
      "from": "split",
      "where": { "field": "net_delta", "op": "lt", "value": 0 },
      "orderBy": [{ "field": "net_delta", "direction": "asc" }],
      "limit": 100
    },
    "credits": {
      "from": "split",
      "where": { "field": "net_delta", "op": "gt", "value": 0 },
      "orderBy": [{ "field": "net_delta", "direction": "desc" }],
      "limit": 100
    },
    "payments": {
      "from": "records",
      "where": { "field": "collection", "op": "eq", "value": "payment" },
      "orderBy": [{ "field": "paid_at", "direction": "desc" }],
      "limit": 100
    }
  },
  "views": {
    "expenses": {
      "id": "expenses",
      "query": "expenses",
      "mode": "table",
      "fields": ["title", "amount", "paid_by", "category", "status", "spent_at"]
    },
    "debts": {
      "id": "debts",
      "query": "open-debts",
      "mode": "table",
      "fields": ["title", "person_id", "expense_id", "share_amount", "paid_amount", "net_delta", "settlement_label"]
    },
    "credits": {
      "id": "credits",
      "query": "credits",
      "mode": "table",
      "fields": ["title", "person_id", "expense_id", "share_amount", "paid_amount", "net_delta", "settlement_label"]
    }
  },
  "computedFields": [
    {
      "id": "net_delta",
      "collection": "split",
      "dependsOn": [],
      "expression": { "-": [{ "var": "record.paid_amount" }, { "var": "record.share_amount" }] }
    },
    {
      "id": "settlement_label",
      "collection": "split",
      "dependsOn": ["net_delta"],
      "expression": {
        "if": [
          { ">": [{ "var": "computed.net_delta" }, 0] },
          "is owed",
          { "<": [{ "var": "computed.net_delta" }, 0] },
          "owes",
          "settled"
        ]
      }
    }
  ],
  "rules": [
    {
      "id": "review-new-open-debt",
      "trigger": { "kind": "query_transition", "query": "open-debts", "transition": "enter" },
      "when": { ">": [{ "var": "query.after.total" }, { "var": "query.before.total" }] },
      "effect": { "kind": "propose_operation", "operation": "review_expense_settlement" },
      "mode": "suggest",
      "maxRunsPerEvent": 4
    }
  ],
  "capabilities": [],
  "acceptanceTests": ["adversarial-derived-computation"],
  "presentation": {
    "label": "Expense Splitter",
    "homeSurface": "home",
    "surfaces": [
      { "id": "home", "label": "Balances", "collections": ["person", "expense", "split", "payment"], "views": ["debts", "credits"] },
      { "id": "expenses", "label": "Expenses", "collections": ["expense", "split"], "views": ["expenses"] },
      { "id": "payments", "label": "Payments", "collections": ["payment"], "views": ["credits"] }
    ],
    "visualIdentity": {
      "accent": "#1F6FEB",
      "canvas": "#F7F9FC",
      "icon": "wallet",
      "tone": "blue"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "home",
      "screens": {
        "home": {
          "title": "Expense Splitter",
          "subtitle": "Tests computed fields, cross-record query transitions, and the current aggregation boundary.",
          "components": [
            {
              "kind": "metric",
              "title": "Open Debt Rows",
              "subtitle": "Count of split rows where computed net_delta is below zero.",
              "query": { "collections": ["split"], "match": "owes", "limit": 100 },
              "tone": "blue"
            },
            {
              "kind": "recordList",
              "title": "People",
              "subtitle": "Participants render with existing record primitives.",
              "query": { "collections": ["person"], "limit": 12 },
              "props": { "emptyText": "No people yet.", "subtitleFields": ["email", "status"] }
            },
            {
              "kind": "recordList",
              "title": "Open Split Lines",
              "subtitle": "Computed `net_delta` and `settlement_label` are exposed on split rows.",
              "query": { "collections": ["split"], "limit": 20 },
              "props": {
                "emptyText": "No split lines yet.",
                "subtitleFields": ["person_id", "share_amount", "paid_amount", "net_delta", "settlement_label"]
              }
            },
            {
              "kind": "widget",
              "widget": "dataTable",
              "title": "Boundary",
              "subtitle": "This app does not minimize pairwise settlements yet.",
              "tone": "amber",
              "props": {
                "columns": [
                  { "key": "capability", "label": "Capability" },
                  { "key": "status", "label": "Status" }
                ],
                "items": [
                  { "capability": "Per-split net_delta", "status": "Package-only computed field" },
                  { "capability": "Open-debt query transition", "status": "Package-only rule" },
                  { "capability": "Per-person aggregate net balance", "status": "Needs aggregate expression support" },
                  { "capability": "Minimized who-owes-whom settlement", "status": "Still unproven" }
                ]
              }
            }
          ]
        },
        "expenses": {
          "title": "Expenses",
          "subtitle": "Expense records and split lines.",
          "components": [
            {
              "kind": "recordList",
              "title": "Recent Expenses",
              "subtitle": "Newest first.",
              "query": { "collections": ["expense"], "limit": 30 },
              "props": { "emptyText": "No expenses yet.", "subtitleFields": ["amount", "paid_by", "category", "status"] }
            },
            {
              "kind": "recordList",
              "title": "Split Lines",
              "subtitle": "Each row can compute paid minus owed.",
              "query": { "collections": ["split"], "limit": 50 },
              "props": { "emptyText": "No split rows yet.", "subtitleFields": ["expense_id", "person_id", "share_amount", "paid_amount", "net_delta"] }
            }
          ]
        },
        "payments": {
          "title": "Payments",
          "subtitle": "Manual settlement payments.",
          "components": [
            {
              "kind": "recordList",
              "title": "Payments",
              "subtitle": "Manual payments close the loop until settlement generation exists.",
              "query": { "collections": ["payment"], "limit": 30 },
              "props": { "emptyText": "No payments yet.", "subtitleFields": ["from_person", "to_person", "amount", "status"] }
            }
          ]
        }
      }
    }
  }
}
