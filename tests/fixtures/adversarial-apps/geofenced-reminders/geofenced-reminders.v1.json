{
  "schemaVersion": "wonder.app-package.v2",
  "id": "geofenced-reminders",
  "version": "1.0.0",
  "collections": {
    "geofenced_reminders_item": {
      "id": "geofenced_reminders_item",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "priority": {
          "type": "number",
          "indexed": true
        },
        "owner": {
          "type": "text",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "geofenced_reminders_event": {
      "id": "geofenced_reminders_event",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "happened_at": {
          "type": "timestamp",
          "indexed": true
        },
        "value": {
          "type": "number",
          "indexed": true
        },
        "source": {
          "type": "text",
          "indexed": true
        }
      }
    },
    "geofenced_reminders_result": {
      "id": "geofenced_reminders_result",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "score": {
          "type": "number",
          "indexed": true
        },
        "summary": {
          "type": "text"
        },
        "missing_primitive": {
          "type": "text",
          "indexed": true
        }
      }
    }
  },
  "queries": {
    "items": {
      "from": "records",
      "where": {
        "field": "collection",
        "op": "eq",
        "value": "geofenced_reminders_item"
      },
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 50
    },
    "events": {
      "from": "records",
      "where": {
        "field": "collection",
        "op": "eq",
        "value": "geofenced_reminders_event"
      },
      "orderBy": [
        {
          "field": "happened_at",
          "direction": "desc"
        }
      ],
      "limit": 50
    },
    "results": {
      "from": "records",
      "where": {
        "field": "collection",
        "op": "eq",
        "value": "geofenced_reminders_result"
      },
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 20
    }
  },
  "views": {
    "items": {
      "id": "items",
      "query": "items",
      "mode": "list",
      "fields": [
        "title",
        "status",
        "priority",
        "owner"
      ]
    },
    "events": {
      "id": "events",
      "query": "events",
      "mode": "table",
      "fields": [
        "title",
        "happened_at",
        "value",
        "source",
        "status"
      ]
    },
    "results": {
      "id": "results",
      "query": "results",
      "mode": "table",
      "fields": [
        "title",
        "score",
        "summary",
        "missing_primitive",
        "status"
      ]
    }
  },
  "rules": [
    {
      "id": "review-new-test-event",
      "trigger": {
        "kind": "query_transition",
        "query": "events",
        "transition": "enter"
      },
      "when": {
        ">": [
          {
            "var": "query.after.total"
          },
          {
            "var": "query.before.total"
          }
        ]
      },
      "effect": {
        "kind": "propose_operation",
        "operation": "review_adversarial_fixture"
      },
      "mode": "suggest",
      "maxRunsPerEvent": 1
    }
  ],
  "capabilities": [],
  "acceptanceTests": [
    "adversarial-31-native_stream"
  ],
  "presentation": {
    "label": "Geofenced reminders",
    "homeSurface": "home",
    "surfaces": [
      {
        "id": "home",
        "label": "Probe",
        "collections": [
          "geofenced_reminders_item",
          "geofenced_reminders_event",
          "geofenced_reminders_result"
        ],
        "views": [
          "items",
          "results"
        ]
      },
      {
        "id": "events",
        "label": "Events",
        "collections": [
          "geofenced_reminders_event"
        ],
        "views": [
          "events"
        ]
      },
      {
        "id": "boundary",
        "label": "Boundary",
        "collections": [
          "geofenced_reminders_result"
        ],
        "views": [
          "results"
        ]
      }
    ],
    "visualIdentity": {
      "accent": "#8B3A62",
      "canvas": "#FFF6FA",
      "icon": "activity",
      "tone": "rose"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "home",
      "screens": {
        "home": {
          "title": "Geofenced reminders",
          "subtitle": "Adversarial fixture #31: Background location triggers.",
          "components": [
            {
              "kind": "metric",
              "title": "Runtime Axis",
              "subtitle": "native stream",
              "query": {
                "collections": [
                  "geofenced_reminders_result"
                ],
                "limit": 20
              },
              "tone": "rose"
            },
            {
              "kind": "recordList",
              "title": "Fixture Items",
              "subtitle": "Generic records prove the data shell can host the app shape.",
              "query": {
                "collections": [
                  "geofenced_reminders_item"
                ],
                "limit": 20
              },
              "props": {
                "emptyText": "No fixture items yet.",
                "subtitleFields": [
                  "status",
                  "priority",
                  "owner"
                ]
              }
            },
            {
              "kind": "widget",
              "widget": "dataTable",
              "title": "Adversarial Boundary",
              "subtitle": "Needs geofence capability and per-package permission enforcement.",
              "tone": "rose",
              "props": {
                "columns": [
                  {
                    "key": "field",
                    "label": "Field"
                  },
                  {
                    "key": "value",
                    "label": "Value"
                  }
                ],
                "items": [
                  {
                    "field": "Axis",
                    "value": "native stream"
                  },
                  {
                    "field": "Missing primitive",
                    "value": "geofenceTrigger"
                  },
                  {
                    "field": "Current status",
                    "value": "Partial fixture"
                  },
                  {
                    "field": "Package rule",
                    "value": "No app-specific renderer widget allowed"
                  }
                ]
              }
            }
          ]
        },
        "events": {
          "title": "Geofenced reminders Events",
          "subtitle": "Event rows for imports, taps, scans, timers, edits, or generated transitions.",
          "components": [
            {
              "kind": "recordList",
              "title": "Recent Events",
              "subtitle": "Newest first.",
              "query": {
                "collections": [
                  "geofenced_reminders_event"
                ],
                "limit": 50
              },
              "props": {
                "emptyText": "No events yet.",
                "subtitleFields": [
                  "happened_at",
                  "value",
                  "source",
                  "status"
                ]
              }
            }
          ]
        },
        "boundary": {
          "title": "Boundary",
          "subtitle": "What this JSON package proves and what the runtime still lacks.",
          "components": [
            {
              "kind": "widget",
              "widget": "dataTable",
              "title": "Adversarial Boundary",
              "subtitle": "Needs geofence capability and per-package permission enforcement.",
              "tone": "amber",
              "props": {
                "columns": [
                  {
                    "key": "field",
                    "label": "Field"
                  },
                  {
                    "key": "value",
                    "label": "Value"
                  }
                ],
                "items": [
                  {
                    "field": "Axis",
                    "value": "native stream"
                  },
                  {
                    "field": "Missing primitive",
                    "value": "geofenceTrigger"
                  },
                  {
                    "field": "Current status",
                    "value": "Partial fixture"
                  },
                  {
                    "field": "Package rule",
                    "value": "No app-specific renderer widget allowed"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
