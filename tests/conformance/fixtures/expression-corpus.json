    {
      "id": "compat-if-comparison",
      "input": {
        "computed": {
          "net_delta": "-4.50"
        }
      },
      "expression": {
        "if": [
          {
            ">": [{ "var": "computed.net_delta" }, 0]
          },
          "is owed",
          {
            "<": [{ "var": "computed.net_delta" }, 0]
          },
          "owes",
          "settled"
        ]
      },
      "expected": "owes"
    },
    {
      "id": "group-sum-current-record",
      "input": {
        "record": {
          "participant": "amy"
        },
        "queries": {
          "splits": {
            "rows": [
              { "participant": "amy", "paid": "10.005" },
              { "participant": "amy", "paid": 2.335 },
              { "participant": "ben", "paid": "8.10" }
            ]
          }
        }
      },
      "expression": {
        "group_sum": {
          "rows": { "var": "queries.splits.rows" },
          "groupBy": "participant",
          "equals": { "var": "record.participant" },
          "value": "paid"
        }
      },
      "expected": "12.35"
    },
    {
      "id": "weighted-allocation-remainder",
      "input": {
        "rows": [
          { "participant": "amy", "weight": 1 },
          { "participant": "ben", "weight": 1 },
          { "participant": "cara", "weight": 1 }
        ]
      },
      "expression": {
        "allocate_weighted": {
          "rows": { "var": "rows" },
          "key": "participant",
          "weight": "weight",
          "total": "100.00"
        }
      },
      "expected": [
        { "key": "amy", "amount": "33.34", "weight": "1.00" },
        { "key": "ben", "amount": "33.33", "weight": "1.00" },
        { "key": "cara", "amount": "33.33", "weight": "1.00" }
      ]
    },
    {
      "id": "decimal-rounding-half-away",
