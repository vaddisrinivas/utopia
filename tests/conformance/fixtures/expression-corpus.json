      },
      "expected": "2.35"
    },
    {
      "id": "weighted-allocation-key-order-stable",
      "input": {
        "rows": [
          { "participant": "zara", "weight": 3 },
          { "participant": "amy", "weight": 1 },
          { "participant": "ben", "weight": "2" }
        ]
      },
      "expression": {
        "allocate_weighted": {
          "rows": { "var": "rows" },
          "key": "participant",
          "weight": "weight",
          "total": "10.00"
        }
      },
      "expected": [
        { "key": "amy", "amount": "1.67", "weight": "1.00" },
        { "key": "ben", "amount": "3.33", "weight": "2.00" },
        { "key": "zara", "amount": "5.00", "weight": "3.00" }
      ]
    },
    {
      "id": "null-loses-nullability",
      "input": {},
      "expression": {
        "if": [
          { "var": "missing" },
          "has value",
          null
        ]
      },
      "expected": null
    },
    {
      "id": "balance-transfers-deterministic",
      "input": {
        "rows": [
          { "participant": "amy", "paid": "50.00", "owed": "20.00" },
          { "participant": "ben", "paid": "10.00", "owed": "20.00" },
          { "participant": "cara", "paid": "0.00", "owed": "20.00" }
        ]
      },
      "expression": {
        "balance_transfers": {
          "rows": { "var": "rows" },
          "participant": "participant",
          "paid": "paid",
          "owed": "owed"
        }
      },
      "expected": [
        { "from": "cara", "to": "amy", "amount": "20.00" },
        { "from": "ben", "to": "amy", "amount": "10.00" }
      ]
    },
    {
      "id": "relation-traversal-bounded",
      "input": {
        "record": {
          "relations": [
            { "name": "member", "target_id": "amy" },
            { "name": "member", "target_id": "cara" },
            { "name": "ignored", "target_id": "ben" }
          ]
        },
        "people": [
          { "id": "cara", "title": "Cara" },
          { "id": "amy", "title": "Amy" },
          { "id": "ben", "title": "Ben" }
        ]
      },
      "expression": {
        "relation_rows": {
          "rows": { "var": "people" },
          "relations": { "var": "record.relations" },
          "name": "member"
        }
      },
      "expected": [
        { "id": "cara", "title": "Cara" },
        { "id": "amy", "title": "Amy" }
      ]
    }
  ],
  "recurrenceNextCases": [
    {
      "id": "recurrence-next-daily-utc",
      "input": {
        "recurrence": {
          "schemaVersion": "utopia.recurrence.v1",
          "timezone": "UTC",
          "anchor": "2026-07-30T00:00:00Z",
          "dstPolicy": "compatible",
          "rules": [
            { "id": "daily", "kind": "interval", "every": 1, "unit": "day" }
          ]
        }
      },
      "expression": {
        "recurrence_next": {
          "schedule": { "var": "recurrence" },
          "after": "2026-07-30T00:00:00Z"
        }
      },
      "expected": {
        "instant": "2026-07-31T00:00:00.000Z",
        "timezone": "UTC",
        "local": "2026-07-31T00:00:00",
        "offset": "+00:00",
        "source": {
          "kind": "rule",
          "ids": ["daily"],
          "ruleKinds": ["interval"]
        },
        "sequence": 0
      }
    }
  ],
  "recurrenceExpandCases": [
    {
      "id": "recurrence-expand-hostile-budget",
      "input": {
        "recurrence": {
          "schemaVersion": "utopia.recurrence.v1",
          "timezone": "UTC",
          "anchor": "2026-07-30T00:00:00Z",
          "dstPolicy": "compatible",
          "rules": [
            { "id": "daily", "kind": "interval", "every": 1, "unit": "day" }
          ]
        }
      },
      "expression": {
        "recurrence_expand": {
          "schedule": { "var": "recurrence" },
          "after": "2026-07-30T00:00:00Z",
          "limit": 2,
          "budget": {
            "maxOccurrences": 1,
            "maxIterations": 8,
            "maxRuleEvaluations": 16,
            "maxLookaheadDays": 7,
            "maxExclusions": 4,
            "maxOverrides": 4
          }
        }
      },
      "expected": {
        "status": "refused",
        "reason": "recurrence_limit_exceeds_budget"
      },
      "expectedRefusal": "recurrence_limit_exceeds_budget"
    },
    {
      "id": "recurrence-expand-two-occurrences-utc",
      "input": {
        "recurrence": {
          "schemaVersion": "utopia.recurrence.v1",
          "timezone": "UTC",
          "anchor": "2026-07-30T00:00:00Z",
          "dstPolicy": "compatible",
          "rules": [
            { "id": "daily", "kind": "interval", "every": 1, "unit": "day" }
          ]
        }
      },
      "expression": {
        "recurrence_expand": {
          "schedule": { "var": "recurrence" },
          "after": "2026-07-30T00:00:00Z",
          "limit": 2
        }
      },
      "expected": {
        "status": "ok",
        "exhausted": false,
        "occurrences": [
          {
            "instant": "2026-07-31T00:00:00.000Z",
            "timezone": "UTC",
            "local": "2026-07-31T00:00:00",
            "offset": "+00:00"
          },
          {
            "instant": "2026-08-01T00:00:00.000Z",
            "timezone": "UTC",
            "local": "2026-08-01T00:00:00",
            "offset": "+00:00"
          }
        ]
      }
    }
  ],
