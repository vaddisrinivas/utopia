  "queryCases": [
    {
      "id": "stable-ordering-decimal-strings",
      "rows": [
        { "id": "b", "amount": "4.00", "status": "open" },
        { "id": "a", "amount": "4.00", "status": "open" },
        { "id": "c", "amount": "2.50", "status": "closed" }
      ],
      "spec": {
        "from": "records",
        "where": {
          "op": "eq",
          "field": "status",
          "value": "open"
        },
        "orderBy": [
          { "field": "amount", "direction": "desc" }
        ],
        "project": ["id", "amount"]
      },
      "expectedRows": [
        { "id": "a", "amount": "4.00" },
        { "id": "b", "amount": "4.00" }
      ]
    }
  ],
  "computedFieldCases": [
    {
      "id": "participant-balance-overlay",
      "record": {
        "id": "split-1",
        "collection": "split",
        "participant": "amy",
        "share_amount": "6.17"
      },
      "rows": [
        { "id": "split-1", "collection": "split", "participant": "amy", "paid_amount": "10.005", "share_amount": "6.17" },
        { "id": "split-2", "collection": "split", "participant": "amy", "paid_amount": "2.335", "share_amount": "6.18" },
        { "id": "split-3", "collection": "split", "participant": "ben", "paid_amount": "8.10", "share_amount": "8.10" }
      ],
      "queries": {
        "splits": {
          "from": "split",
          "project": ["id", "participant", "paid_amount", "share_amount"],
          "orderBy": [{ "field": "id", "direction": "asc" }]
        }
      },
      "specs": [
        {
          "id": "group_paid",
          "collection": "split",
          "dependsOn": [],
          "expression": {
            "group_sum": {
              "rows": { "var": "queries.splits.rows" },
              "groupBy": "participant",
              "equals": { "var": "record.participant" },
              "value": "paid_amount"
            }
          }
        },
        {
          "id": "net_delta",
          "collection": "split",
          "dependsOn": ["group_paid"],
          "expression": {
            "-": [{ "var": "computed.group_paid" }, { "var": "record.share_amount" }]
          }
        }
      ],
      "expected": {
        "order": ["group_paid", "net_delta"],
        "values": {
          "group_paid": "12.35",
          "net_delta": "6.18"
        }
      }
    }
  ]
}
