{
  "rules": [
    { "id": "utopia-schema-id", "path": "$.$id", "pattern": "^https://wonder.local/schemas/" },
    { "id": "utopia-schema-dialect", "path": "$.$schema", "equals": "http://json-schema.org/draft-07/schema#" },
    { "id": "utopia-schema-root-type", "path": "$.type", "equals": "object" },
    { "id": "utopia-schema-root-closed", "path": "$.additionalProperties", "equals": false }
  ]
}
