{
  "schemaVersion": "wonder.app-package.v2",
  "id": "scientific-calculator",
  "version": "1.0.0",
  "collections": {
    "calculation": {
      "id": "calculation",
      "fields": {
        "collection": {
          "indexed": true,
          "required": true,
          "type": "text"
        },
        "expression": {
          "indexed": true,
          "type": "text"
        },
        "id": {
          "indexed": true,
          "required": true,
          "type": "text"
        },
        "mode": {
          "indexed": true,
          "type": "text"
        },
        "notes": {
          "type": "text"
        },
        "properties": {
          "required": true,
          "type": "json"
        },
        "result": {
          "indexed": true,
          "type": "text"
        },
        "title": {
          "indexed": true,
          "required": true,
          "type": "text"
        },
        "updated_at": {
          "indexed": true,
          "required": true,
          "type": "timestamp"
        }
      }
    }
  },
  "queries": {
    "history": {
      "from": "records",
      "where": {
        "field": "collection",
        "op": "eq",
        "value": "calculation"
      },
      "orderBy": [
        {
          "direction": "desc",
          "field": "updated_at"
        }
      ],
      "limit": 50
    }
  },
  "views": {
    "functions": {
      "id": "functions",
      "query": "history",
      "mode": "table",
      "fields": [
        "title",
        "expression",
        "result",
        "mode"
      ]
    },
    "history": {
      "id": "history",
      "query": "history",
      "mode": "table",
      "fields": [
        "title",
        "expression",
        "result",
        "mode",
        "notes",
        "updated_at"
      ]
    },
    "home": {
      "id": "home",
      "query": "history",
      "mode": "list",
      "fields": [
        "title",
        "expression",
        "result",
        "mode",
        "updated_at"
      ]
    }
  },
  "presentation": {
    "label": "Scientific Calculator",
    "homeSurface": "home",
    "surfaces": [
      {
        "id": "functions",
        "label": "Functions",
        "collections": [
          "calculation"
        ],
        "views": [
          "functions"
        ]
      },
      {
        "id": "history",
        "label": "History",
        "collections": [
          "calculation"
        ],
        "views": [
          "history"
        ]
      },
      {
        "id": "home",
        "label": "Calculator",
        "collections": [
          "calculation"
        ],
        "views": [
          "home"
        ]
      }
    ],
    "visualIdentity": {
      "accent": "#1F6FEB",
      "canvas": "#F7F9FC",
      "icon": "calc",
      "tone": "blue"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "home",
      "screens": {
        "functions": {
          "title": "Functions",
          "subtitle": "Reference table for scientific calculator notation.",
          "components": [
            {
              "kind": "widget",
              "props": {
                "columns": [
                  {
                    "key": "name",
                    "label": "Name"
                  },
                  {
                    "key": "syntax",
                    "label": "Syntax"
                  },
                  {
                    "key": "example",
                    "label": "Example"
                  }
                ],
                "items": [
                  {
                    "example": "sin(pi / 2)",
                    "name": "Sine",
                    "syntax": "sin(x)"
                  },
                  {
                    "example": "cos(60 deg)",
                    "name": "Cosine",
                    "syntax": "cos(x)"
                  },
                  {
                    "example": "tan(45 deg)",
                    "name": "Tangent",
                    "syntax": "tan(x)"
                  },
                  {
                    "example": "ln(e)",
                    "name": "Natural log",
                    "syntax": "ln(x)"
                  },
                  {
                    "example": "log10(1000)",
                    "name": "Base-10 log",
                    "syntax": "log10(x)"
                  },
                  {
                    "example": "sqrt(144)",
                    "name": "Square root",
                    "syntax": "sqrt(x)"
                  }
                ]
              },
              "subtitle": "Accepted expression names",
              "title": "Function Reference",
              "tone": "amber",
              "widget": "dataTable"
            }
          ]
        },
        "history": {
          "title": "History",
          "subtitle": "Saved calculation records.",
          "components": [
            {
              "kind": "recordList",
              "props": {
                "emptyText": "No saved calculations yet.",
                "subtitleFields": [
                  "expression",
                  "result",
                  "mode",
                  "notes"
                ]
              },
              "query": {
                "collections": [
                  "calculation"
                ],
                "limit": 50
              },
              "subtitle": "Newest first",
              "title": "Saved Calculations"
            }
          ]
        },
        "home": {
          "title": "Calculator",
          "subtitle": "Scientific calculator package: expression entry, constants, functions, and saved calculation history.",
          "components": [
            {
              "kind": "widget",
              "props": {
                "angleMode": "deg",
                "initialExpression": "",
                "initialResult": "0"
              },
              "subtitle": "Local tap calculator with trig, logs, powers, constants, factorial, memory, degrees, and radians.",
              "title": "Scientific Calculator",
              "tone": "blue",
              "widget": "scientificCalculator"
            },
            {
              "kind": "text",
              "subtitle": "Supported notation: +, -, *, /, %, ^, parentheses, sin, cos, tan, asin, acos, atan, ln, log/log10, sqrt, abs, exp, factorial, pi, e, M.",
              "title": "Expression Support",
              "tone": "neutral"
            },
            {
              "kind": "widget",
              "props": {
                "columns": [
                  {
                    "key": "group",
                    "label": "Group"
                  },
                  {
                    "key": "keys",
                    "label": "Keys"
                  },
                  {
                    "key": "notes",
                    "label": "Notes"
                  }
                ],
                "items": [
                  {
                    "group": "Arithmetic",
                    "keys": "+ - * / % ^",
                    "notes": "Order of operations with parentheses"
                  },
                  {
                    "group": "Trig",
                    "keys": "sin cos tan asin acos atan",
                    "notes": "Declare degrees or radians"
                  },
                  {
                    "group": "Logs",
                    "keys": "ln log10 exp",
                    "notes": "Natural log, base-10 log, e^x"
                  },
                  {
                    "group": "Powers",
                    "keys": "sqrt x^2 x^y factorial",
                    "notes": "Roots, exponents, n!"
                  },
                  {
                    "group": "Constants",
                    "keys": "pi e",
                    "notes": "High precision constants"
                  }
                ]
              },
              "subtitle": "Core keypad map",
              "title": "Scientific Keys",
              "tone": "blue",
              "widget": "dataTable"
            },
            {
              "kind": "widget",
              "props": {
                "columns": [
                  {
                    "key": "label",
                    "label": "Example"
                  },
                  {
                    "key": "expression",
                    "label": "Expression"
                  },
                  {
                    "key": "mode",
                    "label": "Mode"
                  }
                ],
                "items": [
                  {
                    "expression": "(1 + 0.065 / 12) ^ 60",
                    "label": "Compound",
                    "mode": "Exact numeric"
                  },
                  {
                    "expression": "sin(45 deg) + cos(pi / 4)",
                    "label": "Trig",
                    "mode": "Mixed units stated"
                  },
                  {
                    "expression": "ln(e ^ 3) + log10(1000)",
                    "label": "Log",
                    "mode": "Symbolic constants"
                  },
                  {
                    "expression": "sqrt(2) ^ 2",
                    "label": "Root",
                    "mode": "Precision check"
                  }
                ]
              },
              "subtitle": "Paste one into Ask",
              "title": "Examples",
              "tone": "moss",
              "widget": "dataTable"
            },
            {
              "kind": "recordList",
              "props": {
                "emptyText": "No saved calculations yet.",
                "subtitleFields": [
                  "expression",
                  "result",
                  "mode"
                ]
              },
              "query": {
                "collections": [
                  "calculation"
                ],
                "limit": 8
              },
              "subtitle": "Saved calculations appear here.",
              "title": "History"
            }
          ]
        }
      }
    },
    "sourceSchemaVersion": "wonder.package-source.v1"
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "schema-native"
  ]
}
