{
  "expo": {
    "name": "Utopia",
    "slug": "manasa",
    "description": "A local-first AI food workspace for pantry, meals, recipes, shopping, and trusted source sync.",
    "version": "1.0.0",
    "platforms": [
      "web",
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "utopia",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.utopia",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "app.utopia",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F5F4EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Utopia to attach meal, receipt, pantry, and cooking photos to your kitchen notes.",
          "cameraPermission": "Allow Utopia to capture meal, receipt, pantry, and cooking photos."
        }
      ],
      "react-native-health-connect",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F2"
        }
      ],
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "text/uri-list",
              "image/*"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01515db7-1b6c-446c-ba67-876165ecc438"
      }
    },
    "owner": "manasaivaturis-team"
  }
}
