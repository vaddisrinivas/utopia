  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.2",
    "postcss": "8.5.25",
    "gaxios": "7.3.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "catalog:import": "tsx scripts/import-corpus.ts",
    "catalog:enrich:check": "tsx scripts/enrich-catalog.ts --dry-run",
    "catalog:generate": "tsx scripts/validate-catalog.ts && node scripts/generate-catalog.mjs",
    "catalog:similarity": "node scripts/quality/report-catalog-similarity.mjs",
    "catalog:dedupe": "npm run catalog:similarity && node scripts/apply-catalog-lifecycle.mjs",
    "pretypecheck": "npm run catalog:generate",
    "typecheck": "tsc --noEmit",
    "preconfig:validate": "npm run catalog:generate",
    "test": "vitest run tests/kernel-v2",
    "check:kernel-v2": "vitest run tests/kernel-v2 && node scripts/quality/check-kernel-v2-size.mjs",
    "config:validate": "npm run check:kernel-v2",
    "doctor": "expo-doctor",
    "export:web": "npm run catalog:generate && expo export --platform web --output-dir dist/web",
    "export:android": "npm run catalog:generate && expo export --platform android --output-dir dist/android",
    "export:ios": "npm run catalog:generate && expo export --platform ios --output-dir dist/ios",
    "server:dev": "tsx server/index.ts",
    "phase3:check:chat-send": "vitest run tests/kernel-v2/server.test.ts",
    "phase3:check:chat-rollback-idempotency": "vitest run tests/kernel-v2/server.test.ts"
  }
}
