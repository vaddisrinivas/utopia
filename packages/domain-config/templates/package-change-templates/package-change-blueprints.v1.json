{
  "schema_version": "wonder.package-change-blueprints.v1",
  "theme": {
    "visualIdentity": {
      "schemaVersion": "wonder.visual-identity.v1",
      "mood": "warm, minimal, alive",
      "colors": {
        "background": "#FFF7EA",
        "card": "#FFFFFF",
        "text": "#241C16",
        "primary": "#2F7448",
        "accent": "#F3B15E",
        "calm": "#B9DCE8"
      },
      "radius": {
        "card": 24,
        "chip": 999
      },
      "density": "compact-cute"
    },
    "screen": {
      "components": [
        {
          "kind": "widget",
          "widget": "themePreview",
          "id": "{{screenId}}_theme_preview",
          "title": "{{label}} theme",
          "subtitle": "Tokenized visual identity preview."
        },
        {
          "kind": "text",
          "id": "{{screenId}}_theme_note",
          "title": "Design tokens",
          "subtitle": "Background, card, text, primary, accent, radius, and density now live in package config."
        }
      ]
    }
  },
  "workflow": {
    "rule": {
      "trigger": {
        "kind": "query_transition",
        "query": "expiring_inventory",
        "transition": "enter"
      },
      "when": {
        "==": [
          { "var": "collection" },
          "inventory"
        ]
      },
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "food.dinner.suggest"
        }
      },
      "mode": "suggest",
      "maxRunsPerEvent": 1
    },
    "screen": {
      "components": [
        {
          "kind": "widget",
          "widget": "postCard",
          "id": "{{screenId}}_workflow_hero",
          "title": "{{label}} workflow",
          "subtitle": "Rule added as suggestion-only.",
          "props": {
            "body": "When inventory enters the expiring set, Wonder can suggest dinner instead of silently mutating data."
          }
        },
        {
          "kind": "widget",
          "widget": "feedList",
          "id": "{{screenId}}_workflow_feed",
          "title": "Workflow receipts",
          "subtitle": "Approvals and receipts remain visible only when you open this control surface."
        }
      ]
    }
  }
}
