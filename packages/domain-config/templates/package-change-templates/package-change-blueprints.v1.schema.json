{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wonder.local/schemas/package-change-blueprints.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "theme", "workflow"],
  "properties": {
    "schema_version": { "const": "wonder.package-change-blueprints.v1" },
    "theme": { "$ref": "#/$defs/themeBlueprint" },
    "workflow": { "$ref": "#/$defs/workflowBlueprint" }
  },
  "$defs": {
    "themeBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualIdentity", "screen"],
      "properties": {
        "visualIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "mood", "colors", "radius", "density"],
          "properties": {
            "schemaVersion": { "const": "wonder.visual-identity.v1" },
            "mood": { "type": "string", "minLength": 1 },
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "required": ["background", "card", "text", "primary", "accent", "calm"],
              "properties": {
                "background": { "$ref": "#/$defs/hexColor" },
                "card": { "$ref": "#/$defs/hexColor" },
                "text": { "$ref": "#/$defs/hexColor" },
                "primary": { "$ref": "#/$defs/hexColor" },
                "accent": { "$ref": "#/$defs/hexColor" },
                "calm": { "$ref": "#/$defs/hexColor" }
              }
            },
            "radius": {
              "type": "object",
              "additionalProperties": false,
              "required": ["card", "chip"],
              "properties": {
                "card": { "type": "integer", "minimum": 0 },
                "chip": { "type": "integer", "minimum": 0 }
              }
            },
            "density": { "const": "compact-cute" }
          }
        },
        "screen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["components"],
          "properties": {
            "components": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/themePreviewComponent" },
                { "$ref": "#/$defs/themeNoteComponent" }
              ],
              "items": false
            }
          }
        }
      }
    },
    "workflowBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "screen"],
      "properties": {
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger", "when", "effect", "mode", "maxRunsPerEvent"],
          "properties": {
            "trigger": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "query", "transition"],
              "properties": {
                "kind": { "const": "query_transition" },
                "query": { "const": "expiring_inventory" },
                "transition": { "const": "enter" }
              }
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "required": ["=="],
              "properties": {
                "==": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["var"],
                      "properties": {
                        "var": { "const": "collection" }
                      }
                    },
                    { "const": "inventory" }
                  ],
                  "items": false
                }
              }
            },
            "effect": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "operation"],
              "properties": {
                "kind": { "const": "propose_operation" },
                "operation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "tool"],
                  "properties": {
                    "kind": { "const": "custom" },
                    "tool": { "const": "food.dinner.suggest" }
                  }
                }
              }
            },
            "mode": { "const": "suggest" },
            "maxRunsPerEvent": { "const": 1 }
          }
        },
        "screen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["components"],
          "properties": {
            "components": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/workflowHeroComponent" },
                { "$ref": "#/$defs/workflowFeedComponent" }
              ],
              "items": false
            }
          }
        }
      }
    },
    "themePreviewComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "widget", "id", "title", "subtitle"],
      "properties": {
        "kind": { "const": "widget" },
        "widget": { "const": "themePreview" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 }
      }
    },
    "themeNoteComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title", "subtitle"],
      "properties": {
        "kind": { "const": "text" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 }
      }
    },
    "workflowHeroComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "widget", "id", "title", "subtitle", "props"],
      "properties": {
        "kind": { "const": "widget" },
        "widget": { "const": "postCard" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": {
            "body": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "workflowFeedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "widget", "id", "title", "subtitle"],
      "properties": {
        "kind": { "const": "widget" },
        "widget": { "const": "feedList" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 }
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
