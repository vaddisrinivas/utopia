                "appearance": "ledger",
                "progressiveDisclosure": false,
                "metadataFields": [
                  {
                    "field": "title",
                    "label": "Supply",
                    "type": "text",
                    "required": true,
                    "filterable": true
                  },
                  {
                    "field": "checked",
                    "label": "Ready",
                    "type": "select",
                    "options": [
                      "true",
                      "false"
                    ],
                    "required": true,
                    "filterable": true
                  },
                  {
                    "field": "category",
                    "label": "Category",
                    "type": "text",
                    "filterable": true
                  },
                  {
                    "field": "expiration_date",
                    "label": "Expiration date",
                    "type": "text",
                    "filterable": true
                  },
                  {
                    "field": "priority",
                    "label": "Priority",
                    "type": "number",
                    "filterable": true
                  }
                ],
                "sorts": [
                  "manual",
                  {
                    "kind": "field",
                    "field": "title",
                    "label": "Supply"
                  }
                ],
                "filterFields": [
                  "title",
                  "checked",
                  "category",
                  "expiration_date",
                  "priority"
                ],
                "accessibility": {
                  "role": "form",
                  "accessibleLabel": "Record editor",
                  "minTouchTarget": 48,
                  "focusOrder": [
                    "title",
                    "checked",
                    "category",
                    "expiration_date",
                    "priority"
                  ]
                },
                "commandPolicy": {
                  "autosave": "blur",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 10000
                  },
                  "confirmation": {
                    "required": false,
                    "message": "Save this change?"
                  },
                  "offline": "local",
                  "validation": {
                    "mode": "submit",
                    "requiredFields": [
                      "title",
                      "checked"
                    ]
                  },
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 604800000
                  },
                  "accessibleStatus": {
                    "enabled": true,
                    "labels": {
                      "pending": "Saving changes",
                      "saved": "Changes saved",
                      "error": "Fix highlighted fields",
                      "queued": "Saved offline",
                      "undone": "Change undone",
                      "cancelled": "Change cancelled"
                    }
