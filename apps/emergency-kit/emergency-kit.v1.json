{
  "schemaVersion": "wonder.app-package.v2",
  "id": "emergency-kit",
  "version": "1.0.0",
  "collections": {
    "emergency_item": {
      "id": "emergency_item",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "checked": {
          "type": "boolean",
          "required": true,
          "indexed": true
        },
        "category": {
          "type": "text",
          "indexed": true
        },
        "expiration_date": {
          "type": "text"
        },
        "priority": {
          "type": "number"
        },
        "position": {
          "type": "number"
        }
      }
    }
  },
  "queries": {
    "emergency_item-records": {
      "from": "emergency_item",
      "orderBy": [
        {
          "field": "priority",
          "direction": "asc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "emergency_item-records": {
      "id": "emergency_item-records",
      "query": "emergency_item-records",
      "mode": "list",
      "fields": [
        "title",
        "checked",
        "category",
        "expiration_date",
        "priority"
        ,"position"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "emergency-kit-toggle",
    "emergency-kit-filter-by-group",
    "emergency-kit-resume-after-restart",
    "emergency-kit-accessible-state"
  ],
  "presentation": {
    "label": "Emergency Kit Checklist",
    "homeSurface": "overview",
    "surfaces": [
      {
        "id": "overview",
        "label": "Overview",
        "icon": "shield-check",
        "collections": [
          "emergency_item"
        ],
        "views": [
          "emergency_item-records"
        ]
      },
      {
        "id": "edit",
        "label": "Edit",
        "icon": "edit-3",
        "collections": [
          "emergency_item"
        ],
        "views": [
          "emergency_item-records"
        ]
      },
      {
        "id": "detail",
        "label": "Detail",
        "icon": "list",
        "collections": [
          "emergency_item"
        ],
        "views": [
          "emergency_item-records"
        ]
      },
      {
        "id": "history",
        "label": "History",
        "icon": "rotate-ccw",
        "collections": [
          "emergency_item"
        ],
        "views": [
          "emergency_item-records"
        ]
      },
      {
        "id": "analytics",
        "label": "Analytics",
        "icon": "bar-chart",
        "collections": [
          "emergency_item"
        ],
        "views": [
          "emergency_item-records"
        ]
      },
      {
        "id": "settings",
        "label": "Settings",
        "icon": "settings",
        "collections": [
          "emergency_item"
        ],
        "views": [
          "emergency_item-records"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "shield-alert",
      "tone": "amber",
      "accent": "#9A3412",
      "canvas": "#FFF7ED"
