  "computedFields": [
    {
      "id": "work_hours",
      "collection": "work_entry",
      "dependsOn": [],
      "expression": {
        "/": [
          {
            "var": "record.duration_minutes"
          },
          60
        ]
      }
    },
    {
      "id": "billable_amount",
      "collection": "work_entry",
      "dependsOn": [
        "work_hours"
      ],
      "expression": {
        "*": [
          {
            "var": "computed.work_hours"
          },
          {
            "var": [
              "record.hourly_rate",
              0
            ]
          },
          {
            "var": [
              "record.differential_multiplier",
              1
            ]
          }
        ]
      }
    }
  ]
