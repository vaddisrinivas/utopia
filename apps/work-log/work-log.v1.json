  "queries": {
    "recent-work": {
      "from": "work_entry",
      "orderBy": [
        {
          "field": "work_date",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "open-work": {
      "from": "work_entry",
      "where": {
        "field": "status",
        "op": "eq",
        "value": "open"
      },
      "orderBy": [
        {
          "field": "work_date",
          "direction": "desc"
        }
      ],
      "limit": 50
    },
    "unpaid-work": {
      "from": "work_entry",
      "where": {
        "field": "paid_status",
        "op": "eq",
        "value": "unpaid"
      },
      "orderBy": [
        {
          "field": "work_date",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "clients": {
      "from": "client",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "projects": {
      "from": "project",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "tasks": {
      "from": "task",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 200
    }
  },
  "views": {
    "recent": {
      "id": "recent",
      "query": "recent-work",
      "mode": "table",
      "fields": [
        "title",
        "work_date",
        "client",
        "project",
        "task",
        "duration_minutes",
        "work_hours",
        "hourly_rate",
        "billable_amount",
        "paid_status",
        "status"
      ]
    },
    "open": {
      "id": "open",
      "query": "open-work",
      "mode": "list",
      "fields": [
        "title",
        "client",
        "project",
        "task",
        "duration_minutes",
        "blocker",
        "status"
      ]
    },
    "unpaid": {
      "id": "unpaid",
      "query": "unpaid-work",
      "mode": "table",
      "fields": [
        "title",
        "client",
        "project",
        "billable_amount",
        "paid_status"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
