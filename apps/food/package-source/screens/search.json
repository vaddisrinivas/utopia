{
  "collections": [
    "household",
    "member",
    "food_item",
    "product",
    "inventory",
    "inventory_lot",
    "inventory_movement",
    "ingredient",
    "recipe",
    "recipe_revision",
    "recipe_step",
    "recipe_tool",
    "meal_template",
    "meal_plan",
    "meal_log",
    "meal_consumption",
    "shopping_list",
    "shopping_item",
    "shopping_demand",
    "purchase",
    "purchase_line",
    "store",
    "preference",
    "nutrition_goal",
    "nutrition_profile",
    "nutrition_observation",
    "attachment",
    "audit_event",
    "source_record"
  ],
  "components": [
    {
      "id": "food-search-command",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "collection": "records",
        "emptyText": "Search starts after typing.",
        "metadataFields": [
          {
            "field": "collection",
            "filterable": true,
            "label": "Type",
            "type": "text"
          },
          {
            "field": "status",
            "filterable": true,
            "label": "Status",
            "type": "text"
          },
          {
            "field": "updated_at",
            "label": "Updated",
            "sortable": true,
            "type": "timestamp"
          }
        ],
        "minTapTarget": 44,
        "placeholder": "Search salmon, expiring, receipts, pantry...",
        "progressiveDisclosure": true
      },
      "query": {
        "collections": [
          "household",
          "member",
          "food_item",
          "product",
          "inventory",
          "inventory_lot",
          "inventory_movement",
          "ingredient",
          "recipe",
          "recipe_revision",
          "recipe_step",
          "recipe_tool",
          "meal_template",
          "meal_plan",
          "meal_log",
          "meal_consumption",
          "shopping_list",
          "shopping_item",
          "shopping_demand",
          "purchase",
          "purchase_line",
          "store",
          "preference",
          "nutrition_goal",
          "nutrition_profile",
          "nutrition_observation",
          "attachment",
          "audit_event",
          "source_record"
        ],
        "limit": 100
      },
      "subtitle": "Recent searches, source filters, and result rows.",
      "title": "Search everything",
      "tone": "blue",
      "widget": "structuredList"
    },
    {
      "id": "food-search-recents",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "groups": [
          {
            "items": [
              {
                "badge": "fresh",
                "emoji": "timer",
                "route": "/collection/inventory,inventory_lot?match=expir",
                "subtitle": "Food at freshness risk.",
                "title": "Use soon"
              },
              {
                "badge": "Reviewed",
                "emoji": "receipt",
                "route": "/collection/purchase,purchase_line",
                "subtitle": "Drafts and purchases.",
                "title": "Receipts"
              },
              {
                "badge": "gaps",
                "emoji": "list",
                "route": "/collection/shopping_demand",
                "subtitle": "Missing items by plan.",
                "title": "Recipe gaps"
              },
              {
                "badge": "sources",
                "emoji": "link",
                "route": "/sources",
                "subtitle": "Provider records and conflicts.",
                "title": "Sources"
              }
            ],
            "title": "Try"
          }
        ],
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "household",
          "member",
          "food_item",
          "product",
          "inventory",
          "inventory_lot",
          "inventory_movement",
          "ingredient",
          "recipe",
          "recipe_revision",
          "recipe_step",
          "recipe_tool",
          "meal_template",
          "meal_plan",
          "meal_log",
          "meal_consumption",
          "shopping_list",
          "shopping_item",
          "shopping_demand",
          "purchase",
          "purchase_line",
          "store",
          "preference",
          "nutrition_goal",
          "nutrition_profile",
          "nutrition_observation",
          "attachment",
          "audit_event",
          "source_record"
        ],
        "limit": 100
      },
      "subtitle": "Common food questions without chat clutter.",
      "title": "Fast filters",
      "tone": "moss",
      "widget": "groupedRecordShelf"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "search",
  "label": "Search",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "search",
    "density": "compact",
    "layoutMode": "searchWorkspace",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "Find any food, recipe, receipt, purchase, source, or setting."
}
