{
  "collections": [
    "shopping_list",
    "shopping_item",
    "shopping_demand",
    "purchase",
    "purchase_line",
    "store"
  ],
  "components": [
    {
      "id": "food-shop-list",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "autoSaveEdits": true,
        "collection": "shopping_item",
        "commandPolicy": {
          "accessibleStatus": true,
          "autosave": "change",
          "confirmation": {
            "message": "Review destructive changes before applying them.",
            "required": false
          },
          "draftPersistence": {
            "enabled": true,
            "scope": "local"
          },
          "offline": "local",
          "optimistic": true,
          "restartRecovery": {
            "enabled": true,
            "maxAgeMs": 86400000
          },
          "undo": true
        },
        "deletable": true,
        "editable": true,
        "emptyText": "No shopping gaps right now.",
        "minTapTarget": 44,
        "placeholder": "Add grocery..."
      },
      "query": {
        "collections": [
          "shopping_item"
        ],
        "limit": 100
      },
      "subtitle": "Add, check off, reorder, and keep reasons attached.",
      "title": "Shopping list",
      "tone": "blue",
      "widget": "quickAddList"
    },
    {
      "id": "food-shop-demand",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "groups": [
          {
            "items": [
              {
                "badge": "recipe",
                "emoji": "circle",
                "route": "/collection/shopping_demand?match=tomato",
                "subtitle": "Needed for chickpea wraps.",
                "title": "Tomatoes"
              },
              {
                "badge": "recipe",
                "emoji": "circle",
                "route": "/collection/shopping_demand?match=vinegar",
                "subtitle": "Needed for salmon bowl.",
                "title": "Rice vinegar"
              }
            ],
            "title": "Recipe gaps"
          },
          {
            "items": [
              {
                "badge": "low",
                "emoji": "circle",
                "route": "/collection/shopping_item?match=oats",
                "subtitle": "Breakfast staple below threshold.",
                "title": "Oats"
              },
              {
                "badge": "2",
                "emoji": "circle",
                "route": "/collection/shopping_item?match=eggs",
                "subtitle": "Two left.",
                "title": "Eggs"
              }
            ],
            "title": "Low stock"
          }
        ],
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "shopping_demand",
          "shopping_item"
        ],
        "limit": 100
      },
      "subtitle": "Missing from recipe, low stock, household request, or receipt correction.",
      "title": "Why to buy",
      "tone": "amber",
      "widget": "groupedRecordShelf"
    },
    {
      "id": "food-shop-receipt-review",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "actions": [
          {
            "route": "/capture?mode=receipt",
            "title": "Review receipt"
          },
          {
            "route": "/collection/purchase,purchase_line?title=Purchases",
            "title": "Open purchases"
          }
        ],
        "badge": "Review required",
        "items": [
          {
            "status": "ready",
            "subtitle": "Maps to inventory lot",
            "title": "Spinach 16 oz"
          },
          {
            "status": "review",
            "subtitle": "Opened item? needs confirmation",
            "title": "Greek yogurt"
          },
          {
            "status": "needs choice",
            "subtitle": "Choose food item or skip",
            "title": "Unknown bakery item"
          }
        ],
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "purchase",
          "purchase_line"
        ],
        "limit": 100
      },
      "subtitle": "Approve imported grocery rows before they touch inventory.",
      "title": "Receipt review",
      "tone": "plum",
      "widget": "recordReviewCard"
    },
    {
      "id": "food-recovery-state",
      "kind": "text",
      "props": {
        "minTapTarget": 44,
        "role": "status",
        "state": "recovery",
        "visibleWhen": "recovery"
      },
      "subtitle": "Recovered drafts show as review rows before any inventory change applies.",
      "title": "Restore shopping state",
      "tone": "neutral"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "shopping-cart",
  "label": "Shop",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "shop",
    "density": "comfortable",
    "layoutMode": "shoppingWorkspace",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "One list, grouped by why each item exists."
}
