{
  "collections": [
    "inventory",
    "meal_plan",
    "recipe",
    "shopping_item"
  ],
  "components": [
    {
      "id": "food-chat-context",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "badge": "Review required",
        "body": "Ask about dinner, inventory, recipes, shopping gaps, or saved changes. Writes need approval.",
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "inventory",
          "recipe",
          "shopping_item"
        ],
        "limit": 100
      },
      "subtitle": "Answers cite records and produce reviewable actions.",
      "title": "Ask with local context",
      "tone": "plum",
      "widget": "recordHeroSummary"
    },
    {
      "action": {
        "command": "plan_food_from_records",
        "kind": "propose",
        "label": "Plan from my kitchen",
        "payload": {
          "route": "/chat?prompt=Plan%20from%20my%20current%20food%20records.&run=1"
        }
      },
      "id": "food-chat-plan",
      "kind": "action",
      "subtitle": "Use current records and review before saving.",
      "title": "Plan from my kitchen",
      "tone": "plum"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "sparkles",
  "label": "Ask",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "chat",
    "density": "focused",
    "layoutMode": "assistantWorkspace",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "Ask about food records; proposed changes remain review-required."
}
