{
  "collections": [
    "source_record",
    "audit_event",
    "attachment"
  ],
  "components": [
    {
      "id": "food-sources-status",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "homes": [
          {
            "status": "ready",
            "subtitle": "Local-first default",
            "title": "SQLite"
          },
          {
            "status": "Needs sign in",
            "subtitle": "Disposable or selected Food page",
            "title": "Notion"
          },
          {
            "status": "Needs sign in",
            "subtitle": "Selected workbook only",
            "title": "Google Sheets"
          },
          {
            "status": "optional",
            "subtitle": "Hosted workspace later",
            "title": "Postgres"
          }
        ],
        "minTapTarget": 44,
        "provider": "food"
      },
      "query": {
        "collections": [
          "source_record"
        ],
        "limit": 100
      },
      "subtitle": "SQLite, Notion, Sheets, and Postgres show readiness and freshness.",
      "title": "Connected homes",
      "tone": "blue",
      "widget": "providerStatus"
    },
    {
      "id": "food-sources-history",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "collection": "source_record",
        "limit": 30,
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "source_record",
          "audit_event"
        ],
        "limit": 100
      },
      "subtitle": "Imports, conflicts, and recovery receipts.",
      "title": "Source activity",
      "tone": "neutral",
      "widget": "operationHistory"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "database",
  "label": "Sources",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "sources",
    "density": "comfortable",
    "layoutMode": "providerWorkspace",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "Connected homes and import status without saved secrets."
}
