{
  "collections": [
    "meal_consumption",
    "nutrition_goal",
    "nutrition_observation",
    "nutrition_profile"
  ],
  "components": [
    {
      "id": "food-health-status",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "consentRequired": true,
        "minTapTarget": 44,
        "noSilentStart": true
      },
      "query": {
        "collections": [
          "nutrition_observation"
        ],
        "limit": 100
      },
      "subtitle": "Optional hydration, nutrition, steps, calories, and weight access.",
      "title": "Health Connect",
      "tone": "blue",
      "widget": "healthConnect"
    },
    {
      "id": "food-health-permissions",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "minTapTarget": 44,
        "permissions": [
          {
            "id": "health-connect-read-nutrition",
            "permission": "android.permission.health.READ_NUTRITION",
            "platform": "android",
            "prompt": "Allow Utopia to read nutrition records for food context.",
            "reason": "Use nutrition and food-health context only when the user enables Health Connect.",
            "required": false
          },
          {
            "id": "health-connect-read-hydration",
            "permission": "android.permission.health.READ_HYDRATION",
            "platform": "android",
            "prompt": "Allow Utopia to read hydration records for food context.",
            "reason": "Use hydration records as optional food-health context after user approval.",
            "required": false
          },
          {
            "id": "health-connect-read-steps",
            "permission": "android.permission.health.READ_STEPS",
            "platform": "android",
            "prompt": "Allow Utopia to read step records for food context.",
            "reason": "Use step trends as optional planning context after user approval.",
            "required": false
          },
          {
            "id": "health-connect-read-active-calories",
            "permission": "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
            "platform": "android",
            "prompt": "Allow Utopia to read active calorie records for food context.",
            "reason": "Use active calorie context only when the user enables Health Connect.",
            "required": false
          },
          {
            "id": "health-connect-read-weight",
            "permission": "android.permission.health.READ_WEIGHT",
            "platform": "android",
            "prompt": "Allow Utopia to read weight records for food context.",
            "reason": "Use weight context only when the user enables Health Connect.",
            "required": false
          },
          {
            "id": "health-connect-write-hydration-proof",
            "permission": "android.permission.health.WRITE_HYDRATION",
            "platform": "android",
            "prompt": "Allow Utopia to write a disposable hydration proof record.",
            "reason": "Run a user-approved disposable Health Connect write/read/delete proof.",
            "required": false
          },
          {
            "id": "camera-photo-library",
            "permission": "expo-image-picker:media-library",
            "platform": "expo",
            "prompt": "Allow Utopia to choose photos for receipts and food capture.",
            "reason": "Attach receipts, pantry photos, food labels, and meal images to food records.",
            "required": false
          },
          {
            "id": "share-intent",
            "permission": "expo-sharing",
            "platform": "expo",
            "prompt": "Allow Utopia to use the share sheet for food capture.",
            "reason": "Save food links, recipes, videos, and shopping context into the active package.",
            "required": false
          }
        ]
      },
      "query": {
        "collections": [
          "nutrition_goal"
        ],
        "limit": 100
      },
      "subtitle": "All Health Connect grants are optional and revocable.",
      "title": "Health permissions",
      "tone": "amber",
      "widget": "permissionCard"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "heart-pulse",
  "label": "Health",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "health",
    "density": "comfortable",
    "layoutMode": "permissionWorkspace",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "Optional nutrition context. No health data without Android permission."
}
