        "badge": "Local",
        "minTapTarget": 44,
        "stats": [
          {
            "label": "relations",
            "value": "3"
          },
          {
            "label": "sources",
            "value": "1"
          }
        ]
      },
      "query": {
        "collections": [
          "household",
          "member",
          "food_item",
          "product",
          "inventory",
          "inventory_lot",
          "inventory_movement",
          "ingredient",
