          "store",
          "preference",
          "nutrition_goal",
          "nutrition_profile",
          "nutrition_observation",
          "attachment",
          "audit_event",
          "source_record"
        ],
        "limit": 100
      },
      "subtitle": "Status, source, relations, and next action.",
      "title": "Selected record",
      "tone": "moss",
      "widget": "recordHeroSummary"
    },
    {
      "id": "food-record-content",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "body": "Record detail renders source data, not hardcoded app copy.",
        "chips": [
          {
            "label": "editable"
          },
          {
            "label": "Source attached"
          },
          {
            "label": "restorable"
          }
        ],
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "household",
          "member",
          "food_item",
          "product",
          "inventory",
          "inventory_lot",
          "inventory_movement",
          "ingredient",
          "recipe",
          "recipe_revision",
          "recipe_step",
          "recipe_tool",
          "meal_template",
          "meal_plan",
          "meal_log",
          "meal_consumption",
          "shopping_list",
          "shopping_item",
          "shopping_demand",
          "purchase",
          "purchase_line",
          "store",
          "preference",
          "nutrition_goal",
          "nutrition_profile",
          "nutrition_observation",
          "attachment",
          "audit_event",
          "source_record"
        ],
        "limit": 100
      },
      "subtitle": "Body, rich detail, and source quotes.",
      "title": "Details",
      "tone": "neutral",
      "widget": "recordContentCard"
    },
    {
      "id": "food-record-history",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "collection": "records",
        "limit": 25,
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "audit_event"
        ],
        "limit": 100
      },
      "subtitle": "Every change has a visible trail.",
      "title": "Record history",
      "tone": "amber",
      "widget": "operationHistory"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "file-text",
  "label": "Record",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "record",
    "density": "comfortable",
    "layoutMode": "recordDetail",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "One source-backed record with actions, relations, history, and evidence."
}
