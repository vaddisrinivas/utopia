{
  "collections": [
    "attachment",
    "food_item",
    "purchase",
    "purchase_line",
    "source_record"
  ],
  "components": [
    {
      "id": "food-capture-smart",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "commandPolicy": {
          "accessibleStatus": true,
          "autosave": "manual",
          "confirmation": {
            "message": "Review destructive changes before applying them.",
            "required": false
          },
          "draftPersistence": {
            "enabled": true,
            "scope": "local"
          },
          "offline": "local",
          "optimistic": true,
          "restartRecovery": {
            "enabled": true,
            "maxAgeMs": 86400000
          },
          "undo": true
        },
        "defaultMode": "manual",
        "emptyText": "Choose a capture mode.",
        "minTapTarget": 44,
        "modes": [
          "manual",
          "photo",
          "receipt",
          "link",
          "voice"
        ]
      },
      "query": {
        "collections": [
          "attachment",
          "source_record"
        ],
        "limit": 100
      },
      "subtitle": "Every capture becomes a reviewable draft with source attached.",
      "title": "Capture queue",
      "tone": "moss",
      "widget": "smartCapture"
    },
    {
      "id": "food-capture-camera",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "capability": "camera.scan",
        "minTapTarget": 44,
        "noSilentStart": true,
        "purpose": "Capture shelf photos and receipts for review."
      },
      "query": {
        "collections": [
          "attachment",
          "purchase"
        ],
        "limit": 100
      },
      "subtitle": "Camera access is requested only after you tap scan.",
      "title": "Photo and receipt scan",
      "tone": "blue",
      "widget": "cameraScanner"
    },
    {
      "id": "food-capture-manual",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "autosave": "onBlur",
        "errorText": "Item name is required.",
        "fields": [
          {
            "id": "title",
            "label": "Item",
            "required": true,
            "type": "text"
          },
          {
            "id": "status",
            "label": "Status",
            "options": [
              "available",
              "use soon",
              "to buy",
              "review"
            ],
            "type": "select"
          },
          {
            "id": "meta",
            "label": "Shelf or source",
            "type": "text"
          },
          {
            "id": "body",
            "label": "Notes",
            "type": "text"
          }
        ],
        "minTapTarget": 44,
        "submitLabel": "Save draft"
      },
      "query": {
        "collections": [
          "food_item",
          "inventory"
        ],
        "limit": 100
      },
      "subtitle": "Name, shelf, status, notes, and source.",
      "title": "Manual food item",
      "tone": "amber",
      "widget": "formCard"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "plus-circle",
  "label": "Capture",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "capture",
    "density": "focused",
    "layoutMode": "captureWorkspace",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "Receipt, shelf photo, food note, recipe link, or voice note."
}
