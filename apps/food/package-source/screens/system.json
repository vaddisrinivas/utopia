{
  "collections": [
    "audit_event",
    "source_record"
  ],
  "components": [
    {
      "id": "food-system-provider",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "minTapTarget": 44,
        "provider": "summary"
      },
      "query": {
        "collections": [
          "source_record"
        ],
        "limit": 100
      },
      "subtitle": "Checks source freshness, locks, and recovery state.",
      "title": "App health",
      "tone": "blue",
      "widget": "providerStatus"
    },
    {
      "id": "food-system-history",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "collection": "audit_event",
        "limit": 50,
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "audit_event"
        ],
        "limit": 100
      },
      "subtitle": "Local evidence without secrets.",
      "title": "Diagnostics history",
      "tone": "neutral",
      "widget": "operationHistory"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "wrench",
  "label": "System",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "system",
    "density": "compact",
    "layoutMode": "diagnostics",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "Diagnostics, locks, and recovery history."
}
