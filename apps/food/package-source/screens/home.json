{
  "collections": [
    "meal_plan",
    "inventory",
    "inventory_lot",
    "shopping_item",
    "recipe"
  ],
  "components": [
    {
      "id": "food-home-hero",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "actions": [
          {
            "route": "/chat?prompt=Plan%20tonight%20from%20use-first%20food%20and%20shopping%20gaps.&run=1",
            "title": "Plan dinner"
          },
          {
            "route": "/capture",
            "title": "Capture food"
          }
        ],
        "badge": "Food",
        "body": "Open the app and immediately know what to cook, what to rescue, and what to buy.",
        "emoji": "🍽️",
        "minTapTarget": 44,
        "stats": [
          {
            "label": "use first",
            "value": "4"
          },
          {
            "label": "planned",
            "value": "2"
          },
          {
            "label": "gaps",
            "value": "7"
          }
        ]
      },
      "query": {
        "collections": [
          "meal_plan",
          "inventory",
          "shopping_item"
        ],
        "limit": 20
      },
      "subtitle": "4 use-first items | 2 meals planned | 7 shopping gaps",
      "title": "Tonight is solvable",
      "tone": "moss",
      "widget": "recordHeroSummary"
    },
    {
      "id": "food-home-use-first",
      "kind": "widget",
      "props": {
        "accessibleLabel": "Use-first food carousel",
        "accessibleStatus": {
          "enabled": true
        },
        "cta": "Plan with these",
        "ctaRoute": "/chat?prompt=Make%20the%20best%20meal%20from%20the%20use-first%20shelf.&run=1",
        "items": [
          {
            "badge": "2d",
            "emoji": "leaf",
            "route": "/collection/inventory,inventory_lot?title=Use%20first&match=spinach",
            "subtitle": "Fridge | 2 days | eggs, dal, wraps",
            "title": "Spinach"
          },
          {
            "badge": "open",
            "emoji": "bowl",
            "route": "/record/pantry-yogurt",
            "subtitle": "Opened | breakfast bowls or marinade",
            "title": "Greek yogurt"
          },
          {
            "badge": "today",
            "emoji": "berries",
            "route": "/collection/inventory,inventory_lot?title=Use%20first&match=blueberries",
            "subtitle": "Use tonight or freeze",
            "title": "Blueberries"
          },
          {
            "badge": "cook",
            "emoji": "fish",
            "route": "/record/inventory-salmon",
            "subtitle": "Thawed | dinner anchor",
            "title": "Salmon"
          }
        ],
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "inventory",
          "inventory_lot"
        ],
        "limit": 100
      },
      "subtitle": "Opened, thawed, and expiring food before anything else.",
      "title": "Use first",
      "tone": "amber",
      "widget": "horizontalRecordCarousel"
    },
    {
      "id": "food-home-next-meals",
      "kind": "widget",
      "props": {
        "accessibleLabel": "Next meals timeline",
        "accessibleStatus": {
          "enabled": true
        },
        "items": [
          {
            "route": "/record/meal-yogurt-bowl",
            "subtitle": "Uses blueberries and walnuts.",
            "time": "Breakfast",
            "title": "Greek yogurt bowl"
          },
          {
            "route": "/chat?prompt=Build%20lunch%20from%20chickpeas%20and%20spinach.&run=1",
            "subtitle": "Tomatoes are the only gap.",
            "time": "Lunch",
            "title": "Chickpea spinach wraps"
          },
          {
            "route": "/record/meal-salmon-bowl",
            "subtitle": "Cucumber and rice vinegar from receipt.",
            "time": "Dinner",
            "title": "Salmon rice bowl"
          }
        ],
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "meal_plan",
          "recipe"
        ],
        "limit": 100
      },
      "subtitle": "Meal plan, prep, and gaps stay visible.",
      "title": "Next meals",
      "tone": "blue",
      "widget": "recordTimeline"
    },
    {
      "id": "food-home-quick-capture",
      "kind": "widget",
      "props": {
        "accessibleStatus": {
          "enabled": true
        },
        "groups": [
          {
            "items": [
              {
                "badge": "scan",
                "emoji": "receipt",
                "route": "/capture?mode=receipt",
                "subtitle": "Review groceries into rows.",
                "title": "Receipt"
              },
              {
                "badge": "photo",
                "emoji": "camera",
                "route": "/capture?mode=photo",
                "subtitle": "Capture pantry or fridge state.",
                "title": "Shelf photo"
              },
              {
                "badge": "link",
                "emoji": "link",
                "route": "/capture?mode=link",
                "subtitle": "Save a recipe from web or video.",
                "title": "Recipe link"
              },
              {
                "badge": "type",
                "emoji": "edit",
                "route": "/capture?mode=manual",
                "subtitle": "One item, no ceremony.",
                "title": "Manual item"
              }
            ],
            "subtitle": "Get data in first. Organize after.",
            "title": "Capture"
          }
        ],
        "minTapTarget": 44
      },
      "query": {
        "collections": [
          "food_item",
          "purchase",
          "attachment"
        ],
        "limit": 100
      },
      "subtitle": "Receipt, shelf photo, recipe link, or manual item.",
      "title": "Add fast",
      "tone": "moss",
      "widget": "groupedRecordShelf"
    },
    {
      "id": "food-empty-state",
      "kind": "text",
      "props": {
        "minTapTarget": 44,
        "role": "status",
        "state": "empty",
        "visibleWhen": "empty"
      },
      "subtitle": "Capture a receipt or add one item; the rest of the workspace appears from real rows.",
      "title": "No food records yet",
      "tone": "neutral"
    },
    {
      "id": "food-loading-state",
      "kind": "text",
      "props": {
        "minTapTarget": 44,
        "role": "status",
        "state": "loading",
        "visibleWhen": "loading"
      },
      "subtitle": "Keep the last local view visible while sources refresh.",
      "title": "Loading food workspace",
      "tone": "neutral"
    }
  ],
  "fields": [
    "title",
    "status",
    "meta",
    "body",
    "updated_at"
  ],
  "icon": "home",
  "label": "Today",
  "mode": "list",
  "query": "all-food-records",
  "shell": {
    "accessibility": {
      "announcements": true,
      "focusOrder": "document",
      "minimumTargetSize": 44,
      "nonColorStatus": true
    },
    "activeTab": "home",
    "density": "comfortable",
    "firstViewport": "nextDecision",
    "layoutMode": "householdFoodToday",
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 1120,
      "narrowPadding": 16,
      "tracks": [
        "primary",
        "supporting"
      ],
      "widePadding": 32
    },
    "scrollable": true,
    "tabs": [
      {
        "id": "home",
        "label": "Today",
        "screen": "home"
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "screen": "kitchen"
      },
      {
        "id": "plan",
        "label": "Plan",
        "screen": "plan"
      },
      {
        "id": "shop",
        "label": "Shop",
        "screen": "shop"
      },
      {
        "id": "search",
        "label": "Search",
        "screen": "search"
      }
    ],
    "theme": {
      "accent": "#2F7448",
      "accentContrast": "#FFFFFF",
      "border": "#D7E2D4",
      "canvas": "#F5F7EF",
      "danger": "#B42318",
      "ink": "#241C16",
      "muted": "#607066",
      "statusError": "#FCE4E1",
      "statusInfo": "#DCECF5",
      "statusSuccess": "#DDF4E4",
      "statusWarning": "#FFF0C9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#2F744814"
    }
  },
  "subtitle": "Next meal, use-first food, shopping pressure, and one-tap capture."
}
