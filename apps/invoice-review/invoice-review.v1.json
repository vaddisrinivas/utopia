            }
          },
          "components": [
            {
              "id": "invoice-recovery-history",
              "kind": "widget",
              "widget": "operationHistory",
              "title": "Recovery and approval trail",
              "props": {
                "collection": "invoice_line",
                "limit": 50,
                "emptyText": "Recovered drafts and approvals appear here.",
                "showUndoable": true,
                "showPersistedState": true
              }
            },
            {
              "id": "invoice-history-table",
              "kind": "widget",
              "widget": "dataTable",
              "title": "Invoice change table",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 200
              },
              "props": {
                "columns": [
                  {
                    "key": "invoice_id",
                    "label": "Invoice"
                  },
                  {
                    "key": "title",
                    "label": "Line"
                  },
                  {
                    "key": "discount_rate",
                    "label": "Discount"
                  },
                  {
                    "key": "gross_total",
                    "label": "Gross"
                  }
                ],
                "emptyText": "No invoice history yet.",
                "density": "compact",
                "stickyHeader": true,
                "keyboardNavigation": true,
                "dataBinding": {
                  "source": "query-records",
                  "resultFields": [
                    "invoice_id",
                    "title",
                    "discount_rate",
                    "gross_total"
                  ]
                }
              }
            },
            {
              "id": "invoice-recover-action",
              "kind": "action",
              "title": "Recover local invoice draft",
              "placement": "inline",
              "tone": "amber",
              "action": {
                "kind": "propose",
                "command": "invoice_review_recover_draft",
                "payload": {
                  "collection": "invoice_line"
                }
              }
            }
          ]
        },
        "settings": {
          "title": "Review rules",
          "subtitle": "Set tax defaults, approval thresholds, and export behavior.",
          "shell": {
            "layoutMode": "settingsWorkspace",
            "appBarTitle": "Invoice Review",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "settings",
            "tabs": [
              {
                "id": "overview",
                "screen": "overview",
                "label": "Review"
              },
              {
                "id": "capture",
                "screen": "capture",
                "label": "Lines"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Totals"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Audit"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Rules"
              }
            ],
            "theme": {
              "canvas": "#F7F9FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E6EEF8",
              "ink": "#172033",
              "muted": "#5C697C",
              "accent": "#265C9A",
              "accentContrast": "#FFFFFF",
              "border": "#CAD6E6",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEBFA",
              "statusSuccess": "#DCF2EC",
              "statusWarning": "#FFF2C2",
              "statusError": "#FCE2DF"
            },
            "responsive": {
              "breakpoint": 760,
              "maxContentWidth": 780,
              "narrowPadding": 16,
              "widePadding": 32,
              "phoneColumns": 1,
              "desktopColumns": 8
            },
            "accessibility": {
              "focusOrder": "document",
              "minimumTargetSize": 44,
              "announces": [
                "loading",
                "saved",
                "error",
                "offline",
                "recovered"
              ],
              "chartSummaries": true,
              "reducedMotion": true
            }
          },
          "components": [
            {
              "id": "invoice-settings-form",
              "kind": "widget",
              "widget": "formCard",
              "title": "Invoice defaults",
              "props": {
                "fields": [
                  {
                    "id": "default_tax_rate",
                    "label": "Default tax rate",
                    "type": "number",
                    "required": true
                  },
                  {
                    "id": "approval_threshold",
                    "label": "Approval threshold",
                    "type": "number"
                  },
                  {
                    "id": "export_format",
                    "label": "Export format",
                    "type": "select",
                    "options": [
                      "pdf-preview",
                      "csv"
                    ],
                    "required": true
                  },
                  {
                    "id": "payment_status_source",
                    "label": "Payment status source",
                    "type": "text"
                  }
                ],
                "submitLabel": "Save settings",
                "requiredIndicator": true,
                "commandPolicy": {
                  "autosave": "blur",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 10000
                  },
                  "offline": "queue",
                  "validation": {
                    "mode": "submit",
                    "requiredFields": [
                      "default_tax_rate",
                      "export_format"
                    ]
                  },
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 604800000
                  },
                  "accessibleStatus": {
                    "enabled": true,
                    "labels": {
                      "pending": "Saving changes",
                      "saved": "Changes saved",
                      "error": "Fix highlighted fields",
                      "queued": "Saved offline",
                      "undone": "Change undone",
                      "cancelled": "Change cancelled"
                    }
                  }
                },
                "emptyText": "Settings are stored locally."
              }
            },
            {
              "id": "invoice-offline-queue",
              "kind": "widget",
              "widget": "providerStatus",
              "title": "Offline review queue",
              "props": {
                "status": "local",
                "emptyText": "Draft approvals queue locally when offline.",
                "checks": [
                  "drafts",
                  "validation",
                  "recovery"
                ]
              }
            },
            {
              "id": "invoice-export-action",
              "kind": "action",
              "title": "Prepare reviewed invoice packet",
              "placement": "inline",
              "tone": "blue",
              "action": {
                "kind": "propose",
                "command": "invoice_review_prepare_export",
                "payload": {
                  "query": "invoice_line-records"
                }
              }
            }
          ]
        }
      }
    }
  },
  "computedFields": [
    {
      "id": "line_total",
      "collection": "invoice_line",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "var": "record.quantity"
          },
          {
            "var": "record.unit_price"
          }
        ]
      }
    },
    {
      "id": "tax_amount",
      "collection": "invoice_line",
      "dependsOn": [
        "line_total"
      ],
      "expression": {
        "*": [
          {
            "var": "computed.line_total"
          },
          {
            "/": [
              {
                "var": "record.tax_rate"
              },
              100
            ]
          }
        ]
      }
    },
    {
      "id": "gross_total",
      "collection": "invoice_line",
      "dependsOn": [
        "line_total",
        "tax_amount"
      ],
      "expression": {
        "+": [
          {
            "var": "computed.line_total"
          },
          {
            "var": "computed.tax_amount"
          }
        ]
      }
    }
  ]
}
