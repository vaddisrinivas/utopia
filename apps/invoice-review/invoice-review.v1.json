{
  "schemaVersion": "wonder.app-package.v2",
  "id": "invoice-review",
  "version": "2.0.0",
  "collections": {
    "invoice_line": {
      "id": "invoice_line",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "quantity": {
          "type": "number",
          "required": true
        },
        "unit_price": {
          "type": "number",
          "required": true
        },
        "tax_rate": {
          "type": "number",
          "required": true
        },
        "line_total": {
          "type": "number"
        },
        "invoice_id": {
          "type": "text",
          "indexed": true
        },
        "discount_rate": {
          "type": "number"
        },
        "tax_amount": {
          "type": "number"
        },
        "gross_total": {
          "type": "number"
        }
      }
    }
  },
  "queries": {
    "invoice_line-records": {
      "from": "invoice_line",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "invoice_line-records": {
      "id": "invoice_line-records",
      "query": "invoice_line-records",
      "mode": "list",
      "fields": [
        "title",
        "invoice_id",
        "quantity",
        "unit_price",
        "discount_rate",
        "line_total",
        "tax_rate",
        "tax_amount",
        "gross_total"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "invoice-review-line-extension",
    "invoice-review-tax-rounding",
    "invoice-review-invoice-total",
    "invoice-review-deterministic-replay"
  ],
  "presentation": {
    "label": "Invoice Review",
    "homeSurface": "overview",
    "surfaces": [
      {
        "id": "overview",
        "label": "Review queue",
        "collections": [
          "invoice_line"
        ],
        "views": [
          "invoice_line-records"
        ]
      },
      {
        "id": "capture",
        "label": "Build invoice",
        "collections": [
          "invoice_line"
        ],
        "views": [
          "invoice_line-records"
        ]
      },
      {
        "id": "reports",
        "label": "Totals",
        "collections": [
          "invoice_line"
        ],
        "views": [
          "invoice_line-records"
        ]
      },
      {
        "id": "history",
        "label": "History",
        "collections": [
          "invoice_line"
        ],
        "views": [
          "invoice_line-records"
        ]
      },
      {
        "id": "settings",
        "label": "Settings",
        "collections": [
          "invoice_line"
        ],
        "views": [
          "invoice_line-records"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "file-check-2",
      "tone": "blue",
      "accent": "#265C9A",
      "canvas": "#F7F9FE",
      "identity": "A pre-send invoice control desk where line math, tax, and approval state are visible together.",
      "typography": {
        "heading": "precise review",
        "body": "finance ledger"
      },
      "rationale": "Cool blue review surfaces and dense totals separate this approval workflow from fuel logging and collections aging."
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "overview",
      "navigation": {
        "items": [
          {
            "screen": "overview",
            "label": "Review",
            "icon": "check"
          },
          {
            "screen": "capture",
            "label": "Lines",
            "icon": "plus"
          },
          {
            "screen": "reports",
            "label": "Totals",
            "icon": "calculator"
          },
          {
            "screen": "history",
            "label": "Audit",
            "icon": "rotate-ccw"
          },
          {
            "screen": "settings",
            "label": "Rules",
            "icon": "settings"
          }
        ]
      },
      "screens": {
        "overview": {
          "title": "Pre-send review",
          "subtitle": "Approve the invoice only after line math, tax, and gross total agree.",
          "shell": {
            "layoutMode": "dashboardWorkspace",
            "appBarTitle": "Invoice Review",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "overview",
            "tabs": [
              {
                "id": "overview",
                "screen": "overview",
                "label": "Review"
              },
              {
                "id": "capture",
                "screen": "capture",
                "label": "Lines"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Totals"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Audit"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Rules"
              }
            ],
            "theme": {
              "canvas": "#F7F9FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E6EEF8",
              "ink": "#172033",
              "muted": "#5C697C",
              "accent": "#265C9A",
              "accentContrast": "#FFFFFF",
              "border": "#CAD6E6",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEBFA",
              "statusSuccess": "#DCF2EC",
              "statusWarning": "#FFF2C2",
              "statusError": "#FCE2DF"
            },
            "responsive": {
              "breakpoint": 760,
              "maxContentWidth": 1180,
              "narrowPadding": 16,
              "widePadding": 32,
              "phoneColumns": 1,
              "desktopColumns": 12
            },
            "accessibility": {
              "focusOrder": "document",
              "minimumTargetSize": 44,
              "announces": [
                "loading",
                "saved",
                "error",
                "offline",
                "recovered"
              ],
              "chartSummaries": true,
              "reducedMotion": true
            }
          },
          "components": [
            {
              "id": "invoice-review-queue",
              "kind": "widget",
              "widget": "recordReviewCard",
              "title": "Invoice under review",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 20
              },
              "props": {
                "subtitle": "Line items waiting for approval or correction.",
                "badge": "Pre-send",
                "items": [
                  {
                    "id": "line",
                    "title": "Line item",
                    "detail": "Consulting services"
                  },
                  {
                    "id": "quantity",
                    "title": "Quantity x unit",
                    "detail": "2 x $150.00"
                  },
                  {
                    "id": "tax",
                    "title": "Tax rate",
                    "detail": "8.25%"
                  },
                  {
                    "id": "gross",
                    "title": "Gross total",
                    "detail": "$324.75"
                  }
                ],
                "actions": [
                  {
                    "id": "edit-line",
                    "title": "Edit line",
                    "route": "/capture"
                  },
                  {
                    "id": "open-totals",
                    "title": "Review totals",
                    "route": "/reports"
                  },
                  {
                    "id": "approve-draft",
                    "title": "Approve draft",
                    "route": "/history"
                  }
                ]
              }
            },
            {
              "id": "invoice-approve-action",
              "kind": "action",
              "title": "Approve reviewed total",
              "placement": "inline",
              "tone": "blue",
              "action": {
                "kind": "propose",
                "command": "invoice_review_approve_total",
                "payload": {
                  "query": "invoice_line-records"
                }
              }
            },
            {
              "id": "invoice-loading-state",
              "kind": "metric",
              "title": "Loading invoice lines",
              "dataState": "loading",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 1
              },
              "props": {
                "emptyText": "Reading local invoice lines."
              }
            },
            {
              "id": "invoice-empty-queue",
              "kind": "text",
              "title": "No invoice lines pending review",
              "subtitle": "Create the first line item to build a reviewable invoice.",
              "props": {
                "role": "status"
              }
            },
            {
              "id": "invoice-line-total-metric",
              "kind": "metric",
              "title": "Line extension total",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 100
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "valueField": "line_total"
              },
              "props": {
                "valueField": "line_total",
                "emptyText": "Line totals appear after quantity and price are saved."
              }
            },
            {
              "id": "invoice-tax-metric",
              "kind": "metric",
              "title": "Tax total",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 100
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "valueField": "tax_amount"
              },
              "props": {
                "valueField": "tax_amount",
                "emptyText": "Tax appears after a tax rate is saved."
              }
            },
            {
              "id": "invoice-gross-metric",
              "kind": "metric",
              "title": "Gross invoice total",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 100
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "valueField": "gross_total"
              },
              "props": {
                "valueField": "gross_total",
                "emptyText": "Gross total appears after invoice lines are saved."
              }
            }
          ]
        },
        "capture": {
          "title": "Line editor",
          "subtitle": "Edit invoice rows while totals stay visible and recoverable.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "appBarTitle": "Invoice Review",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "capture",
            "tabs": [
              {
                "id": "overview",
                "screen": "overview",
                "label": "Review"
              },
              {
                "id": "capture",
                "screen": "capture",
                "label": "Lines"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Totals"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Audit"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Rules"
              }
            ],
            "theme": {
              "canvas": "#F7F9FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E6EEF8",
              "ink": "#172033",
              "muted": "#5C697C",
              "accent": "#265C9A",
              "accentContrast": "#FFFFFF",
              "border": "#CAD6E6",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEBFA",
              "statusSuccess": "#DCF2EC",
              "statusWarning": "#FFF2C2",
              "statusError": "#FCE2DF"
            },
            "responsive": {
              "breakpoint": 760,
              "maxContentWidth": 1040,
              "narrowPadding": 16,
              "widePadding": 32,
              "phoneColumns": 1,
              "desktopColumns": 8
            },
            "accessibility": {
              "focusOrder": "document",
              "minimumTargetSize": 44,
              "announces": [
                "loading",
                "saved",
                "error",
                "offline",
                "recovered"
              ],
              "chartSummaries": true,
              "reducedMotion": true
            }
          },
          "components": [
            {
              "id": "invoice-line-editor",
              "kind": "widget",
              "widget": "structuredList",
              "title": "Invoice lines",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 100
              },
              "props": {
                "collection": "invoice_line",
                "placeholder": "Add item, quantity, price, tax",
                "emptyText": "Add a line item to start the invoice review.",
                "appearance": "ledger",
                "progressiveDisclosure": false,
                "metadataFields": [
                  {
                    "field": "title",
                    "label": "Line item",
                    "type": "text",
                    "sortable": true,
                    "filterable": true,
                    "required": true
                  },
                  {
                    "field": "invoice_id",
                    "label": "Invoice ID",
                    "type": "text",
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "quantity",
                    "label": "Quantity",
                    "type": "number",
                    "sortable": true,
                    "required": true
                  },
                  {
                    "field": "unit_price",
                    "label": "Unit price",
                    "type": "number",
                    "sortable": true,
                    "required": true
                  },
                  {
                    "field": "discount_rate",
                    "label": "Discount rate",
                    "type": "number",
                    "sortable": true
                  },
                  {
                    "field": "tax_rate",
                    "label": "Tax rate",
                    "type": "number",
                    "sortable": true,
                    "required": true
                  },
                  {
                    "field": "line_total",
                    "label": "Line total",
                    "type": "number",
                    "sortable": true
                  },
                  {
                    "field": "tax_amount",
                    "label": "Tax amount",
                    "type": "number",
                    "sortable": true
                  },
                  {
                    "field": "gross_total",
                    "label": "Gross total",
                    "type": "number",
                    "sortable": true
                  }
                ],
                "sorts": [
                  "manual",
                  {
                    "kind": "field",
                    "field": "invoice_id",
                    "label": "Invoice"
                  },
                  {
                    "kind": "field",
                    "field": "gross_total",
                    "label": "Gross total"
                  }
                ],
                "filterFields": [
                  "invoice_id",
                  "title",
                  "tax_rate"
                ],
                "commandPolicy": {
                  "autosave": "blur",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 10000
                  },
                  "offline": "queue",
                  "validation": {
                    "mode": "submit",
                    "requiredFields": [
                      "title",
                      "quantity",
                      "unit_price",
                      "tax_rate"
                    ]
                  },
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 604800000
                  },
                  "accessibleStatus": {
                    "enabled": true,
                    "labels": {
                      "pending": "Saving changes",
                      "saved": "Changes saved",
                      "error": "Fix highlighted fields",
                      "queued": "Saved offline",
                      "undone": "Change undone",
                      "cancelled": "Change cancelled"
                    }
                  }
                }
              }
            },
            {
              "id": "invoice-validation-error",
              "kind": "text",
              "title": "Invoice line is missing quantity, price, or tax rate",
              "subtitle": "Totals do not update until required numeric fields are valid.",
              "dataState": "error",
              "props": {
                "role": "alert",
                "liveRegion": "assertive"
              }
            },
            {
              "id": "invoice-detail-card",
              "kind": "widget",
              "widget": "recordContentCard",
              "title": "Line detail",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 1
              },
              "props": {
                "subtitle": "Review one invoice row and its totals.",
                "badge": "Editable line",
                "chips": [
                  {
                    "id": "invoice",
                    "label": "Invoice",
                    "value": "{invoice_id}"
                  },
                  {
                    "id": "lineTotal",
                    "label": "Line total",
                    "value": "{line_total}"
                  },
                  {
                    "id": "taxAmount",
                    "label": "Tax",
                    "value": "{tax_amount}"
                  },
                  {
                    "id": "grossTotal",
                    "label": "Gross",
                    "value": "{gross_total}"
                  }
                ],
                "actions": [
                  {
                    "id": "save-line",
                    "title": "Save line",
                    "route": "/overview"
                  },
                  {
                    "id": "inspect-history",
                    "title": "Inspect audit trail",
                    "route": "/history"
                  }
                ]
              }
            },
            {
              "id": "invoice-line-edit-history",
              "kind": "widget",
              "widget": "operationHistory",
              "title": "Line edit trail",
              "props": {
                "collection": "invoice_line",
                "limit": 50,
                "emptyText": "Line changes appear after the first edit.",
                "showUndoable": true,
                "showPersistedState": true
              }
            }
          ]
        },
        "reports": {
          "title": "Totals workspace",
          "subtitle": "Recalculate, compare, and export invoice totals before approval.",
          "shell": {
            "layoutMode": "dashboardWorkspace",
            "appBarTitle": "Invoice Review",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "reports",
            "tabs": [
