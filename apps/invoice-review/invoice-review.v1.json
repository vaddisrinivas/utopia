              "surfaceMuted": "#E6EEF8",
              "ink": "#172033",
              "muted": "#5C697C",
              "accent": "#265C9A",
              "accentContrast": "#FFFFFF",
              "border": "#CAD6E6",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEBFA",
              "statusSuccess": "#DCF2EC",
              "statusWarning": "#FFF2C2",
              "statusError": "#FCE2DF"
            },
            "responsive": {
              "breakpoint": 760,
              "maxContentWidth": 1240,
              "narrowPadding": 16,
              "widePadding": 32,
              "phoneColumns": 1,
              "desktopColumns": 12
            },
            "accessibility": {
              "focusOrder": "document",
              "minimumTargetSize": 44,
              "announces": [
                "loading",
                "saved",
                "error",
                "offline",
                "recovered"
              ],
              "chartSummaries": true,
              "reducedMotion": true
            }
          },
          "components": [
            {
              "id": "invoice-review-calculator",
              "kind": "widget",
              "widget": "scientificCalculator",
              "title": "Line math check",
              "props": {
                "initialExpression": "3*125+(3*125*0.10)",
                "angleMode": "deg",
                "emptyText": "Use the calculator to verify a disputed line."
              }
            },
            {
              "id": "invoice-total-chart",
              "kind": "widget",
              "widget": "chartBlock",
              "title": "Gross total by invoice",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 200
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "groupBy": "invoice_id",
                "valueField": "gross_total",
                "labelField": "invoice_id"
              },
              "props": {
                "chartType": "bar",
                "xField": "invoice_id",
                "yField": "gross_total",
                "emptyText": "Invoice totals appear after lines are saved.",
                "summary": "Gross total is line total plus tax amount."
              }
            },
            {
              "id": "invoice-total-table",
              "kind": "widget",
              "widget": "dataTable",
              "title": "Totals ledger",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 200
              },
              "props": {
                "columns": [
                  {
                    "key": "invoice_id",
                    "label": "Invoice"
                  },
                  {
                    "key": "title",
                    "label": "Line"
                  },
                  {
                    "key": "quantity",
                    "label": "Quantity"
                  },
                  {
                    "key": "unit_price",
                    "label": "Unit price"
                  },
                  {
                    "key": "line_total",
                    "label": "Line total"
                  },
                  {
                    "key": "tax_rate",
                    "label": "Tax rate"
                  },
                  {
                    "key": "tax_amount",
                    "label": "Tax amount"
                  },
                  {
                    "key": "gross_total",
                    "label": "Gross total"
                  }
                ],
                "emptyText": "No invoice lines to report.",
                "density": "compact",
                "stickyHeader": true,
                "keyboardNavigation": true,
                "dataBinding": {
                  "source": "query-records",
                  "resultFields": [
                    "invoice_id",
                    "title",
                    "quantity",
                    "unit_price",
                    "line_total",
                    "tax_rate",
                    "tax_amount",
                    "gross_total"
                  ]
                }
              }
            },
            {
              "id": "invoice-export-panel",
              "kind": "widget",
              "widget": "fileExport",
              "title": "PDF and CSV packet",
              "query": {
                "collections": [
                  "invoice_line"
                ],
                "limit": 200
              },
              "props": {
                "formats": [
                  "pdf-preview",
                  "csv"
                ],
                "filename": "invoice review export",
                "emptyText": "Export packet appears after an invoice has lines."
              }
            }
          ]
        },
        "history": {
          "title": "Review audit",
          "subtitle": "Trace approvals, corrections, exports, and recovered drafts.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "appBarTitle": "Invoice Review",
