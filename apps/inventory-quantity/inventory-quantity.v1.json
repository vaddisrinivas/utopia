                "collections": [
                  "inventory_item"
                ],
                "limit": 200
              },
              "props": {
                "collection": "inventory_item",
                "groupBy": "folder",
                "subtitleFields": [
                  "quantity",
                  "unit",
                  "location"
                ],
                "emptyText": "No foldered items yet."
              }
            },
            {
              "id": "inventory-table",
              "kind": "widget",
              "widget": "dataTable",
              "title": "Inventory table",
              "query": {
                "collections": [
                  "inventory_item"
