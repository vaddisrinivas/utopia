{
  "schemaVersion": "wonder.app-package.v2",
  "id": "inventory-quantity",
  "version": "2.0.0",
  "collections": {
    "inventory_item": {
      "id": "inventory_item",
      "fields": {
        "quantity": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "unit": {
          "type": "text"
        },
        "reorder_at": {
          "type": "number",
          "indexed": true
        },
        "location": {
          "type": "text",
          "indexed": true
        },
        "folder": {
          "type": "text",
          "indexed": true
        },
        "sku": {
          "type": "text",
          "indexed": true
        },
        "stock_status": {
          "type": "text",
          "indexed": true
        },
        "custom_fields": {
          "type": "json"
        },
        "last_counted_at": {
          "type": "timestamp",
          "indexed": true
        },
        "position": {
          "type": "number",
          "indexed": true
        }
      }
    },
    "stock_adjustment": {
      "id": "stock_adjustment",
      "fields": {
        "item_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "before_quantity": {
          "type": "number",
          "required": true
        },
        "delta": {
          "type": "number",
          "required": true
        },
        "after_quantity": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "reason": {
          "type": "text",
          "indexed": true
        },
        "review_status": {
          "type": "text",
          "indexed": true
        },
        "counted_at": {
          "type": "timestamp",
          "indexed": true
        }
      }
    },
    "inventory_folder": {
      "id": "inventory_folder",
      "fields": {
        "sort_order": {
          "type": "number",
          "indexed": true
        },
        "color": {
          "type": "text"
        },
        "item_count": {
          "type": "number"
        }
      }
    }
  },
  "queries": {
    "inventory-items": {
      "from": "inventory_item",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "low-stock-items": {
      "from": "inventory_item",
      "where": {
        "op": "eq",
        "field": "stock_status",
        "value": "low"
      },
      "orderBy": [
        {
          "field": "location",
          "direction": "asc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "stock-adjustments": {
      "from": "stock_adjustment",
      "orderBy": [
        {
          "field": "counted_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "inventory-folders": {
      "from": "inventory_folder",
      "orderBy": [
        {
          "field": "sort_order",
          "direction": "asc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "inventory-items": {
      "id": "inventory-items",
      "query": "inventory-items",
      "mode": "list",
      "fields": [
        "title",
        "quantity",
        "unit",
        "reorder_at",
        "stock_status",
        "folder",
        "location",
        "sku"
      ]
    },
    "low-stock-items": {
      "id": "low-stock-items",
      "query": "low-stock-items",
      "mode": "list",
      "fields": [
        "title",
        "quantity",
        "reorder_at",
        "location",
        "folder"
      ]
    },
    "stock-adjustments": {
      "id": "stock-adjustments",
      "query": "stock-adjustments",
      "mode": "timeline",
      "fields": [
        "title",
        "before_quantity",
        "delta",
        "after_quantity",
        "reason",
        "review_status",
        "counted_at"
      ]
    },
    "inventory-folders": {
      "id": "inventory-folders",
      "query": "inventory-folders",
      "mode": "list",
      "fields": [
        "title",
        "item_count",
        "color",
        "sort_order"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "track-item-quantities",
    "review-low-stock",
    "mobile-stock-counts",
    "review-stock-count-changes",
    "inventory-search",
    "inventory-folders",
    "inventory-custom-fields",
    "quantity-alerts",
    "stock-adjustments"
  ],
  "presentation": {
    "label": "Inventory Quantity",
    "homeSurface": "count",
    "surfaces": [
      {
        "id": "count",
        "label": "Count",
        "icon": "table",
        "collections": [
          "inventory_item",
          "stock_adjustment"
        ],
        "views": [
          "inventory-items",
          "stock-adjustments"
        ]
      },
      {
        "id": "stockroom",
        "label": "Stockroom",
        "icon": "briefcase",
        "collections": [
          "inventory_item",
          "inventory_folder"
        ],
        "views": [
          "inventory-items",
          "inventory-folders"
        ]
      },
      {
        "id": "low-stock",
        "label": "Low stock",
        "icon": "shield-check",
        "collections": [
          "inventory_item"
        ],
        "views": [
          "low-stock-items"
        ]
      },
      {
        "id": "adjustments",
        "label": "Adjustments",
        "icon": "rotate-ccw",
        "collections": [
          "stock_adjustment"
        ],
        "views": [
          "stock-adjustments"
        ]
      },
      {
        "id": "settings",
        "label": "Settings",
        "icon": "settings",
        "collections": [
          "inventory_item",
          "inventory_folder"
        ],
        "views": [
          "inventory-items",
          "inventory-folders"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "table",
      "tone": "moss",
      "accent": "#2D6A4F",
      "canvas": "#F3F6F1"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "count",
      "navigation": {
        "items": [
          {
            "screen": "count",
            "label": "Count",
            "icon": "table"
          },
          {
            "screen": "stockroom",
            "label": "Stockroom",
            "icon": "briefcase"
          },
          {
            "screen": "low-stock",
            "label": "Low stock",
            "icon": "shield-check"
          },
          {
            "screen": "adjustments",
            "label": "Adjustments",
            "icon": "rotate-ccw"
          },
          {
            "screen": "settings",
            "label": "Settings",
            "icon": "settings"
          }
        ]
