      "screens": {
        "count": {
          "title": "Count stock",
          "subtitle": "Search an item, adjust quantity, review the delta, and keep working offline.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "scrollable": true,
            "density": "comfortable",
            "theme": {
              "canvas": "#F3F6F1",
              "surface": "#FFFFFF",
              "surfaceMuted": "#DCE8DC",
              "ink": "#15201A",
              "muted": "#5B6C61",
              "accent": "#2D6A4F",
              "accentContrast": "#FFFFFF",
              "border": "#BDD0C2",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEAF7",
              "statusSuccess": "#DDEFE3",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE0DD"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1120,
              "narrowPadding": 14,
              "widePadding": 28
            }
          },
          "components": [
            {
              "id": "inventory-active-item",
              "kind": "widget",
              "widget": "recordHeroSummary",
              "title": "Active item",
              "query": {
                "collections": [
                  "inventory_item"
                ],
                "limit": 1
              },
              "props": {
                "title": "Active item",
                "subtitle": "Quantity, minimum, folder, and bin stay visible while counting.",
                "body": "The primary count surface mirrors Sortly-style mobile stock counts: current quantity first, low-stock boundary second, review before applying.",
                "badge": "counting",
                "emoji": "PKG",
                "chips": [
                  {
                    "label": "Qty",
                    "value": "quantity"
                  },
                  {
                    "label": "Min",
                    "value": "reorder_at"
                  },
                  {
                    "label": "Bin",
                    "value": "location"
                  }
                ],
                "actions": []
              }
            },
            {
              "id": "inventory-quantity-control",
              "kind": "widget",
              "widget": "valueControl",
              "title": "Quantity stepper",
              "query": {
                "collections": [
                  "inventory_item"
                ],
                "limit": 1
              },
              "props": {
                "collection": "inventory_item",
                "valueField": "quantity",
                "step": 0.5,
                "min": 0,
                "resetValue": 0,
                "precision": 1,
                "unit": "units"
              }
            },
            {
              "id": "inventory-review-delta",
              "kind": "widget",
              "widget": "recordReviewCard",
              "title": "Review count change",
              "query": {
                "collections": [
                  "stock_adjustment"
                ],
                "limit": 3
              },
              "props": {
                "title": "Review count change",
                "subtitle": "Every stock count has before, delta, after, and reason before it becomes history.",
                "badge": "review",
                "emoji": "OK",
                "items": [
                  {
                    "title": "Before",
                    "detail": "Existing count stays visible",
                    "status": "locked"
                  },
                  {
                    "title": "Delta",
                    "detail": "Positive or negative adjustment",
                    "status": "pending"
                  },
                  {
                    "title": "After",
                    "detail": "Saved count writes locally",
                    "status": "ready"
                  }
                ],
                "actions": []
              }
            },
            {
              "id": "inventory-count-list",
              "kind": "widget",
              "widget": "structuredList",
              "title": "Count queue",
              "query": {
                "collections": [
                  "inventory_item"
                ],
                "limit": 200
              },
              "props": {
                "collection": "inventory_item",
                "placeholder": "Search or add an item",
                "emptyText": "Add the first item with a quantity.",
                "appearance": "plain",
                "progressiveDisclosure": true,
                "editable": true,
                "deletable": true,
                "autoSaveEdits": true,
                "positionField": "position",
                "metadataFields": [
                  {
                    "field": "quantity",
                    "label": "Qty",
                    "type": "number",
                    "options": [],
                    "required": true,
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "unit",
                    "label": "Unit",
                    "type": "select",
                    "options": [
                      "each",
                      "box",
                      "case",
                      "lb",
                      "oz"
                    ],
                    "required": false,
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "reorder_at",
                    "label": "Reorder at",
                    "type": "number",
                    "options": [],
                    "required": false,
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "stock_status",
                    "label": "Status",
                    "type": "select",
                    "options": [
                      "ok",
                      "low",
                      "out"
                    ],
                    "required": false,
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "location",
                    "label": "Location",
                    "type": "text",
                    "options": [],
                    "required": false,
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "folder",
                    "label": "Folder",
                    "type": "text",
                    "options": [],
                    "required": false,
                    "sortable": true,
                    "filterable": true
                  }
                ],
                "suggestions": [
                  {
                    "title": "Nitrile gloves",
                    "values": {
                      "quantity": 4,
                      "unit": "box",
                      "reorder_at": 2,
                      "stock_status": "ok",
                      "location": "Garage shelf A",
                      "folder": "Supplies"
                    }
                  },
                  {
                    "title": "AA batteries",
                    "values": {
                      "quantity": 1,
                      "unit": "case",
                      "reorder_at": 2,
                      "stock_status": "low",
                      "location": "Utility drawer",
                      "folder": "Electronics"
                    }
                  }
                ],
                "sorts": [
                  "manual",
                  "alphabetic"
                ],
                "filterFields": [
                  "quantity",
                  "unit",
                  "reorder_at",
                  "stock_status",
                  "location",
                  "folder"
                ],
                "commandPolicy": {
                  "autosave": "change",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 10000
                  },
                  "offline": "local",
                  "validation": {
                    "mode": "change",
                    "requiredFields": [
                      "quantity"
                    ]
                  },
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 86400000
                  },
                  "accessibleStatus": {
                    "enabled": true
                  }
                }
              }
            }
          ]
        },
        "stockroom": {
          "title": "Stockroom",
          "subtitle": "Browse folders, custom fields, bins, and every item without leaving the inventory context.",
