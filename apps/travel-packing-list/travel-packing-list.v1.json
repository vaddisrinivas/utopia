              }
            },
            {
              "id": "packing-event-timeline",
              "kind": "widget",
              "widget": "recordTimeline",
              "title": "Packing activity",
              "query": {
                "collections": [
                  "packing_event"
                ],
                "limit": 100
              },
              "props": {
                "collection": "packing_event",
                "timeField": "happened_at",
                "subtitleFields": [
                  "event_type",
                  "trip_id"
                ],
                "emptyText": "No packing activity yet."
              }
            }
          ]
        },
        "settings": {
          "title": "Settings",
          "subtitle": "Control generation assumptions, offline behavior, and what regeneration may change.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "scrollable": true,
            "density": "comfortable",
            "theme": {
              "canvas": "#F2F7FA",
              "surface": "#FFFFFF",
              "surfaceMuted": "#DDEBF1",
              "ink": "#132431",
              "muted": "#5F6F7A",
              "accent": "#256D85",
              "accentContrast": "#FFFFFF",
              "border": "#BDD4DE",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEAF7",
              "statusSuccess": "#DDEFE3",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE0DD"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1120,
              "narrowPadding": 14,
              "widePadding": 28
            }
          },
          "components": [
            {
              "id": "packing-policy-card",
              "kind": "widget",
              "widget": "recordContentCard",
              "title": "Packing policy",
              "props": {
                "title": "Packing policy",
                "subtitle": "Editable generation, no silent overwrite",
                "body": "Generated items are normal records after creation. Removing one keeps it removed until an explicit regenerate action.",
                "badge": "safe",
                "emoji": "SET",
                "chips": [
                  {
                    "label": "Live weather",
                    "value": "manual context only"
                  },
                  {
                    "label": "Offline",
                    "value": "local edits"
                  },
                  {
                    "label": "Recovery",
                    "value": "trip + item state"
                  }
                ],
                "actions": []
              }
            },
            {
              "id": "trip-settings-list",
              "kind": "widget",
              "widget": "structuredList",
              "title": "Trip defaults",
              "query": {
                "collections": [
                  "trip"
                ],
                "limit": 50
              },
              "props": {
                "collection": "trip",
                "placeholder": "Add trip profile",
                "emptyText": "No trip defaults yet.",
                "appearance": "plain",
                "progressiveDisclosure": true,
                "editable": true,
                "deletable": true,
                "autoSaveEdits": true,
                "positionField": "position",
                "metadataFields": [
                  {
                    "field": "destination",
                    "label": "Destination",
                    "type": "text",
                    "options": [],
                    "required": false,
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "trip_type",
                    "label": "Type",
                    "type": "select",
                    "options": [
                      "business",
                      "leisure",
                      "camping",
