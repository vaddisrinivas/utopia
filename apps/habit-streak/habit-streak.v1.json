{
  "schemaVersion": "wonder.app-package.v2",
  "id": "habit-streak",
  "version": "1.0.0",
  "collections": {
    "primary": {
      "id": "primary",
      "fields": {
        "habit": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "date": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "completed": {
          "type": "number",
          "required": false,
          "indexed": true
        },
        "target": {
          "type": "number",
          "required": false,
          "indexed": false
        }
      }
    }
  },
  "queries": {
    "habit_day-records": {
      "from": "primary",
      "orderBy": [
        {
          "field": "habit",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "overview": {
      "id": "overview",
      "query": "habit_day-records",
      "mode": "list",
      "fields": [
        "habit",
        "date",
        "completed",
        "target",
        "streak_value"
      ]
    }
  },
  "computedFields": [
    {
      "id": "streak_value",
      "collection": "primary",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            ">": [
              {
                "var": "record.target"
              },
              0
            ]
          },
          {
            "/": [
              {
                "var": "record.completed"
              },
              {
                "var": "record.target"
              }
            ]
          },
          0
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "habit-streak-schema-validates",
    "habit-streak-defining-task",
    "habit-streak-computed-fields-deterministic",
    "habit-streak-generic-ui-only"
  ],
  "presentation": {
    "label": "Habit Streak",
    "homeSurface": "overview",
    "surfaces": [
      {
        "id": "overview",
        "label": "Today",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "capture",
        "label": "Log",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "detail",
        "label": "Habit",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "history",
        "label": "Calendar",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "settings",
        "label": "Settings",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "flame",
      "tone": "evergreen",
      "accent": "#23715B",
      "canvas": "#F4FBF7",
      "identity": "A daily practice cockpit where the current habit, streak ratio, and backdate path are visible before anything else.",
      "rationale": "Habit Streak uses a calm green practice identity, a first-viewport check-in, and calendar/history surfaces instead of the rejected generic card stack."
    },
    "render": {
      "responsiveTargets": [
        "phone",
        "desktop"
      ],
      "stateTargets": [
        "empty",
        "loading",
        "populated",
        "editing",
        "error",
        "offline",
        "recovery"
      ],
      "firstViewport": "Check off today, see streak progress, and recover missed days in one place."
