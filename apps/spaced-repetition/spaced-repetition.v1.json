{
  "schemaVersion": "wonder.app-package.v2",
  "id": "spaced-repetition",
  "version": "2.0.0",
  "collections": {
    "card": {
      "id": "card",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "topic": {
          "type": "text",
          "indexed": true
        },
        "deck_id": {
          "type": "text",
          "indexed": true
        },
        "front": {
          "type": "text"
        },
        "back": {
          "type": "text"
        },
        "as_of": {
          "type": "timestamp",
          "indexed": true
        },
        "schedule": {
          "type": "json",
          "required": true
        },
        "ease_factor": {
          "type": "number",
          "indexed": true
        },
        "interval_days": {
          "type": "number"
        },
        "repetitions": {
          "type": "number"
        },
        "lapse_count": {
          "type": "number"
        },
        "last_grade": {
          "type": "number"
        },
        "media_status": {
          "type": "text"
        },
        "sync_status": {
          "type": "text"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "review_log": {
      "id": "review_log",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "card_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "graded_at": {
          "type": "timestamp",
          "indexed": true
        },
        "grade": {
          "type": "number",
          "required": true
        },
        "previous_interval_days": {
          "type": "number"
        },
        "scheduled_interval_days": {
          "type": "number"
        },
        "ease_factor": {
          "type": "number"
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "study_profile": {
      "id": "study_profile",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "daily_new_limit": {
          "type": "number"
        },
        "daily_review_limit": {
          "type": "number"
        },
        "timezone": {
          "type": "text"
        },
        "answer_mode": {
          "type": "text"
        },
        "sync_status": {
          "type": "text"
        },
        "backup_status": {
          "type": "text"
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "cards": {
      "from": "card",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 50
    },
    "due-cards": {
      "from": "card",
      "where": {
        "op": "eq",
        "field": "status",
        "value": "due"
      },
      "orderBy": [
        {
          "field": "as_of",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "review-history": {
      "from": "review_log",
      "orderBy": [
        {
          "field": "graded_at",
          "direction": "desc"
        }
      ],
      "limit": 200
    },
    "study-profiles": {
      "from": "study_profile",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 10
    }
  },
  "views": {
    "cards": {
      "id": "cards",
      "query": "cards",
      "mode": "list",
      "fields": [
        "title",
        "topic",
        "status",
        "ease_factor",
        "interval_days",
        "next_review"
      ]
    },
    "due": {
      "id": "due",
      "query": "due-cards",
      "mode": "list",
      "fields": [
        "title",
        "front",
        "status",
        "next_review"
      ]
    },
    "history": {
      "id": "history",
      "query": "review-history",
      "mode": "timeline",
      "fields": [
        "title",
        "card_id",
        "grade",
        "scheduled_interval_days",
        "ease_factor"
      ]
    },
    "settings": {
      "id": "settings",
      "query": "study-profiles",
      "mode": "table",
      "fields": [
        "title",
        "daily_new_limit",
        "daily_review_limit",
        "timezone",
        "sync_status"
      ]
    }
  },
  "computedFields": [
    {
      "id": "next_review",
      "collection": "card",
      "dependsOn": [],
      "expression": {
        "recurrence_next": {
          "schedule": {
            "var": "record.schedule"
          },
          "after": {
            "var": "record.as_of"
          },
          "budget": {
            "maxOccurrences": 5,
            "maxIterations": 32,
            "maxRuleEvaluations": 64,
            "maxLookaheadDays": 1200,
            "maxExclusions": 16,
            "maxOverrides": 16
          }
        }
      }
    },
    {
      "id": "review_window",
      "collection": "card",
      "dependsOn": [
        "next_review"
      ],
      "expression": {
        "recurrence_expand": {
          "schedule": {
            "var": "record.schedule"
          },
          "after": {
            "var": "record.as_of"
          },
          "limit": 5,
          "budget": {
            "maxOccurrences": 5,
            "maxIterations": 32,
            "maxRuleEvaluations": 64,
            "maxLookaheadDays": 1200,
            "maxExclusions": 16,
            "maxOverrides": 16
          }
        }
      }
    },
    {
      "id": "projected_interval_days",
      "collection": "card",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "var": [
              "record.interval_days",
              1
            ]
          },
          {
            "var": [
              "record.ease_factor",
              2.5
            ]
          }
        ]
      }
    }
  ],
  "rules": [
    {
      "id": "study-grade-proposal",
      "trigger": {
        "kind": "operation"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "grade_spaced_repetition_card"
        }
      },
      "mode": "suggest",
      "maxRunsPerEvent": 1
    },
    {
      "id": "study-backup-proposal",
      "trigger": {
        "kind": "operation"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "export_study_backup"
        }
      },
      "mode": "suggest",
      "maxRunsPerEvent": 1
    }
  ],
  "capabilities": [
    "records.read",
    "records.write",
    "notifications.schedule",
    "file.read",
    "file.export",
    "offline.local"
  ],
  "acceptanceTests": [
    "recurrence-engine-weekday-reviews",
    "recurrence-engine-monthday-reviews",
    "package-only-recurrence-proof",
    "gold-wave2e-review-grade",
    "gold-wave2e-history-settings"
  ],
