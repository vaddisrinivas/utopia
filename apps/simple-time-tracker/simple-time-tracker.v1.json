{
  "schemaVersion": "wonder.app-package.v2",
  "id": "simple-time-tracker",
  "version": "2.0.0",
  "collections": {
    "time_entry": {
      "id": "time_entry",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "project": {
          "type": "text",
          "indexed": true
        },
        "category": {
          "type": "text",
          "indexed": true
        },
        "started_at": {
          "type": "timestamp",
          "indexed": true
        },
        "ended_at": {
          "type": "timestamp",
          "indexed": true
        },
        "duration_minutes": {
          "type": "number"
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "recent-entries": {
      "from": "time_entry",
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "running-entries": {
      "from": "time_entry",
      "where": {
        "field": "status",
        "op": "eq",
        "value": "running"
      },
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 10
    },
    "completed-entries": {
      "from": "time_entry",
      "where": {
        "field": "status",
        "op": "eq",
        "value": "completed"
      },
      "orderBy": [
        {
          "field": "ended_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "recent": {
      "id": "recent",
      "query": "recent-entries",
      "mode": "table",
      "fields": [
        "title",
        "project",
        "category",
        "started_at",
        "ended_at",
        "duration_minutes",
        "status"
      ]
    },
    "running": {
      "id": "running",
      "query": "running-entries",
      "mode": "list",
      "fields": [
        "title",
        "project",
        "started_at",
        "status"
      ]
    },
    "completed": {
      "id": "completed",
      "query": "completed-entries",
      "mode": "table",
      "fields": [
        "title",
        "project",
        "duration_minutes",
        "ended_at"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "persisted-duration-timer",
    "background-foreground-observe",
    "restart-recovery-confirmed-elapsed",
    "completed-session-record",
    "activity-record-history"
  ],
  "presentation": {
    "label": "Simple Time Tracker",
    "homeSurface": "timer",
    "surfaces": [
      {
        "id": "timer",
        "label": "Now",
        "collections": [
          "time_entry"
        ],
        "views": [
          "running"
        ]
      },
      {
        "id": "history",
        "label": "Journal",
        "collections": [
          "time_entry"
        ],
        "views": [
          "recent"
        ]
      },
      {
        "id": "insights",
        "label": "Patterns",
        "collections": [
          "time_entry"
        ],
        "views": [
          "completed"
        ]
      },
      {
        "id": "activities",
        "label": "Activities",
        "collections": [
          "time_entry"
        ],
        "views": [
          "recent"
        ]
      },
      {
        "id": "settings",
        "label": "Setup",
        "collections": [
          "time_entry"
        ],
        "views": [
          "recent"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "timer",
      "tone": "plum",
      "accent": "#7B3F91",
      "canvas": "#FCF8FE",
      "identity": "quiet time journal with one active clock and a reflective work log"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "timer",
      "screens": {
        "timer": {
          "title": "Now",
          "subtitle": "Start one focused session",
          "shell": {
            "layoutMode": "focusedTool",
            "appBarTitle": "Time",
            "scrollable": true,
            "density": "spacious",
            "activeTab": "timer",
            "tabs": [
              {
                "id": "timer",
                "screen": "timer",
                "label": "Now"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Journal"
              },
              {
                "id": "insights",
                "screen": "insights",
                "label": "Patterns"
              },
              {
                "id": "activities",
                "screen": "activities",
                "label": "Activities"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Setup"
              }
            ],
            "theme": {
              "canvas": "#FCF8FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#F0E7F5",
              "ink": "#3B1D4B",
              "muted": "#775D83",
              "accent": "#7B3F91",
              "accentContrast": "#FFFFFF",
              "border": "#E4D5EA",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 720,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "work-session-timer",
              "kind": "widget",
              "widget": "durationTimer",
              "title": "Focus clock",
              "props": {
                "runId": "current-timer",
                "label": "Focus clock",
                "durationSeconds": 3600,
                "completionRecord": {
                  "collection": "time_entry",
                  "title": "Focus session",
                  "properties": {
                    "project": "Unassigned",
                    "category": "Focused work"
                  }
                }
              }
            },
            {
              "id": "running-entry-list",
              "kind": "recordList",
              "title": "In progress",
              "query": {
                "collections": [
                  "time_entry"
                ],
                "match": "running",
                "limit": 10
              },
              "props": {
                "emptyText": "No session is running.",
                "subtitleFields": [
                  "project",
                  "started_at",
                  "status"
                ]
              }
            }
          ]
        },
        "history": {
          "title": "Journal",
          "subtitle": "Completed time",
          "shell": {
            "layoutMode": "detailWorkspace",
            "appBarTitle": "Time",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "history",
            "tabs": [
              {
                "id": "timer",
                "screen": "timer",
                "label": "Now"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Journal"
              },
              {
                "id": "insights",
                "screen": "insights",
                "label": "Patterns"
              },
              {
                "id": "activities",
                "screen": "activities",
                "label": "Activities"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Setup"
              }
            ],
            "theme": {
              "canvas": "#FCF8FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#F0E7F5",
              "ink": "#3B1D4B",
              "muted": "#775D83",
              "accent": "#7B3F91",
              "accentContrast": "#FFFFFF",
              "border": "#E4D5EA",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1080,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "time-entry-table",
              "kind": "widget",
              "widget": "dataTable",
              "title": "Sessions",
              "query": {
                "collections": [
                  "time_entry"
                ],
                "limit": 100
              },
              "props": {
                "columns": [
                  {
                    "key": "title",
                    "label": "Activity"
                  },
                  {
                    "key": "project",
                    "label": "Project"
                  },
                  {
                    "key": "category",
                    "label": "Category"
                  },
                  {
                    "key": "duration_minutes",
                    "label": "Minutes"
                  },
                  {
                    "key": "status",
                    "label": "Status"
                  }
                ],
                "emptyText": "Completed sessions appear here."
              }
            },
            {
              "id": "time-operation-history",
              "kind": "widget",
              "widget": "operationHistory",
              "title": "Changes",
              "props": {
                "collection": "time_entry",
                "limit": 50,
                "emptyText": "No changes yet."
              }
            }
          ]
        },
        "insights": {
          "title": "Patterns",
          "subtitle": "Where time goes",
          "shell": {
            "layoutMode": "dashboardWorkspace",
            "appBarTitle": "Time",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "insights",
            "tabs": [
              {
                "id": "timer",
                "screen": "timer",
                "label": "Now"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Journal"
              },
              {
                "id": "insights",
                "screen": "insights",
                "label": "Patterns"
              },
              {
                "id": "activities",
                "screen": "activities",
                "label": "Activities"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Setup"
              }
            ],
            "theme": {
              "canvas": "#FCF8FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#F0E7F5",
              "ink": "#3B1D4B",
              "muted": "#775D83",
              "accent": "#7B3F91",
              "accentContrast": "#FFFFFF",
              "border": "#E4D5EA",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1080,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "completed-entry-count",
              "kind": "metric",
              "title": "Completed sessions",
              "query": {
                "collections": [
                  "time_entry"
                ],
                "limit": 100
              },
              "props": {
                "emptyText": "Complete a session to see a count."
              }
            },
            {
              "id": "duration-by-project",
              "kind": "widget",
              "widget": "chartBlock",
              "title": "Time by project",
              "query": {
                "collections": [
                  "time_entry"
                ],
                "limit": 100
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "groupBy": "project",
                "valueField": "duration_minutes",
                "labelField": "project"
              },
              "props": {
                "chartType": "bar",
                "xField": "project",
                "yField": "duration_minutes",
                "emptyText": "No completed time to chart."
              }
            }
          ]
        },
        "activities": {
          "title": "Activities",
          "subtitle": "Recorded work",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "appBarTitle": "Time",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "activities",
            "tabs": [
              {
                "id": "timer",
                "screen": "timer",
                "label": "Now"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Journal"
              },
              {
                "id": "insights",
                "screen": "insights",
                "label": "Patterns"
              },
              {
                "id": "activities",
                "screen": "activities",
                "label": "Activities"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Setup"
              }
            ],
            "theme": {
              "canvas": "#FCF8FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#F0E7F5",
              "ink": "#3B1D4B",
              "muted": "#775D83",
              "accent": "#7B3F91",
              "accentContrast": "#FFFFFF",
              "border": "#E4D5EA",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 900,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "activities-list",
              "kind": "recordList",
              "title": "Activity records",
              "query": {
                "collections": [
                  "time_entry"
                ],
                "limit": 100
              },
              "props": {
                "emptyText": "Activities appear from completed sessions.",
                "subtitleFields": [
                  "project",
                  "category",
                  "duration_minutes"
                ]
              }
            }
          ]
        },
        "settings": {
          "title": "Setup",
          "subtitle": "Timer defaults",
          "shell": {
            "layoutMode": "settingsWorkspace",
            "appBarTitle": "Time",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "settings",
            "tabs": [
              {
                "id": "timer",
                "screen": "timer",
                "label": "Now"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "Journal"
              },
              {
                "id": "insights",
                "screen": "insights",
                "label": "Patterns"
              },
              {
                "id": "activities",
                "screen": "activities",
                "label": "Activities"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Setup"
              }
            ],
            "theme": {
              "canvas": "#FCF8FE",
              "surface": "#FFFFFF",
              "surfaceMuted": "#F0E7F5",
              "ink": "#3B1D4B",
              "muted": "#775D83",
              "accent": "#7B3F91",
              "accentContrast": "#FFFFFF",
              "border": "#E4D5EA",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 680,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "time-settings-form",
              "kind": "widget",
              "widget": "formCard",
              "title": "Preferences",
              "props": {
                "fields": [
                  {
                    "id": "display",
                    "label": "Display format",
                    "type": "text"
                  },
                  {
                    "id": "default_project",
                    "label": "Default project",
                    "type": "text"
                  },
                  {
                    "id": "notifications",
                    "label": "Notifications",
                    "type": "text"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
