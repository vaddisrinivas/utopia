{
  "schemaVersion": "wonder.app-package.v2",
  "id": "interval-timer",
  "version": "2.0.0",
  "collections": {
    "interval_preset": {
      "id": "interval_preset",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "total_seconds": {
          "type": "number",
          "required": true
        },
        "rounds": {
          "type": "number",
          "required": true
        },
        "alarm_profile": {
          "type": "text",
          "indexed": true
        },
        "speech_enabled": {
          "type": "boolean"
        },
        "vibration_enabled": {
          "type": "boolean"
        },
        "theme": {
          "type": "text"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "interval_phase": {
      "id": "interval_phase",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "preset_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "phase_order": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "phase_type": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "duration_seconds": {
          "type": "number",
          "required": true
        },
        "alarm_mode": {
          "type": "text"
        },
        "speech_cue": {
          "type": "text"
        },
        "color": {
          "type": "text"
        }
      }
    },
    "interval_session": {
      "id": "interval_session",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "preset_id": {
          "type": "text",
          "indexed": true
        },
        "current_step": {
          "type": "text",
          "indexed": true
        },
        "started_at": {
          "type": "timestamp",
          "indexed": true
        },
        "finished_at": {
          "type": "timestamp",
          "indexed": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "rounds_completed": {
          "type": "number"
        },
        "recovery_confidence": {
          "type": "text"
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "active-presets": {
      "from": "interval_preset",
      "where": {
        "op": "eq",
        "field": "status",
        "value": "active"
      },
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 50
    },
    "ordered-phases": {
      "from": "interval_phase",
      "orderBy": [
        {
          "field": "phase_order",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "sessions": {
      "from": "interval_session",
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 50
    },
    "completed-sessions": {
      "from": "interval_session",
      "where": {
        "op": "eq",
        "field": "status",
        "value": "completed"
      },
      "orderBy": [
        {
          "field": "finished_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "presets": {
      "id": "presets",
      "query": "active-presets",
      "mode": "list",
      "fields": [
        "title",
        "total_seconds",
        "rounds",
        "alarm_profile",
        "theme"
      ]
    },
    "phases": {
      "id": "phases",
      "query": "ordered-phases",
      "mode": "table",
      "fields": [
        "title",
        "phase_type",
        "duration_seconds",
        "phase_order",
        "alarm_mode",
        "speech_cue"
      ]
    },
    "sessions": {
      "id": "sessions",
      "query": "sessions",
      "mode": "timeline",
      "fields": [
        "title",
        "status",
        "started_at",
        "finished_at",
        "current_step",
        "elapsed_seconds"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "create-interval-preset",
    "edit-interval-phases",
    "repeat-interval-loops",
    "reorder-intervals",
    "duplicate-interval-preset",
    "configure-phase-duration",
    "view-timer-history",
    "interval-session-oracle",
    "restart-recovery-confirmed-elapsed",
    "uncertain-elapsed-review-required",
    "gold-from-scratch-presentation",
    "generic-widget-only"
  ],
