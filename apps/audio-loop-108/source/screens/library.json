{
  "label": "Library",
  "subtitle": "Saved audio",
  "collections": [
    "session"
  ],
  "query": "recent-sessions",
  "mode": "list",
  "fields": [
    "title",
    "file_name",
    "updated_at"
  ],
  "shell": {
    "layoutMode": "collectionWorkspace",
    "appBarTitle": "Audio Loop",
    "scrollable": true,
    "density": "spacious",
    "activeTab": "library",
    "tabs": [
      {
        "id": "home",
        "screen": "home",
        "label": "Play"
      },
      {
        "id": "library",
        "screen": "library",
        "label": "Library"
      },
      {
        "id": "playlist",
        "screen": "playlist",
        "label": "Queue"
      },
      {
        "id": "history",
        "screen": "history",
        "label": "Sessions"
      },
      {
        "id": "record",
        "screen": "record",
        "label": "Capture"
      }
    ],
    "theme": {
      "canvas": "#FBF7FD",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F1E5F5",
      "ink": "#321640",
      "muted": "#735C7D",
      "accent": "#6C3B83",
      "accentContrast": "#FFFFFF",
      "border": "#E3D3EA",
      "danger": "#B42318",
      "dangerContrast": "#FFFFFF",
      "statusInfo": "#E7EFFA",
      "statusSuccess": "#E1F3E7",
      "statusWarning": "#FFF0C7",
      "statusError": "#FCE1DF"
    },
    "responsive": {
      "breakpoint": 720,
      "maxContentWidth": 980,
      "narrowPadding": 16,
      "widePadding": 32
    }
  },
  "components": [
    {
      "id": "library-player",
      "kind": "widget",
      "widget": "audioLoopPlayer",
      "title": "Audio library",
      "subtitle": "Choose a saved file.",
      "tone": "plum",
      "props": {
        "defaultPlays": 1,
        "defaultDelaySeconds": 0,
        "defaultStartDelaySeconds": 0,
        "delayOptions": [
          0,
          5,
          15,
          30,
          60,
          108,
          300
        ],
        "startDelayOptions": [
          0,
          10,
          30,
          60,
          108
        ],
        "countSkippedAsCompleted": true,
        "presets": [
          {
            "label": "Long practice (108)",
            "plays": 108,
            "delaySeconds": 0,
            "startDelaySeconds": 0
          }
        ],
        "nativeUnavailableCopy": "Audio playback needs the installed platform audio bridge."
      }
    },
    {
      "id": "library-sessions",
      "kind": "recordList",
      "title": "Recent files",
      "query": {
        "collections": [
          "session"
        ],
        "limit": 50
      },
      "props": {
        "emptyText": "Imported and recorded files appear here.",
        "subtitleFields": [
          "file_name",
          "updated_at"
        ]
      }
    }
  ]
}
