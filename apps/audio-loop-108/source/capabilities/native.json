{
  "schemaVersion": "wonder.app-package-native-capabilities.v1",
  "platform": "android",
  "packages": [
    "expo-audio",
    "expo-document-picker"
  ],
  "permissions": [
    {
      "id": "audio-loop-playback",
      "platform": "expo",
      "permission": "expo-audio",
      "reason": "Load, queue, and loop selected audio tracks from local files.",
      "required": true
    },
    {
      "id": "audio-loop-file-picker",
      "platform": "expo",
      "permission": "expo-document-picker",
      "reason": "Pick local audio files to play as loop assets.",
      "required": true
    }
  ],
  "intents": [
    {
      "id": "open-audio-loop",
      "platform": "android",
      "kind": "deep_link",
      "reason": "Open the Audio Loop app from App Action/deep-link entry points.",
      "required": true
    },
    {
      "id": "start-audio-loop-voice",
      "platform": "android",
      "kind": "voice",
      "reason": "Allow voice entry attempts to request opening Audio Loop, with explicit playback confirmation.",
      "required": false
    }
  ]
}
