        "updated_at": {
          "indexed": true,
          "required": true,
          "type": "timestamp"
        }
      }
    }
  },
  "queries": {
    "recent-sessions": {
      "from": "records",
      "where": {
        "field": "collection",
        "op": "eq",
        "value": "session"
      },
      "orderBy": [
        {
          "direction": "desc",
          "field": "updated_at"
        }
      ],
      "limit": 50
    }
  },
  "views": {
    "history": {
      "id": "history",
      "query": "recent-sessions",
      "mode": "table",
      "fields": [
        "title",
        "file_name",
        "target_plays",
        "completed_plays",
        "delay_seconds",
        "status",
        "started_at",
        "finished_at"
      ]
    },
    "home": {
      "id": "home",
      "query": "recent-sessions",
      "mode": "list",
      "fields": [
        "title",
        "file_name",
        "completed_plays",
        "target_plays",
        "status",
        "updated_at"
      ]
    },
    "library": {
