                  10,
                  30,
                  60,
                  108
                ]
              },
              "subtitle": "Choose, start, pause, resume, or stop loop playback with count or infinite mode.",
              "title": "Audio Loop",
              "tone": "moss",
              "widget": "audioLoopPlayer"
            },
            {
              "kind": "widget",
              "props": {
                "columns": [
                  {
                    "key": "control",
                    "label": "Control"
                  },
                  {
                    "key": "behavior",
                    "label": "Behavior"
                  }
                ],
                "items": [
                  {
                    "behavior": "Pick a local audio file without uploading it.",
                    "control": "Choose"
                  },
                  {
                    "behavior": "Reset count and begin the loop.",
                    "control": "Start"
                  },
                  {
                    "behavior": "Pause track playback.",
                    "control": "Pause"
                  },
                  {
                    "behavior": "Continue the loop after a pause.",
                    "control": "Resume"
                  },
                  {
                    "behavior": "Finish current play and move to next.",
                    "control": "Skip"
                  },
                  {
                    "behavior": "Stop playback and keep the selected file ready.",
                    "control": "Stop"
                  }
                ]
              },
              "subtitle": "Core playback controls.",
              "title": "Session Controls",
              "tone": "blue",
              "widget": "dataTable"
            },
            {
              "kind": "recordList",
              "props": {
                "emptyText": "No saved loop sessions yet.",
                "subtitleFields": [
                  "file_name",
                  "completed_plays",
                  "target_plays",
                  "status"
                ]
              },
              "query": {
                "collections": [
                  "session"
                ],
                "limit": 8
              },
              "subtitle": "Saved loop sessions appear here when the runtime persists them.",
              "title": "Recent Sessions"
            }
