          "indexed": true,
          "required": true,
          "type": "text"
        },
        "notes": {
          "type": "text"
        },
        "properties": {
          "required": true,
          "type": "json"
        },
        "started_at": {
          "indexed": true,
          "type": "timestamp"
        },
        "status": {
          "indexed": true,
