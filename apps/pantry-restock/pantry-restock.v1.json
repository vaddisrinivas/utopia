{
  "schemaVersion": "wonder.app-package.v2",
  "id": "pantry-restock",
  "version": "2.0.0",
  "collections": {
    "restock_item": {
      "id": "restock_item",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "checked": {
          "type": "boolean",
          "indexed": true
        },
        "position": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "current_quantity": {
          "type": "number",
          "indexed": true
        },
        "target_quantity": {
          "type": "number",
          "indexed": true
        },
        "storage_area": {
          "type": "text",
          "indexed": true
        },
        "restock_status": {
          "type": "text",
          "indexed": true
        },
        "expiry_date": {
          "type": "timestamp",
          "indexed": true
        },
        "days_until_expiry": {
          "type": "number",
          "indexed": true
        },
        "usage_rate": {
          "type": "text",
          "indexed": true
        },
        "barcode": {
          "type": "text",
          "indexed": true
        },
        "shopping_lane": {
          "type": "text",
          "indexed": true
        },
        "last_seen_at": {
          "type": "timestamp",
          "indexed": true
        }
      }
    },
    "pantry_location": {
      "id": "pantry_location",
      "fields": {
        "position": {
          "type": "number",
          "indexed": true
        },
        "zone": {
          "type": "text",
          "indexed": true
        },
        "owner": {
          "type": "text"
        },
        "item_count": {
          "type": "number"
        }
      }
    },
    "inventory_event": {
      "id": "inventory_event",
      "fields": {
        "item_id": {
          "type": "text",
          "indexed": true
        },
        "event_type": {
          "type": "text",
          "indexed": true
        },
        "quantity_before": {
          "type": "number"
        },
        "quantity_after": {
          "type": "number"
        },
        "happened_at": {
          "type": "timestamp",
          "indexed": true
        },
        "offline": {
          "type": "boolean",
          "indexed": true
        },
        "note": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "restock-items": {
      "from": "restock_item",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "restock-needed": {
      "from": "restock_item",
      "where": {
        "op": "eq",
        "field": "restock_status",
        "value": "needed"
      },
      "orderBy": [
        {
          "field": "shopping_lane",
          "direction": "asc"
        },
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "expiring-items": {
      "from": "restock_item",
      "where": {
        "op": "lte",
        "field": "days_until_expiry",
        "value": 7
      },
      "orderBy": [
        {
          "field": "days_until_expiry",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "pantry-locations": {
      "from": "pantry_location",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "inventory-events": {
      "from": "inventory_event",
      "orderBy": [
        {
          "field": "happened_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "restock-items": {
      "id": "restock-items",
      "query": "restock-items",
      "mode": "list",
      "fields": [
        "title",
        "checked",
        "position",
        "current_quantity",
        "target_quantity",
        "storage_area",
        "restock_status",
        "expiry_date",
        "usage_rate",
        "barcode"
      ]
    },
    "restock-needed": {
      "id": "restock-needed",
      "query": "restock-needed",
      "mode": "list",
      "fields": [
        "title",
        "current_quantity",
        "target_quantity",
        "storage_area",
        "shopping_lane"
      ]
    },
    "expiring-items": {
      "id": "expiring-items",
      "query": "expiring-items",
      "mode": "timeline",
      "fields": [
        "title",
        "expiry_date",
        "days_until_expiry",
        "storage_area"
      ]
    },
    "pantry-locations": {
      "id": "pantry-locations",
      "query": "pantry-locations",
      "mode": "list",
      "fields": [
        "title",
        "zone",
        "owner",
        "item_count"
      ]
    },
    "inventory-events": {
      "id": "inventory-events",
      "query": "inventory-events",
      "mode": "timeline",
      "fields": [
        "title",
        "event_type",
        "happened_at",
        "note"
      ]
    },
    "item-events": {
      "id": "item-events",
      "query": "inventory-events",
      "mode": "timeline",
      "fields": [
        "title",
        "event_type",
        "quantity_before",
        "quantity_after",
        "happened_at"
      ]
    }
  },
  "rules": [
    {
      "id": "pantry-restock-threshold-workflow",
      "trigger": {
        "kind": "query_transition",
        "query": "restock-needed",
        "transition": "enter"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": "review_pantry_restock_lane"
      },
      "mode": "suggest",
      "maxRunsPerEvent": 8
    },
    {
      "id": "pantry-expiry-review-workflow",
      "trigger": {
        "kind": "query_transition",
        "query": "expiring-items",
        "transition": "enter"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": "schedule_expiry_review"
      },
      "mode": "suggest",
      "maxRunsPerEvent": 8
    }
  ],
  "capabilities": [
    "records.write",
    "records.sync",
    "camera.scan",
    "notifications.schedule",
    "file.export"
  ],
  "acceptanceTests": [
    "pantry-restock-create-edit-detail",
    "pantry-restock-threshold-oracle",
    "pantry-expiry-reminder-surface",
    "pantry-offline-recovery"
  ],
  "presentation": {
    "label": "Pantry Restock",
    "homeSurface": "home",
    "visualIdentity": {
      "icon": "archive",
      "tone": "market",
      "accent": "#7A4A1E",
      "canvas": "#F7F2E8",
      "secondaryAccent": "#2F6B4F"
