{
  "schemaVersion": "wonder.app-package.v2",
  "id": "unit-converter",
  "version": "2.0.0",
  "collections": {
    "conversion": {
      "id": "conversion",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "category": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "from_unit": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "to_unit": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "input_value": {
          "type": "number",
          "required": true
        },
        "factor": {
          "type": "number",
          "required": true
        },
        "offset": {
          "type": "number",
          "required": true
        },
        "precision": {
          "type": "number"
        },
        "favorite": {
          "type": "boolean",
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "scenario": {
      "id": "scenario",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "category": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "source_conversion": {
          "type": "text",
          "indexed": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "notes": {
          "type": "text"
        },
        "updated_at": {
          "type": "timestamp",
          "indexed": true
        }
      }
    }
  },
  "queries": {
    "conversions": {
      "from": "conversion",
      "orderBy": [
        {
          "field": "favorite",
          "direction": "desc"
        },
        {
          "field": "category",
          "direction": "asc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "recent_conversions": {
      "from": "conversion",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 50
    },
    "scenarios": {
      "from": "scenario",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "conversions": {
      "id": "conversions",
      "query": "conversions",
      "mode": "table",
      "fields": [
        "title",
        "category",
        "input_value",
        "from_unit",
        "converted_value",
        "to_unit"
      ]
    },
    "recent_conversions": {
      "id": "recent_conversions",
      "query": "recent_conversions",
      "mode": "timeline",
      "fields": [
        "title",
        "category",
        "converted_value",
        "updated_at"
      ]
    },
    "scenarios": {
      "id": "scenarios",
      "query": "scenarios",
      "mode": "list",
      "fields": [
        "title",
        "category",
        "status"
      ]
    }
  },
  "computedFields": [
    {
      "id": "converted_value",
      "collection": "conversion",
      "dependsOn": [],
      "expression": {
        "+": [
          {
            "*": [
              {
                "var": "record.input_value"
              },
              {
                "var": "record.factor"
              }
            ]
          },
          {
            "var": "record.offset"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "multiplicative-unit-conversion",
    "affine-temperature-conversion",
    "decimal-rounding-is-deterministic",
    "saved-conversion-scenarios",
    "unit-category-workspace"
  ],
