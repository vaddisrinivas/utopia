{
  "schemaVersion": "wonder.app-package.v2",
  "id": "recipe-scaler",
  "version": "2.0.0",
  "collections": {
    "recipe_plan": {
      "id": "recipe_plan",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "base_servings": {
          "type": "number",
          "required": true
        },
        "target_servings": {
          "type": "number",
          "required": true
        },
        "entered_total_cost": {
          "type": "number"
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "ingredient": {
      "id": "ingredient",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "recipe": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "section": {
          "type": "text",
          "indexed": true
        },
        "base_quantity": {
          "type": "number",
          "required": true
        },
        "scale_factor": {
          "type": "number",
          "required": true
        },
        "unit": {
          "type": "text",
          "required": true
        },
        "conversion_factor": {
          "type": "number"
        },
        "target_unit": {
          "type": "text"
        },
        "unit_cost": {
          "type": "number"
        },
        "prep_status": {
          "type": "text",
          "indexed": true
        },
        "position": {
          "type": "number",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "plans": {
      "from": "recipe_plan",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 50
    },
    "ingredients": {
      "from": "ingredient",
      "orderBy": [
        {
          "field": "recipe",
          "direction": "asc"
        },
        {
          "field": "section",
          "direction": "asc"
        },
        {
          "field": "position",
          "direction": "asc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "prep_items": {
      "from": "ingredient",
      "orderBy": [
        {
          "field": "prep_status",
          "direction": "asc"
        },
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 200
    }
  },
  "views": {
    "plans": {
      "id": "plans",
      "query": "plans",
      "mode": "list",
      "fields": [
        "title",
        "base_servings",
        "target_servings",
        "scale_factor",
        "total_cost",
        "cost_per_plate"
      ]
    },
    "ingredients": {
      "id": "ingredients",
      "query": "ingredients",
      "mode": "table",
      "fields": [
        "title",
        "base_quantity",
        "scale_factor",
        "scaled_quantity",
        "unit",
        "line_cost"
      ]
    },
    "prep_items": {
      "id": "prep_items",
      "query": "prep_items",
      "mode": "list",
      "fields": [
        "title",
        "section",
        "prep_status"
      ]
    }
  },
  "computedFields": [
    {
      "id": "scale_factor",
      "collection": "recipe_plan",
      "dependsOn": [],
      "expression": {
        "/": [
          {
            "var": "record.target_servings"
          },
          {
            "var": "record.base_servings"
          }
        ]
      }
    },
    {
      "id": "scaled_quantity",
      "collection": "ingredient",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "var": "record.base_quantity"
          },
          {
            "var": "record.scale_factor"
          }
        ]
      }
    },
    {
      "id": "converted_scaled_quantity",
      "collection": "ingredient",
      "dependsOn": [
        "scaled_quantity"
      ],
      "expression": {
        "*": [
          {
            "var": "computed.scaled_quantity"
          },
          {
            "var": [
              "record.conversion_factor",
              1
            ]
          }
        ]
      }
    },
    {
      "id": "line_cost",
      "collection": "ingredient",
      "dependsOn": [
        "scaled_quantity"
      ],
      "expression": {
        "*": [
          {
            "var": "computed.scaled_quantity"
          },
          {
            "var": [
              "record.unit_cost",
              0
            ]
          }
        ]
      }
    },
    {
      "id": "total_cost",
      "collection": "recipe_plan",
      "dependsOn": [],
      "expression": {
        "+": [
          {
            "var": [
              "record.entered_total_cost",
              0
            ]
          },
          0
        ]
      }
    },
    {
      "id": "cost_per_plate",
      "collection": "recipe_plan",
      "dependsOn": [
        "total_cost"
      ],
      "expression": {
        "/": [
          {
            "var": "computed.total_cost"
          },
          {
            "var": "record.target_servings"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "ingredient-quantities-scale-per-row",
    "fractional-scale-rounding-is-deterministic",
    "recipe-cost-per-plate",
    "offline-prep-sheet",
    "unit-conversion-factor"
  ],
