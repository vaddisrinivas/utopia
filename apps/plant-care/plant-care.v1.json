{
  "schemaVersion": "wonder.app-package.v2",
  "id": "plant-care",
  "version": "2.0.0",
  "collections": {
    "plant": {
      "id": "plant",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "species": {
          "type": "text",
          "indexed": true
        },
        "location": {
          "type": "text",
          "indexed": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "last_cared_at": {
          "type": "timestamp",
          "indexed": true
        },
        "as_of": {
          "type": "timestamp",
          "indexed": true
        },
        "schedule": {
          "type": "json",
          "required": true
        },
        "diagnosis": {
          "type": "text"
        },
        "light": {
          "type": "text"
        },
        "humidity": {
          "type": "text"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "care_log": {
      "id": "care_log",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "plant_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "care_type": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "completed_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "amount": {
          "type": "number"
        },
        "health_score": {
          "type": "number"
        },
        "diagnosis": {
          "type": "text"
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "active-plants": {
      "from": "plant",
      "where": {
        "field": "status",
        "op": "eq",
        "value": "active"
      },
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "care-history": {
      "from": "care_log",
      "orderBy": [
        {
          "field": "completed_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "attention-plants": {
      "from": "plant",
      "where": {
        "field": "status",
        "op": "neq",
        "value": "archived"
      },
      "orderBy": [
        {
          "field": "as_of",
          "direction": "asc"
        }
      ],
      "limit": 50
    }
  },
  "views": {
    "plants": {
      "id": "plants",
      "query": "active-plants",
      "mode": "list",
      "fields": [
        "title",
        "species",
        "location",
        "last_cared_at",
        "next_care",
        "care_window"
      ]
    },
    "history": {
      "id": "history",
      "query": "care-history",
      "mode": "table",
      "fields": [
        "title",
        "plant_id",
        "care_type",
        "completed_at",
        "amount",
        "health_score",
        "notes"
      ]
    },
    "attention": {
      "id": "attention",
      "query": "attention-plants",
      "mode": "calendar",
      "fields": [
        "title",
        "species",
        "location",
        "next_care",
        "status"
      ]
    }
  },
  "computedFields": [
    {
      "id": "next_care",
      "collection": "plant",
      "dependsOn": [],
      "expression": {
        "recurrence_next": {
          "schedule": {
            "var": "record.schedule"
          },
          "after": {
            "var": "record.as_of"
          },
          "budget": {
            "maxOccurrences": 1,
            "maxIterations": 32,
            "maxRuleEvaluations": 64,
            "maxLookaheadDays": 730,
            "maxExclusions": 32,
            "maxOverrides": 32
          }
        }
      }
    },
    {
      "id": "care_window",
      "collection": "plant",
      "dependsOn": [
        "next_care"
      ],
      "expression": {
        "recurrence_expand": {
          "schedule": {
            "var": "record.schedule"
          },
          "after": {
            "var": "record.as_of"
          },
          "limit": 4,
          "budget": {
            "maxOccurrences": 4,
            "maxIterations": 64,
            "maxRuleEvaluations": 128,
            "maxLookaheadDays": 730,
            "maxExclusions": 32,
            "maxOverrides": 32
          }
        }
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "plant-care-schedules",
    "recurrence-next-care-oracle",
    "plant-journal-entry",
    "plant-growth-tracking",
    "plant-collection-sorting",
    "plant-offline-local-use",
    "plant-no-account-required",
    "gold-from-scratch-presentation",
    "generic-widget-only"
  ],
  "presentation": {
