            {
              "id": "fuel-validation-error",
              "kind": "text",
              "title": "Fill-up needs distance, volume, and price",
              "subtitle": "Invalid or missing numbers block cost and efficiency updates.",
              "dataState": "error",
              "props": {
                "role": "alert",
                "liveRegion": "assertive"
              }
            },
            {
              "id": "fuel-station-context",
              "kind": "widget",
              "widget": "locationMap",
              "title": "Station context",
              "query": {
                "collections": [
