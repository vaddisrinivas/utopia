{
  "schemaVersion": "wonder.app-package.v2",
  "id": "fuel-log",
  "version": "2.0.0",
  "collections": {
    "fill_up": {
      "id": "fill_up",
      "fields": {
        "date": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "odometer": {
          "type": "number",
          "required": true
        },
        "volume": {
          "type": "number",
          "required": true
        },
        "unit_price": {
          "type": "number",
          "required": true
        },
        "distance_since_last": {
          "type": "number",
          "required": true
        },
        "vehicle_id": {
          "type": "text",
          "indexed": true
        },
        "station": {
          "type": "text"
        },
        "full_tank": {
          "type": "boolean",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "fill-ups": {
      "from": "fill_up",
      "orderBy": [
        {
          "field": "date",
          "direction": "desc"
        }
      ],
      "limit": 500
    }
  },
  "views": {
    "fill-ups": {
      "id": "fill-ups",
      "query": "fill-ups",
      "mode": "table",
      "fields": [
        "title",
        "date",
        "vehicle_id",
        "odometer",
        "volume",
        "unit_price",
        "cost",
        "distance_since_last",
        "efficiency",
        "station",
        "full_tank"
      ]
    }
  },
  "computedFields": [
    {
      "id": "cost",
      "collection": "fill_up",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "var": "record.volume"
          },
          {
            "var": "record.unit_price"
          }
        ]
      }
    },
    {
      "id": "efficiency",
      "collection": "fill_up",
      "dependsOn": [],
      "expression": {
        "/": [
          {
            "var": "record.distance_since_last"
          },
          {
            "var": "record.volume"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "cost-derived-from-volume-and-price",
    "efficiency-derived-from-distance-and-volume",
    "history-newest-first"
  ],
  "presentation": {
    "label": "Fuel Log",
    "homeSurface": "overview",
    "surfaces": [
      {
        "id": "overview",
        "label": "Fuel",
        "collections": [
          "fill_up"
        ],
        "views": [
          "fill-ups"
        ]
      },
      {
        "id": "capture",
        "label": "Fill up",
        "collections": [
          "fill_up"
        ],
        "views": [
          "fill-ups"
        ]
      },
      {
        "id": "reports",
        "label": "Trends",
        "collections": [
          "fill_up"
        ],
        "views": [
          "fill-ups"
        ]
      },
      {
        "id": "history",
        "label": "History",
        "collections": [
          "fill_up"
        ],
        "views": [
          "fill-ups"
        ]
      },
      {
        "id": "settings",
        "label": "Settings",
        "collections": [
          "fill_up"
        ],
        "views": [
          "fill-ups"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "fuel",
      "tone": "moss",
      "accent": "#0E6B4E",
      "canvas": "#F5FAF7",
      "identity": "A field-ready vehicle logbook built around the next fill-up, not a generic record dashboard.",
      "typography": {
        "heading": "condensed operational",
        "body": "plain numeric ledger"
      },
      "rationale": "Green ledger surfaces, compact numeric tables, and receipt-first controls distinguish vehicle operating cost from finance or invoice workflows."
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "overview",
      "navigation": {
        "items": [
          {
            "screen": "overview",
            "label": "Logbook",
            "icon": "bar-chart"
          },
          {
            "screen": "capture",
            "label": "Fill-up",
            "icon": "plus"
          },
          {
            "screen": "reports",
            "label": "Analytics",
            "icon": "bar-chart"
          },
          {
            "screen": "history",
            "label": "History",
            "icon": "rotate-ccw"
          },
          {
            "screen": "settings",
            "label": "Garage",
            "icon": "settings"
          }
        ]
      },
      "screens": {
        "overview": {
          "title": "Fill-up desk",
          "subtitle": "Record the latest stop and see cost per tank immediately.",
          "shell": {
            "layoutMode": "dashboardWorkspace",
            "appBarTitle": "Fuel Log",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "overview",
            "tabs": [
              {
                "id": "overview",
                "screen": "overview",
                "label": "Logbook"
              },
              {
                "id": "capture",
                "screen": "capture",
                "label": "Fill-up"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Analytics"
              },
              {
                "id": "history",
                "screen": "history",
                "label": "History"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Garage"
              }
            ],
            "theme": {
              "canvas": "#F5FAF7",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E6F1EA",
              "ink": "#17211B",
              "muted": "#5C6F66",
              "accent": "#0E6B4E",
              "accentContrast": "#FFFFFF",
              "border": "#C9D8D0",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E5EFFA",
              "statusSuccess": "#DDF4E8",
              "statusWarning": "#FFF3BF",
              "statusError": "#FCE4DF"
            },
            "responsive": {
              "breakpoint": 760,
              "maxContentWidth": 1180,
              "narrowPadding": 16,
              "widePadding": 32,
              "phoneColumns": 1,
              "desktopColumns": 12
            },
            "accessibility": {
              "focusOrder": "document",
              "minimumTargetSize": 44,
              "announces": [
                "loading",
                "saved",
                "error",
                "offline",
                "recovered"
              ],
              "chartSummaries": true,
              "reducedMotion": true
            }
          },
          "components": [
            {
              "id": "fuel-fill-editor",
              "kind": "widget",
              "widget": "structuredList",
              "title": "Latest fill-up",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 100
              },
              "props": {
                "collection": "fill_up",
                "placeholder": "Add odometer, litres, and price",
                "emptyText": "Log the first fill-up to calculate cost and efficiency.",
                "appearance": "ledger",
                "progressiveDisclosure": false,
                "metadataFields": [
                  {
                    "field": "date",
                    "label": "Fill-up date",
                    "type": "text",
                    "sortable": true,
                    "filterable": true,
                    "required": true
                  },
                  {
                    "field": "vehicle_id",
                    "label": "Vehicle",
                    "type": "text",
                    "sortable": true,
                    "filterable": true
                  },
                  {
                    "field": "odometer",
                    "label": "Odometer",
                    "type": "number",
                    "sortable": true,
                    "required": true
                  },
                  {
                    "field": "distance_since_last",
                    "label": "Distance since last",
                    "type": "number",
                    "sortable": true,
                    "required": true
                  },
                  {
                    "field": "volume",
                    "label": "Fuel volume",
                    "type": "number",
                    "sortable": true,
                    "required": true
                  },
                  {
                    "field": "unit_price",
                    "label": "Unit price",
                    "type": "number",
                    "sortable": true,
                    "required": true
                  },
                  {
                    "field": "station",
                    "label": "Station",
                    "type": "text",
                    "filterable": true
                  },
                  {
                    "field": "full_tank",
                    "label": "Full tank",
                    "type": "select",
                    "options": [
                      "true",
                      "false"
                    ],
                    "filterable": true
                  },
                  {
                    "field": "notes",
                    "label": "Receipt and service notes",
                    "type": "text"
                  }
                ],
                "sorts": [
                  "manual",
                  {
                    "kind": "field",
                    "field": "date",
                    "label": "Newest date"
                  },
                  {
                    "kind": "field",
                    "field": "vehicle_id",
                    "label": "Vehicle"
                  }
                ],
                "filterFields": [
                  "vehicle_id",
                  "station",
                  "full_tank"
                ],
                "commandPolicy": {
                  "autosave": "blur",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 10000
                  },
                  "offline": "queue",
                  "validation": {
                    "mode": "submit",
                    "requiredFields": [
                      "date",
                      "odometer",
                      "volume",
                      "unit_price",
                      "distance_since_last"
                    ]
                  },
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 604800000
                  },
                  "accessibleStatus": {
                    "enabled": true,
                    "labels": {
                      "pending": "Saving changes",
                      "saved": "Changes saved",
                      "error": "Fix highlighted fields",
                      "queued": "Saved offline",
                      "undone": "Change undone",
                      "cancelled": "Change cancelled"
                    }
                  }
                }
              }
            },
            {
              "id": "fuel-log-save-action",
              "kind": "action",
              "title": "Save fill-up",
              "placement": "inline",
              "tone": "moss",
              "action": {
                "kind": "propose",
                "command": "fuel_log_save_fill_up",
                "payload": {
                  "collection": "fill_up"
                }
              }
            },
            {
              "id": "fuel-loading-state",
              "kind": "metric",
              "title": "Loading vehicle log",
              "dataState": "loading",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 1
              },
              "props": {
                "emptyText": "Reading local fuel records."
              }
            },
            {
              "id": "fuel-empty-ledger",
              "kind": "text",
              "title": "No fuel history yet",
              "subtitle": "The first saved fill-up creates the cost and efficiency baseline.",
              "props": {
                "role": "status"
              }
            },
            {
              "id": "fuel-cost-metric",
              "kind": "metric",
              "title": "Latest tank cost",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 50
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "valueField": "cost"
              },
              "props": {
                "valueField": "cost",
                "emptyText": "Cost appears after volume and unit price are saved."
              }
            },
            {
              "id": "fuel-efficiency-metric",
              "kind": "metric",
              "title": "Distance per unit",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 50
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "avg",
                "valueField": "efficiency"
              },
              "props": {
                "valueField": "efficiency",
                "emptyText": "Efficiency appears after distance and volume are saved."
              }
            },
            {
              "id": "fuel-recent-fill-ups",
              "kind": "widget",
              "widget": "recordReviewCard",
              "title": "Review this stop",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 8
              },
              "props": {
                "subtitle": "Check inputs before they become the vehicle baseline.",
                "badge": "Fuel receipt",
                "items": [
                  {
                    "id": "vehicle",
                    "title": "Vehicle",
                    "detail": "Family SUV"
                  },
                  {
                    "id": "volume",
                    "title": "Volume",
                    "detail": "40 gal"
                  },
                  {
                    "id": "price",
                    "title": "Unit price",
                    "detail": "$3.90"
                  },
                  {
                    "id": "computed",
                    "title": "Cost / efficiency",
                    "detail": "$156.00 / 12.50 mpg"
                  }
                ],
                "actions": [
                  {
                    "id": "edit-fill-up",
                    "title": "Edit fill-up",
                    "route": "/capture"
                  },
                  {
                    "id": "open-detail",
                    "title": "Open detail",
                    "route": "/history"
                  }
                ]
              }
            }
          ]
        },
        "capture": {
          "title": "Fill-up editor",
          "subtitle": "Fix the receipt, odometer, or full-tank flag before reports update.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "appBarTitle": "Fuel Log",
