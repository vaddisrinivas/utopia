            {
              "id": "fuel-export-panel",
              "kind": "widget",
              "widget": "fileExport",
              "title": "CSV packet",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 200
              },
              "props": {
                "format": "csv",
                "filename": "fuel-log.csv",
                "fields": [
                  "date",
                  "vehicle_id",
                  "odometer",
                  "volume",
                  "unit_price",
                  "cost",
                  "efficiency"
                ],
                "emptyText": "Export preview appears after records exist."
