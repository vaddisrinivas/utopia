          "components": [
            {
              "id": "fuel-efficiency-chart",
              "kind": "widget",
              "widget": "chartBlock",
              "title": "Efficiency by fill-up",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 200
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "avg",
                "groupBy": "date",
                "valueField": "efficiency",
                "labelField": "date"
              },
              "props": {
                "chartType": "line",
                "xField": "date",
                "yField": "efficiency",
                "emptyText": "Efficiency trend appears after two fill-ups.",
                "summary": "Distance divided by volume shows fuel efficiency for each fill-up."
              }
            },
            {
              "id": "fuel-spend-chart",
              "kind": "widget",
              "widget": "chartBlock",
              "title": "Spend by vehicle",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 200
              },
