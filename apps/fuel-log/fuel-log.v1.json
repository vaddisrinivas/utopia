          "components": [
            {
              "id": "fuel-detail-card",
              "kind": "widget",
              "widget": "recordContentCard",
              "title": "Fill-up detail",
              "query": {
                "collections": [
                  "fill_up"
                ],
                "limit": 1
              },
              "props": {
                "subtitle": "One stop, all fields, one recoverable edit trail.",
                "badge": "Editable",
                "chips": [
                  {
                    "id": "date",
                    "label": "Date",
                    "value": "{date}"
                  },
                  {
                    "id": "station",
