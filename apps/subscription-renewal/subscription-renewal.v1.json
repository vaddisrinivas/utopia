{
  "schemaVersion": "wonder.app-package.v2",
  "id": "subscription-renewal",
  "version": "1.0.0",
  "collections": {
    "primary": {
      "id": "primary",
      "fields": {
        "service": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "amount": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "renewal_date": {
          "type": "timestamp",
          "required": false,
          "indexed": true
        },
        "cadence": {
          "type": "text",
          "required": false,
          "indexed": false
        },
        "status": {
          "type": "text",
          "required": false,
          "indexed": false
        },
        "schedule": {
          "type": "json",
          "required": false,
          "indexed": false
        },
        "monthly_cost": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "annual_cost": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "position": {
          "type": "number",
          "required": false,
          "indexed": false
        }
      }
    }
  },
  "queries": {
    "subscription-records": {
      "from": "primary",
      "orderBy": [
        {
          "field": "service",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "overview": {
      "id": "overview",
      "query": "subscription-records",
      "mode": "list",
      "fields": [
        "service",
        "amount",
        "renewal_date",
        "cadence",
        "status",
        "next_renewal"
      ]
    }
  },
  "computedFields": [
    {
      "id": "next_renewal",
      "collection": "primary",
      "dependsOn": [],
      "expression": {
        "recurrence_next": {
          "schedule": {
            "if": [
              {
                "==": [
                  {
                    "var": [
                      "record.cadence",
                      "monthly"
                    ]
                  },
                  "daily"
                ]
              },
              {
                "schemaVersion": "utopia.recurrence.v1",
                "timezone": "UTC",
                "anchor": {
                  "var": "record.renewal_date"
                },
                "dstPolicy": "compatible",
                "rules": [
                  {
                    "id": "daily",
                    "kind": "interval",
                    "every": 1,
                    "unit": "day"
                  }
                ]
              },
              {
                "==": [
                  {
                    "var": [
                      "record.cadence",
                      "monthly"
                    ]
                  },
                  "weekly"
                ]
              },
              {
                "schemaVersion": "utopia.recurrence.v1",
                "timezone": "UTC",
                "anchor": {
                  "var": "record.renewal_date"
                },
                "dstPolicy": "compatible",
                "rules": [
                  {
                    "id": "weekly",
                    "kind": "interval",
                    "every": 1,
                    "unit": "week"
                  }
                ]
              },
              {
                "==": [
                  {
                    "var": [
                      "record.cadence",
                      "monthly"
                    ]
                  },
                  "yearly"
                ]
              },
              {
                "schemaVersion": "utopia.recurrence.v1",
                "timezone": "UTC",
                "anchor": {
                  "var": "record.renewal_date"
                },
                "dstPolicy": "compatible",
                "rules": [
                  {
                    "id": "yearly",
                    "kind": "interval",
                    "every": 1,
                    "unit": "year"
                  }
                ]
              },
              {
                "schemaVersion": "utopia.recurrence.v1",
                "timezone": "UTC",
                "anchor": {
                  "var": "record.renewal_date"
                },
                "dstPolicy": "compatible",
                "rules": [
                  {
                    "id": "monthly",
                    "kind": "interval",
                    "every": 1,
                    "unit": "month"
                  }
                ]
              }
            ]
          },
          "after": {
            "var": "record.renewal_date"
          }
        }
      }
    },
    {
      "id": "monthly_cost",
      "collection": "primary",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            "==": [
              {
                "var": [
                  "record.cadence",
                  "monthly"
                ]
              },
              "yearly"
            ]
          },
          {
            "/": [
              {
                "var": "record.amount"
              },
              12
            ]
          },
          {
            "==": [
              {
                "var": [
                  "record.cadence",
                  "monthly"
                ]
              },
              "weekly"
            ]
          },
          {
            "/": [
              {
                "*": [
                  {
                    "var": "record.amount"
                  },
                  52
                ]
              },
              12
            ]
          },
          {
            "==": [
              {
                "var": [
                  "record.cadence",
                  "monthly"
                ]
              },
              "daily"
            ]
          },
          {
            "/": [
              {
                "*": [
                  {
                    "var": "record.amount"
                  },
                  365
                ]
              },
              12
            ]
          },
          {
            "var": "record.amount"
          }
        ]
      }
    },
    {
      "id": "annual_cost",
      "collection": "primary",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            "==": [
              {
                "var": [
                  "record.cadence",
                  "monthly"
                ]
              },
              "monthly"
            ]
          },
          {
            "*": [
              {
                "var": "record.amount"
              },
              12
            ]
          },
          {
            "==": [
              {
                "var": [
                  "record.cadence",
                  "monthly"
                ]
              },
              "weekly"
            ]
          },
          {
            "*": [
              {
                "var": "record.amount"
              },
              52
            ]
          },
          {
            "==": [
              {
                "var": [
                  "record.cadence",
                  "monthly"
                ]
              },
              "daily"
            ]
          },
          {
            "*": [
              {
                "var": "record.amount"
              },
              365
            ]
          },
          {
            "var": "record.amount"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
