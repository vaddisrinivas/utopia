{
  "schemaVersion": "wonder.app-package.v2",
  "id": "debt-payoff",
  "version": "1.0.0",
  "collections": {
    "debt": {
      "id": "debt",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "balance": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "annual_rate_percent": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "payment": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "period_label": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "debts": {
      "from": "debt",
      "orderBy": [
        {
          "field": "balance",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "debts": {
      "id": "debts",
      "query": "debts",
      "mode": "table",
      "fields": [
        "title",
        "balance",
        "annual_rate_percent",
        "payment",
        "period_interest",
        "principal_payment",
        "remaining_balance"
      ]
    }
  },
  "computedFields": [
    {
      "id": "period_interest",
      "collection": "debt",
      "dependsOn": [],
      "expression": {
        "/": [
          {
            "*": [
              {
                "var": "record.balance"
              },
              {
                "var": "record.annual_rate_percent"
              }
            ]
          },
          1200
        ]
      }
    },
    {
      "id": "principal_payment",
      "collection": "debt",
      "dependsOn": [
        "period_interest"
      ],
      "expression": {
        "-": [
          {
            "var": "record.payment"
          },
          {
            "var": "computed.period_interest"
          }
        ]
      }
    },
    {
      "id": "remaining_balance",
      "collection": "debt",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            "<=": [
              {
                "-": [
                  {
                    "var": "record.balance"
                  },
                  {
                    "var": "record.payment"
                  }
                ]
              },
              0
            ]
          },
          0,
          {
            "-": [
              {
                "var": "record.balance"
              },
              {
                "var": "record.payment"
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "balance-rate-payment-inputs-are-required",
    "monthly-interest-is-balance-times-annual-rate-over-1200",
    "principal-payment-is-payment-minus-period-interest",
    "remaining-balance-floors-at-zero",
    "full-payoff-schedule-and-date-are-explicit-boundary"
  ],
