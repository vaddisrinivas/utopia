{
  "schemaVersion": "wonder.app-package.v2",
  "id": "budget-forecast",
  "version": "1.0.0",
  "collections": {
    "budget_line": {
      "id": "budget_line",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "period": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "category": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "planned": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "actual": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "computedFields": [
    {
      "id": "variance",
      "collection": "budget_line",
      "dependsOn": [],
      "expression": {
        "-": [
          {
            "var": "record.actual"
          },
          {
            "var": "record.planned"
          }
        ]
      }
    },
    {
      "id": "remaining",
      "collection": "budget_line",
      "dependsOn": [],
      "expression": {
        "-": [
          {
            "var": "record.planned"
          },
          {
            "var": "record.actual"
          }
        ]
      }
    }
  ],
  "queries": {
    "lines": {
      "from": "budget_line",
      "orderBy": [
        {
          "field": "period",
          "direction": "desc"
        },
        {
          "field": "category",
          "direction": "asc"
        }
      ],
      "limit": 200
    }
  },
  "views": {
    "home": {
      "id": "home",
      "query": "lines",
      "mode": "table",
      "fields": [
        "title",
        "period",
        "category",
        "planned",
        "actual",
        "variance",
        "remaining"
      ],
      "layout": {
        "size": "feature",
        "tone": "moss"
      }
    },
    "transactions": {
      "id": "transactions",
      "query": "lines",
      "mode": "table",
      "fields": [
        "title",
        "period",
        "category",
        "planned",
        "actual",
        "variance",
        "remaining"
      ],
      "layout": {
        "size": "wide",
        "tone": "moss"
      }
    },
    "forecast": {
      "id": "forecast",
      "query": "lines",
      "mode": "chart",
      "fields": [
        "period",
        "planned",
        "actual",
        "remaining"
      ],
      "layout": {
        "size": "wide",
        "tone": "blue"
      }
    },
    "comparison": {
      "id": "comparison",
      "query": "lines",
      "mode": "table",
      "fields": [
        "category",
        "planned",
        "actual",
        "variance",
        "remaining"
      ],
      "layout": {
        "size": "wide",
        "tone": "amber"
      }
    },
    "settings": {
      "id": "settings",
      "query": "lines",
      "mode": "list",
      "fields": [
        "title",
        "period",
        "notes"
      ],
      "layout": {
        "size": "standard",
        "tone": "neutral"
      }
    }
  },
  "rules": [],
  "capabilities": [
    "records.read",
    "records.write",
    "offline.local"
  ],
  "acceptanceTests": [
    "planned-and-actual-inputs-are-required",
    "variance-is-actual-minus-planned",
    "remaining-is-planned-minus-actual",
    "running-balance",
    "planned-actual-variance",
    "recurring-month"
  ],
