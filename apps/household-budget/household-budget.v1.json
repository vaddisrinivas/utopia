{
  "schemaVersion": "wonder.app-package.v2",
  "id": "household-budget",
  "version": "2.0.0",
  "collections": {
    "budget_entry": {
      "id": "budget_entry",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "amount": {
          "type": "number",
          "required": true
        },
        "category": {
          "type": "text",
          "indexed": true
        },
        "recorded_at": {
          "type": "timestamp",
          "indexed": true
        },
        "source": {
          "type": "text"
        },
        "direction": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "month": {
          "type": "text",
          "indexed": true
        },
        "signed_amount": {
          "type": "number"
        },
        "note": {
          "type": "text"
        },
        "position": {
          "type": "number",
          "indexed": true
        }
      }
    },
    "budget_category": {
      "id": "budget_category",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "limit": {
          "type": "number"
        },
        "month": {
          "type": "text",
          "indexed": true
        },
        "color": {
          "type": "text"
        },
        "position": {
          "type": "number",
          "indexed": true
        }
      }
    }
  },
  "queries": {
    "budget-entries": {
      "from": "budget_entry",
      "orderBy": [
        {
          "field": "recorded_at",
          "direction": "desc"
        }
      ],
      "limit": 200
    },
    "budget-categories": {
      "from": "budget_category",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 80
    }
  },
  "views": {
    "budget-entries": {
      "id": "budget-entries",
      "query": "budget-entries",
      "mode": "list",
      "fields": [
        "title",
        "amount",
        "signed_amount",
        "direction",
        "category",
        "month",
        "recorded_at",
        "note"
      ]
    },
    "budget-categories": {
      "id": "budget-categories",
      "query": "budget-categories",
      "mode": "list",
      "fields": [
        "title",
        "limit",
        "month",
        "color"
      ]
    }
  },
  "computedFields": [
    {
      "id": "signed_amount",
      "collection": "budget_entry",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            "==": [
              {
                "var": "record.direction"
              },
              "income"
            ]
          },
          {
            "+": [
              {
                "var": "record.amount"
              },
              0
            ]
          },
          {
            "-": [
              0,
              {
                "var": "record.amount"
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "household-budget-record-entry",
    "household-budget-grouped-total",
    "household-budget-trend-view",
    "household-budget-empty-state",
    "record-expense",
    "record-income"
  ],
  "presentation": {
    "label": "Household Budget",
    "homeSurface": "entries",
    "surfaces": [
      {
        "id": "entries",
        "label": "Record",
        "collections": [
          "budget_entry"
        ],
        "views": [
          "budget-entries"
        ]
      },
      {
        "id": "overview",
        "label": "Pulse",
        "collections": [
          "budget_entry"
        ],
        "views": [
          "budget-entries"
        ]
      },
      {
        "id": "categories",
        "label": "Plan",
        "collections": [
          "budget_category"
        ],
        "views": [
          "budget-categories"
        ]
      },
      {
        "id": "reports",
        "label": "Review",
        "collections": [
          "budget_entry"
        ],
        "views": [
          "budget-entries"
        ]
      },
      {
        "id": "settings",
        "label": "Household",
        "collections": [
          "budget_entry"
        ],
        "views": [
          "budget-entries"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "wallet",
      "tone": "amber",
      "accent": "#AD650E",
      "canvas": "#FFFAF2",
      "identity": "warm household money desk with fast capture before reports and planning"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "entries",
      "screens": {
        "entries": {
          "title": "Record",
          "subtitle": "Add income or spending",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "appBarTitle": "Budget",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "entries",
            "tabs": [
              {
                "id": "entries",
                "screen": "entries",
                "label": "Record"
              },
              {
                "id": "overview",
                "screen": "overview",
                "label": "Pulse"
              },
              {
                "id": "categories",
                "screen": "categories",
                "label": "Plan"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Review"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Household"
              }
            ],
            "theme": {
              "canvas": "#FFFAF2",
              "surface": "#FFFFFF",
              "surfaceMuted": "#FDF0D8",
              "ink": "#472D12",
              "muted": "#7D6647",
              "accent": "#AD650E",
              "accentContrast": "#FFFFFF",
              "border": "#F0D7AE",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 940,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "budget-entry-editor",
              "kind": "widget",
              "widget": "structuredList",
              "title": "Money in and out",
              "query": {
                "collections": [
                  "budget_entry"
                ],
                "limit": 200
              },
              "props": {
                "collection": "budget_entry",
                "positionField": "position",
                "placeholder": "Add rent, groceries, salary",
                "emptyText": "Record the first amount.",
                "appearance": "plain",
                "progressiveDisclosure": true,
                "metadataFields": [
                  {
                    "field": "amount",
                    "label": "Amount",
                    "type": "number",
                    "sortable": true
                  },
                  {
                    "field": "direction",
                    "label": "Type",
                    "type": "select",
                    "options": [
                      "income",
                      "expense"
                    ],
                    "filterable": true
                  },
                  {
                    "field": "category",
                    "label": "Category",
                    "type": "select",
                    "options": [
                      "Housing",
                      "Groceries",
                      "Transport",
                      "Utilities",
                      "Pay"
                    ],
                    "filterable": true,
                    "sortable": true
                  },
                  {
                    "field": "month",
                    "label": "Month",
                    "type": "text",
                    "filterable": true
                  },
                  {
                    "field": "note",
                    "label": "Note",
                    "type": "text"
                  }
                ],
                "sorts": [
                  "manual",
                  "alphabetic",
                  {
                    "kind": "field",
                    "field": "category",
                    "label": "Category"
                  }
                ],
                "filterFields": [
                  "direction",
                  "category",
                  "month"
                ]
              }
            },
            {
              "id": "budget-entry-history",
              "kind": "widget",
              "widget": "operationHistory",
              "title": "Recent edits",
              "props": {
                "collection": "budget_entry",
                "limit": 30,
                "emptyText": "Entry changes appear here."
              }
            }
          ]
        },
        "overview": {
          "title": "Pulse",
          "subtitle": "This month at a glance",
          "shell": {
            "layoutMode": "dashboardWorkspace",
            "appBarTitle": "Budget",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "overview",
            "tabs": [
              {
                "id": "entries",
                "screen": "entries",
                "label": "Record"
              },
              {
                "id": "overview",
                "screen": "overview",
                "label": "Pulse"
              },
              {
                "id": "categories",
                "screen": "categories",
                "label": "Plan"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Review"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Household"
              }
            ],
            "theme": {
              "canvas": "#FFFAF2",
              "surface": "#FFFFFF",
              "surfaceMuted": "#FDF0D8",
              "ink": "#472D12",
              "muted": "#7D6647",
              "accent": "#AD650E",
              "accentContrast": "#FFFFFF",
              "border": "#F0D7AE",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1160,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "budget-net-total",
              "kind": "metric",
              "title": "Net total",
              "query": {
                "collections": [
                  "budget_entry"
                ],
                "limit": 200
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "valueField": "signed_amount"
              },
              "props": {
                "valueField": "signed_amount",
                "emptyText": "Record income or spending to begin."
              }
            },
            {
              "id": "budget-recent-entry-list",
              "kind": "recordList",
              "title": "Recent movement",
              "query": {
                "collections": [
                  "budget_entry"
                ],
                "limit": 8
              },
              "props": {
                "emptyText": "No household activity yet.",
                "subtitleFields": [
                  "direction",
                  "category",
                  "amount"
                ]
              }
            },
            {
              "id": "budget-month-trend",
              "kind": "widget",
              "widget": "chartBlock",
              "title": "Monthly net",
              "query": {
                "collections": [
                  "budget_entry"
                ],
                "limit": 200
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "groupBy": "month",
                "valueField": "signed_amount",
                "labelField": "month"
              },
              "props": {
                "chartType": "bar",
                "xField": "month",
                "yField": "signed_amount",
                "emptyText": "Monthly movement appears after entries are recorded."
              }
            }
          ]
        },
        "categories": {
          "title": "Plan",
          "subtitle": "Category limits",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "appBarTitle": "Budget",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "categories",
            "tabs": [
              {
                "id": "entries",
                "screen": "entries",
                "label": "Record"
              },
              {
                "id": "overview",
                "screen": "overview",
                "label": "Pulse"
              },
              {
                "id": "categories",
                "screen": "categories",
                "label": "Plan"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Review"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Household"
              }
            ],
            "theme": {
              "canvas": "#FFFAF2",
              "surface": "#FFFFFF",
              "surfaceMuted": "#FDF0D8",
              "ink": "#472D12",
              "muted": "#7D6647",
              "accent": "#AD650E",
              "accentContrast": "#FFFFFF",
              "border": "#F0D7AE",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 900,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "budget-category-editor",
              "kind": "widget",
              "widget": "structuredList",
              "title": "Category budgets",
              "query": {
                "collections": [
                  "budget_category"
                ],
                "limit": 80
              },
              "props": {
                "collection": "budget_category",
                "positionField": "position",
                "placeholder": "Add a category",
                "emptyText": "Add a category budget.",
                "appearance": "plain",
                "metadataFields": [
                  {
                    "field": "limit",
                    "label": "Monthly limit",
                    "type": "number",
                    "sortable": true
                  },
                  {
                    "field": "month",
                    "label": "Month",
                    "type": "text",
                    "filterable": true
                  },
                  {
                    "field": "color",
                    "label": "Color",
                    "type": "text"
                  }
                ],
                "sorts": [
                  "manual",
                  "alphabetic"
                ]
              }
            }
          ]
        },
        "reports": {
          "title": "Review",
          "subtitle": "See the pattern",
          "shell": {
            "layoutMode": "dashboardWorkspace",
            "appBarTitle": "Budget",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "reports",
            "tabs": [
              {
                "id": "entries",
                "screen": "entries",
                "label": "Record"
              },
              {
                "id": "overview",
                "screen": "overview",
                "label": "Pulse"
              },
              {
                "id": "categories",
                "screen": "categories",
                "label": "Plan"
              },
              {
                "id": "reports",
                "screen": "reports",
                "label": "Review"
              },
              {
                "id": "settings",
                "screen": "settings",
                "label": "Household"
              }
            ],
            "theme": {
              "canvas": "#FFFAF2",
              "surface": "#FFFFFF",
              "surfaceMuted": "#FDF0D8",
              "ink": "#472D12",
              "muted": "#7D6647",
              "accent": "#AD650E",
              "accentContrast": "#FFFFFF",
              "border": "#F0D7AE",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#E7EFFA",
              "statusSuccess": "#E1F3E7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE1DF"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1160,
              "narrowPadding": 16,
              "widePadding": 32
            }
          },
          "components": [
            {
              "id": "budget-category-trend",
              "kind": "widget",
              "widget": "chartBlock",
              "title": "By category",
              "query": {
                "collections": [
                  "budget_entry"
                ],
                "limit": 200
              },
              "dataBinding": {
                "source": "query-aggregate",
                "aggregate": "sum",
                "groupBy": "category",
                "valueField": "signed_amount",
                "labelField": "category"
              },
              "props": {
                "chartType": "bar",
                "xField": "category",
                "yField": "signed_amount",
                "emptyText": "Category totals appear after entries are recorded."
              }
            },
            {
              "id": "budget-report-table",
              "kind": "widget",
              "widget": "dataTable",
              "title": "All entries",
              "query": {
                "collections": [
                  "budget_entry"
                ],
                "limit": 200
              },
              "props": {
                "columns": [
                  {
                    "key": "title",
                    "label": "Entry"
                  },
                  {
                    "key": "direction",
                    "label": "Type"
                  },
                  {
                    "key": "category",
                    "label": "Category"
                  },
                  {
                    "key": "amount",
                    "label": "Amount"
                  },
                  {
                    "key": "month",
                    "label": "Month"
                  }
                ],
                "emptyText": "No entries to report."
              }
            }
          ]
        },
        "settings": {
          "title": "Household",
          "subtitle": "Shared defaults",
          "shell": {
            "layoutMode": "settingsWorkspace",
            "appBarTitle": "Budget",
            "scrollable": true,
            "density": "comfortable",
            "activeTab": "settings",
            "tabs": [
              {
                "id": "entries",
                "screen": "entries",
                "label": "Record"
              },
              {
