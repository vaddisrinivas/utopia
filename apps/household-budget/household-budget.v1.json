                  {
                    "id": "currency",
                    "label": "Currency",
                    "type": "text"
                  },
                  {
                    "id": "household",
                    "label": "Household name",
                    "type": "text"
                  },
                  {
                    "id": "month_start",
                    "label": "Month starts on",
                    "type": "number"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
