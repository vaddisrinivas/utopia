        "views": [
          "overview"
        ]
      },
      {
        "id": "capture",
        "label": "Assign",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "detail",
        "label": "Shift",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "history",
        "label": "Ledger",
        "collections": [
