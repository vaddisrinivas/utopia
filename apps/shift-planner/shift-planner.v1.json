{
  "schemaVersion": "wonder.app-package.v2",
  "id": "shift-planner",
  "version": "1.0.0",
  "collections": {
    "primary": {
      "id": "primary",
      "fields": {
        "person": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "starts_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "ends_at": {
          "type": "timestamp",
          "required": false,
          "indexed": true
        },
        "duration_hours": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "break_minutes": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "hourly_rate": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "paid_hours": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "estimated_pay": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "position": {
          "type": "number",
          "required": false,
          "indexed": false
        },
        "role": {
          "type": "text",
          "required": false,
          "indexed": false
        },
        "status": {
          "type": "text",
          "required": false,
          "indexed": false
        },
        "notes": {
          "type": "text",
          "required": false,
          "indexed": false
        }
      }
    }
  },
  "queries": {
    "shift-records": {
      "from": "primary",
      "orderBy": [
        {
          "field": "person",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "overview": {
      "id": "overview",
      "query": "shift-records",
      "mode": "list",
      "fields": [
        "person",
        "starts_at",
        "ends_at",
        "duration_hours",
        "break_minutes",
        "hourly_rate",
        "paid_hours",
        "estimated_pay",
        "role",
        "status",
        "notes"
      ]
    }
  },
  "computedFields": [
    {
      "id": "duration_hours",
      "collection": "primary",
      "dependsOn": [],
      "expression": {
        "date_diff": {
          "start": {
            "var": "record.starts_at"
          },
          "end": {
            "var": "record.ends_at"
          },
          "unit": "hours",
          "inputKind": "instant",
          "timezone": "UTC",
          "onMissing": "zero",
          "onInvalid": "error",
          "onEndBeforeStart": "error"
        }
      }
    },
    {
      "id": "paid_hours",
      "collection": "primary",
      "dependsOn": [
        "duration_hours"
      ],
      "expression": {
        "-": [
          {
            "var": "computed.duration_hours"
          },
          {
            "/": [
              {
                "var": "record.break_minutes"
              },
              60
            ]
          }
        ]
      }
    },
    {
      "id": "estimated_pay",
      "collection": "primary",
      "dependsOn": [
        "paid_hours"
      ],
      "expression": {
        "*": [
          {
            "var": "computed.paid_hours"
          },
          {
            "var": "record.hourly_rate"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "shift-planner-schema-validates",
    "shift-planner-defining-task",
    "shift-planner-time-window-preserved",
    "shift-planner-duration-is-deterministic",
    "shift-planner-break-and-pay-are-deterministic",
    "shift-planner-generic-ui-only"
  ],
  "presentation": {
    "label": "Shift Planner",
    "homeSurface": "overview",
    "surfaces": [
      {
        "id": "overview",
        "label": "Roster",
        "collections": [
