      "icon": "calendar-clock",
      "tone": "steel",
      "accent": "#386B8F",
      "canvas": "#F3F8FB",
      "identity": "A roster operations board where coverage gaps, time windows, and paid hours are visible in the first viewport.",
      "rationale": "Shift Planner uses a steel-blue operations identity and roster-first IA, distinct from habit and subscription workflows."
