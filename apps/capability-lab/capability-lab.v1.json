{
  "schemaVersion": "wonder.app-package.v3",
  "id": "capability-lab",
  "version": "0.1.0",
  "collections": {
    "capability": {
      "id": "capability",
      "fields": {
        "collection": {
          "indexed": true,
          "required": true,
          "type": "text"
        },
        "deviceProofRequired": {
          "indexed": true,
          "required": true,
          "type": "boolean"
        },
        "id": {
          "indexed": true,
          "required": true,
          "type": "text"
        },
        "platform": {
          "indexed": true,
          "type": "text"
        },
        "platformExportable": {
          "indexed": true,
          "required": true,
          "type": "boolean"
        },
        "properties": {
          "required": true,
          "type": "json"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "indexed": true,
          "type": "text"
        },
        "supportedContract": {
          "indexed": true,
          "required": true,
          "type": "text"
        },
        "title": {
          "indexed": true,
          "required": true,
          "type": "text"
        },
        "updated_at": {
          "indexed": true,
          "required": true,
          "type": "timestamp"
        }
      }
    }
  },
  "queries": {
    "capabilities": {
      "from": "capability",
      "limit": 100
    }
  },
  "views": {
    "matrix": {
      "id": "matrix",
      "query": "capabilities",
      "mode": "table",
      "fields": [
        "title",
        "supportedContract",
        "platformExportable",
        "deviceProofRequired",
        "platform",
        "status",
        "required"
      ]
    }
  },
  "presentation": {
    "label": "Capability Lab",
    "homeSurface": "matrix",
    "surfaces": [
      {
        "id": "matrix",
        "label": "Matrix",
        "collections": [
          "capability"
        ],
        "views": [
          "matrix"
        ]
      }
    ],
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "matrix",
      "screens": {
        "matrix": {
          "title": "Matrix",
          "subtitle": "One app grows with every platform capability slice.",
          "components": [
            {
              "kind": "widget",
              "props": {
                "capabilityIds": [
                  "camera",
                  "microphone",
                  "files",
                  "notifications",
                  "background_task",
                  "location",
                  "contacts",
                  "calendar",
                  "biometrics",
                  "health",
                  "sensors",
                  "speech",
                  "share",
                  "deep_link",
                  "file_open",
                  "shortcut"
                ],
                "diagnostic": true,
                "executors": [
                  {
                    "capabilityId": "camera",
                    "controls": [
                      "Camera scanner"
                    ],
                    "detail": "Choose camera access and scan a code. Results remain inside the scanner control."
                  },
                  {
                    "capabilityId": "microphone",
                    "controls": [
                      "Microphone exerciser"
                    ],
                    "detail": "Requests recorder consent through the broker, then starts and stops one explicit microphone session if granted."
                  },
                  {
                    "capabilityId": "files",
                    "controls": [
                      "File picker",
                      "File export"
                    ],
                    "detail": "Choose a local file. File export writes a local text artifact only after explicit user action."
                  },
                  {
                    "capabilityId": "notifications",
                    "controls": [
                      "Notification scheduler"
                    ],
                    "detail": "Request notification access, schedule a local reminder, then cancel it from the same control."
                  },
                  {
                    "capabilityId": "location",
                    "controls": [
                      "Location map"
                    ],
                    "detail": "Request foreground location and inspect the returned coordinate before opening a map."
                  },
                  {
                    "capabilityId": "contacts",
                    "controls": [
                      "Contact picker"
                    ],
                    "detail": "Request access and choose one contact. No bulk import is performed."
                  },
                  {
                    "capabilityId": "calendar",
                    "controls": [
                      "Calendar event"
                    ],
                    "detail": "Request access and create one reviewed local event."
                  },
                  {
                    "capabilityId": "biometrics",
                    "controls": [
                      "Biometric gate"
                    ],
                    "detail": "Check hardware and enrollment, then explicitly start local authentication."
                  },
                  {
                    "capabilityId": "health",
                    "controls": [
                      "Health exerciser"
                    ],
                    "detail": "Requests Android Health Connect access through the existing Health bridge. Non-Android shells stay unavailable."
                  },
                  {
                    "capabilityId": "sensors",
                    "controls": [
                      "Sensor readout"
                    ],
                    "detail": "Start a local accelerometer sample and stop it from the same control."
                  },
                  {
                    "capabilityId": "speech",
                    "controls": [
                      "Speech tool"
                    ],
                    "detail": "Speak and stop a local phrase. Speech-to-text remains NOT_RUN."
                  },
                  {
                    "capabilityId": "share",
                    "controls": [
                      "File export"
                    ],
                    "detail": "Share/download runs only from the file export control."
                  },
                  {
                    "capabilityId": "deep_link",
                    "controls": [
                      "Deep-link exerciser"
                    ],
                    "detail": "Opens the declared self link through React Native Linking."
                  },
                  {
                    "capabilityId": "background_task",
                    "controls": [
                      "Background task exerciser"
                    ],
                    "detail": "Loads TaskManager on demand, but background OS execution remains NOT_RUN until a scheduler receipt exists."
                  },
                  {
                    "capabilityId": "file_open",
                    "controls": [
                      "File-open exerciser"
                    ],
                    "detail": "Checks the declared inbound file-open intent. OS file-open event injection remains NOT_RUN."
                  },
                  {
                    "capabilityId": "shortcut",
                    "controls": [
                      "Shortcut exerciser"
                    ],
                    "detail": "Checks the declared shortcut intent. Native shortcut publication remains NOT_RUN."
                  }
                ],
                "observations": [],
                "permissions": [
                  {
                    "deviceProofRequired": true,
                    "id": "camera.scan",
                    "platform": "expo",
                    "platformExportable": true,
                    "status": "awaiting_device_proof",
                    "supportedContract": true
                  },
                  {
                    "deviceProofRequired": true,
                    "id": "document.pick",
                    "platform": "expo",
                    "platformExportable": true,
                    "status": "awaiting_device_proof",
                    "supportedContract": true
                  },
                  {
                    "deviceProofRequired": true,
                    "id": "health.steps",
                    "platform": "android",
                    "platformExportable": true,
                    "status": "awaiting_device_proof",
                    "supportedContract": true
                  },
                  {
                    "deviceProofRequired": true,
                    "id": "speech.speak",
                    "platform": "expo",
                    "platformExportable": true,
                    "status": "awaiting_device_proof",
                    "supportedContract": true
                  },
                  {
                    "deviceProofRequired": true,
                    "id": "contacts.pick-one",
                    "platform": "expo",
                    "platformExportable": true,
                    "status": "awaiting_device_proof",
                    "supportedContract": true
                  },
                  {
                    "deviceProofRequired": false,
                    "id": "contacts.bulk-import",
                    "platform": "expo",
                    "platformExportable": false,
                    "reason": "Bulk contact import has no generic contract; single-contact selection is a separate supported capability.",
                    "status": "blocked",
                    "supportedContract": false
                  }
                ],
                "subtitle": "Run the explicit controls below. Contract support and observed outcomes remain separate.",
                "title": "Capability diagnostics"
              },
              "widget": "permissionCard"
            },
            {
              "kind": "widget",
              "props": {
                "probes": [
                  {
                    "action": "microphone",
                    "capabilityId": "microphone",
                    "cta": "Run microphone probe",
                    "detail": "Request recorder consent through the broker, then start and stop one explicit recorder session if granted.",
                    "title": "Microphone"
                  },
                  {
                    "action": "background_task",
                    "capabilityId": "background_task",
                    "cta": "Check background task",
                    "detail": "Load TaskManager after a tap and report that OS background execution is still NOT_RUN.",
                    "title": "Background task"
                  },
                  {
                    "action": "health",
                    "capabilityId": "health",
                    "cta": "Choose health access",
                    "detail": "Request Android Health Connect permissions through the existing Health bridge.",
                    "title": "Health"
                  },
                  {
                    "action": "deep_link",
                    "capabilityId": "deep_link",
                    "cta": "Open self link",
                    "detail": "Open the declared self link through React Native Linking.",
                    "title": "Deep link",
                    "url": "utopia://capability-lab/matrix?source=capability-lab"
                  },
                  {
                    "action": "file_open",
                    "capabilityId": "file_open",
                    "cta": "Check file-open path",
                    "detail": "Verify the inbound file-open declaration without injecting an OS event.",
                    "title": "File open"
                  },
                  {
                    "action": "shortcut",
                    "capabilityId": "shortcut",
                    "cta": "Check shortcut path",
                    "detail": "Verify the shortcut declaration without claiming shortcut publication.",
                    "title": "Shortcut"
                  }
                ],
                "subtitle": "Six explicit probes for edge native paths. These controls update only local runtime state after a tap.",
                "title": "Frontier exercisers"
              },
              "widget": "capabilityExerciser"
            },
            {
              "kind": "widget",
              "props": {
                "subtitle": "Chart contract surface exercised.",
                "title": "Capability trend"
              },
              "widget": "chartBlock"
            },
            {
              "kind": "widget",
              "props": {
                "subtitle": "Form contract surface exercised.",
                "title": "Manual evidence form"
              },
              "widget": "formCard"
            },
            {
              "kind": "widget",
              "props": {
                "autoStart": false,
                "duration": 600,
                "showControls": true,
                "subtitle": "Timer contract surface exercised.",
                "title": "Proof hold timer"
              },
              "widget": "durationTimer"
            },
            {
              "kind": "widget",
              "props": {
                "columns": [
                  "Capability",
                  "Web",
                  "Android",
                  "iOS",
                  "macOS"
                ],
                "title": "Runtime support"
              },
              "widget": "dataTable"
            },
            {
              "kind": "widget",
              "props": {
                "subtitle": "Media contract surface exercised.",
                "title": "Media block"
              },
              "widget": "mediaBlock"
            },
            {
              "kind": "widget",
              "props": {
                "mimeTypes": [
                  "text/*",
                  "application/pdf"
                ],
                "multiple": false,
                "subtitle": "Pick one local file without upload.",
                "title": "File picker"
              },
              "widget": "filePicker"
            },
            {
              "kind": "widget",
              "props": {
                "content": "Capability Lab export proof",
                "cta": "Export proof",
                "fileName": "capability-lab-proof.txt",
                "mimeType": "text/plain",
                "subtitle": "Create a local text file and open the share/download path.",
                "title": "File export"
              },
              "widget": "fileExport"
            },
            {
              "kind": "widget",
              "props": {
                "barcodeTypes": [
                  "qr",
                  "code128"
                ],
                "title": "Camera scanner"
              },
              "widget": "cameraScanner"
            },
            {
              "kind": "widget",
              "props": {
                "address": "1 Infinite Loop, Cupertino, CA",
                "title": "Location map"
              },
              "widget": "locationMap"
            },
            {
              "kind": "widget",
              "props": {
                "sensor": "accelerometer",
                "title": "Sensor readout"
              },
              "widget": "sensorReadout"
            },
            {
              "kind": "widget",
              "props": {
                "body": "Capability Lab reminder",
                "seconds": 10,
                "title": "Notification scheduler"
              },
              "widget": "notificationScheduler"
            },
            {
              "kind": "widget",
              "props": {
                "title": "Contact picker"
              },
              "widget": "contactPicker"
            },
            {
              "kind": "widget",
              "props": {
                "durationMinutes": 20,
                "eventTitle": "Capability Lab event",
                "startOffsetMinutes": 10,
                "title": "Calendar event"
              },
              "widget": "calendarEvent"
            },
            {
              "kind": "widget",
              "props": {
                "authPrompt": "Unlock Capability Lab",
                "title": "Biometric gate"
              },
              "widget": "biometricGate"
            },
            {
              "kind": "widget",
              "props": {
                "title": "Apple Health"
              },
              "widget": "healthKitStatus"
            },
            {
              "kind": "widget",
              "props": {
                "speechText": "Capability Lab speech proof",
                "title": "Speech tool"
              },
              "widget": "speechTool"
            }
          ]
        }
      }
    },
    "sourceSchemaVersion": "wonder.package-source.v1"
  },
