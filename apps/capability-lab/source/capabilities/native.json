{
  "schemaVersion": "wonder.app-package-native-capabilities.v1",
  "platform": "expo",
  "packages": [
    "expo-audio",
    "expo-camera",
    "expo-calendar",
    "expo-contacts",
    "expo-document-picker",
    "expo-file-system",
    "expo-local-authentication",
    "expo-location",
    "expo-notifications",
    "expo-sensors",
    "expo-sharing",
    "expo-speech",
    "expo-task-manager",
    "react-native-health-connect"
  ],
  "permissions": [
    {
      "id": "record-microphone",
      "platform": "expo",
      "permission": "expo-audio",
      "reason": "Exercise the microphone recorder probe only after explicit user action.",
      "required": false
    },
    {
      "id": "scan-camera",
      "platform": "expo",
      "permission": "expo-camera",
      "reason": "Scan QR and barcodes.",
      "required": false
    },
    {
      "id": "use-location",
      "platform": "expo",
      "permission": "expo-location",
      "reason": "Request current location for map widgets.",
      "required": false
    },
    {
      "id": "schedule-notifications",
      "platform": "expo",
      "permission": "expo-notifications",
      "reason": "Schedule local reminders.",
      "required": false
    },
    {
      "id": "pick-contacts",
      "platform": "expo",
      "permission": "expo-contacts",
      "reason": "Pick one local contact.",
      "required": false
    },
    {
      "id": "create-calendar-event",
      "platform": "expo",
      "permission": "expo-calendar",
      "reason": "Create a reviewed local calendar event.",
      "required": false
    },
    {
      "id": "local-auth",
      "platform": "expo",
      "permission": "expo-local-authentication",
      "reason": "Gate sensitive actions behind local authentication.",
      "required": false
    },
    {
      "id": "read-sensors",
      "platform": "expo",
      "permission": "expo-sensors",
      "reason": "Sample local device sensors.",
      "required": false
    },
    {
      "id": "speak-text",
      "platform": "expo",
      "permission": "expo-speech",
      "reason": "Read package text aloud.",
      "required": false
    },
    {
      "id": "pick-files",
      "platform": "expo",
      "permission": "expo-document-picker",
      "reason": "Exercise file-pick capability in the test app.",
      "required": false
    },
    {
      "id": "share-files",
      "platform": "expo",
      "permission": "expo-sharing",
      "reason": "Exercise file-export share/download capability in the test app.",
      "required": false
    },
    {
      "id": "write-export-files",
      "platform": "expo",
      "permission": "expo-file-system",
      "reason": "Create the local export artifact before the share/download path opens.",
      "required": false
    },
    {
      "id": "health-read-nutrition",
      "platform": "android",
      "permission": "android.permission.health.READ_NUTRITION",
      "reason": "Request Android Health Connect nutrition access during the health probe.",
      "required": false
    },
    {
      "id": "health-read-hydration",
      "platform": "android",
      "permission": "android.permission.health.READ_HYDRATION",
      "reason": "Request Android Health Connect hydration access during the health probe.",
      "required": false
    },
    {
      "id": "health-read-steps",
      "platform": "android",
      "permission": "android.permission.health.READ_STEPS",
      "reason": "Request Android Health Connect steps access during the health probe.",
      "required": false
    },
    {
      "id": "health-read-active-calories",
      "platform": "android",
      "permission": "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
      "reason": "Request Android Health Connect active calorie access during the health probe.",
      "required": false
    },
    {
      "id": "health-read-weight",
      "platform": "android",
      "permission": "android.permission.health.READ_WEIGHT",
      "reason": "Request Android Health Connect weight access during the health probe.",
      "required": false
    },
    {
      "id": "health-write-hydration",
      "platform": "android",
      "permission": "android.permission.health.WRITE_HYDRATION",
      "reason": "Request Android Health Connect hydration write access for guarded round-trip probes.",
      "required": false
    }
  ],
  "intents": [
    {
      "id": "open-capability-lab",
      "platform": "expo",
      "kind": "deep_link",
      "reason": "Open the lab from release-smoke links.",
      "required": false,
      "payload": {
        "scheme": "utopia",
        "target": "capability.lab"
      }
    },
    {
      "id": "future-background-task",
      "platform": "expo",
      "kind": "background_task",
      "reason": "Track background execution without claiming an OS background receipt.",
      "required": false
    },
    {
      "id": "future-file-open",
      "platform": "expo",
      "kind": "file_open",
      "reason": "Track planned inbound file-open support without injecting an OS event.",
      "required": false
    },
    {
      "id": "future-shortcut",
      "platform": "expo",
      "kind": "shortcut",
      "reason": "Track planned native shortcut support without claiming shortcut publication.",
      "required": false
    }
  ]
}
