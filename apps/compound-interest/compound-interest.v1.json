{
  "schemaVersion": "wonder.app-package.v2",
  "id": "compound-interest",
  "version": "1.0.0",
  "collections": {
    "scenario": {
      "id": "scenario",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "principal": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "growth_factor": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "period_label": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "computedFields": [
    {
      "id": "projected_amount",
      "collection": "scenario",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "var": "record.principal"
          },
          {
            "var": "record.growth_factor"
          }
        ]
      }
    },
    {
      "id": "interest_earned",
      "collection": "scenario",
      "dependsOn": [
        "projected_amount"
      ],
      "expression": {
        "-": [
          {
            "var": "computed.projected_amount"
          },
          {
            "var": "record.principal"
          }
        ]
      }
    }
  ],
  "queries": {
    "scenarios": {
      "from": "scenario",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "home": {
      "id": "home",
      "query": "scenarios",
      "mode": "table",
      "fields": [
        "title",
        "principal",
        "growth_factor",
        "projected_amount",
        "interest_earned",
        "period_label"
      ],
      "layout": {
        "size": "feature",
        "tone": "amber"
      }
    },
    "scenarios": {
      "id": "scenarios",
      "query": "scenarios",
      "mode": "table",
      "fields": [
        "title",
        "principal",
        "growth_factor",
        "projected_amount",
        "interest_earned",
        "period_label"
      ],
      "layout": {
        "size": "wide",
        "tone": "blue"
      }
    },
    "comparison": {
      "id": "comparison",
      "query": "scenarios",
      "mode": "chart",
      "fields": [
        "title",
        "projected_amount",
        "interest_earned"
      ],
      "layout": {
        "size": "wide",
        "tone": "amber"
      }
    },
    "breakdown": {
      "id": "breakdown",
      "query": "scenarios",
      "mode": "timeline",
      "fields": [
        "title",
        "principal",
        "growth_factor",
        "projected_amount",
        "interest_earned"
      ],
      "layout": {
        "size": "wide",
        "tone": "neutral"
      }
    },
    "settings": {
      "id": "settings",
      "query": "scenarios",
      "mode": "list",
      "fields": [
        "title",
        "period_label",
        "notes"
      ],
      "layout": {
        "size": "standard",
        "tone": "moss"
      }
    }
  },
  "rules": [],
  "capabilities": [
    "records.read",
    "records.write",
    "offline.local"
  ],
  "acceptanceTests": [
    "principal-growth-factor-inputs-are-required",
    "projected-amount-is-principal-times-factor",
    "interest-earned-is-projection-minus-principal",
