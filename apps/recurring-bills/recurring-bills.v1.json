  "computedFields": [
    {
      "collection": "bill",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            "var": "record.schedule"
          },
          {
            "recurrence_next": {
              "after": {
                "var": "record.as_of"
              },
              "budget": {
                "maxExclusions": 16,
                "maxIterations": 16,
                "maxLookaheadDays": 1500,
                "maxOccurrences": 1,
                "maxOverrides": 16,
                "maxRuleEvaluations": 32
              },
              "schedule": {
                "var": "record.schedule"
              }
            }
          },
          {
            "var": "record.next_due"
          }
        ]
      },
      "id": "next_due"
    },
    {
      "collection": "bill",
      "dependsOn": [
        "next_due"
      ],
      "expression": {
        "if": [
          {
            "var": "record.schedule"
          },
          {
            "recurrence_expand": {
              "after": {
                "var": "record.as_of"
              },
              "budget": {
                "maxExclusions": 16,
                "maxIterations": 32,
                "maxLookaheadDays": 1500,
                "maxOccurrences": 4,
                "maxOverrides": 16,
                "maxRuleEvaluations": 64
              },
              "limit": 4,
              "schedule": {
                "var": "record.schedule"
              }
            }
          },
          {
            "exhausted": false,
            "nextOccurrence": {
              "instant": {
                "var": "record.next_due"
              },
              "source": "direct"
            },
            "occurrences": [
              {
                "instant": {
                  "var": "record.next_due"
                },
                "source": "direct"
              }
            ],
            "status": "direct"
          }
        ]
      },
      "id": "upcoming_due_dates"
    }
  ],
