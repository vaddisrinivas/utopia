          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "medication_settings": {
      "id": "medication_settings",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "timezone": {
          "type": "text"
        },
        "quiet_hours": {
          "type": "text"
        },
        "caregiver_alerts": {
          "type": "boolean"
        },
        "refill_lead_days": {
          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "medication_session-records": {
      "from": "medication_session",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "due-doses": {
      "from": "dose_event",
      "where": {
        "op": "eq",
        "field": "status",
        "value": "due"
      },
      "orderBy": [
        {
          "field": "scheduled_at",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "medications": {
      "from": "medication_plan",
      "orderBy": [
        {
          "field": "drug_name",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "dose-history": {
      "from": "dose_event",
      "orderBy": [
        {
          "field": "recorded_at",
          "direction": "desc"
        }
      ],
      "limit": 200
    },
    "medication-settings": {
      "from": "medication_settings",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 10
    }
  },
  "views": {
    "sessions": {
      "id": "sessions",
      "query": "medication_session-records",
      "mode": "table",
      "fields": [
        "title",
        "status",
        "adherence_percent",
        "days_remaining"
      ]
    },
    "due": {
      "id": "due",
      "query": "due-doses",
      "mode": "list",
      "fields": [
        "title",
        "scheduled_at",
        "status",
        "snoozed_until"
      ]
    },
    "medications": {
      "id": "medications",
      "query": "medications",
      "mode": "table",
      "fields": [
        "drug_name",
        "dosage",
        "status",
        "supply_count",
        "interaction_warning"
      ]
    },
    "history": {
      "id": "history",
      "query": "dose-history",
      "mode": "timeline",
      "fields": [
        "title",
        "scheduled_at",
        "recorded_at",
        "status",
        "supply_after"
      ]
    }
  },
  "computedFields": [
    {
      "id": "adherence_percent",
      "collection": "medication_session",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            ">": [
              {
                "var": [
                  "record.scheduled_doses",
                  0
                ]
              },
              0
            ]
          },
          {
            "*": [
              {
                "/": [
                  {
                    "var": [
                      "record.taken_doses",
                      0
                    ]
                  },
                  {
                    "var": "record.scheduled_doses"
                  }
                ]
              },
              100
            ]
          },
          0
        ]
      }
    },
    {
      "id": "days_remaining",
      "collection": "medication_session",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            ">": [
              {
                "var": [
                  "record.doses_per_day",
                  0
                ]
              },
              0
            ]
          },
          {
            "/": [
              {
                "var": [
                  "record.supply_remaining",
                  0
                ]
              },
              {
                "var": "record.doses_per_day"
              }
            ]
          },
          0
        ]
      }
    }
  ],
  "rules": [
    {
      "id": "dose-reminder-proposal",
      "trigger": {
        "kind": "schedule"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "schedule_medication_reminder"
        }
      },
      "mode": "suggest",
      "maxRunsPerEvent": 1
    },
    {
      "id": "dose-log-proposal",
      "trigger": {
        "kind": "operation"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "record_medication_dose"
        }
      },
      "mode": "suggest",
      "maxRunsPerEvent": 1
    }
  ],
  "capabilities": [
    "records.read",
    "records.write",
    "notifications.schedule",
    "file.export",
    "offline.local"
  ],
  "acceptanceTests": [
    "dose-reminder-and-log",
    "complex-schedule",
    "refill-and-report",
    "gold-wave2e-adherence-oracle",
    "gold-wave2e-no-duplicate-reminders"
  ],
