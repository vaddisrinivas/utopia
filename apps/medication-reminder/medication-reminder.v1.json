          "indexed": true
        },
        "dosage": {
          "type": "text"
        },
        "unit": {
          "type": "text"
        },
        "schedule": {
          "type": "json",
          "required": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "supply_count": {
          "type": "number"
        },
        "doses_per_day": {
          "type": "number"
        },
        "refill_threshold": {
          "type": "number"
        },
        "interaction_warning": {
          "type": "text"
        },
        "caregiver": {
          "type": "text"
        },
        "notes": {
          "type": "text"
        }
