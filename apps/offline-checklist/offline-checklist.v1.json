            {
              "id": "checklist-completed-list",
              "kind": "recordList",
              "title": "Done list",
              "query": {
                "collections": [
                  "checklist_item"
                ],
                "limit": 200
              },
              "props": {
                "emptyText": "No completed items yet.",
                "subtitleFields": [
                  "section",
                  "notes"
                ]
              }
            }
          ]
        },
        "history": {
          "title": "History",
          "subtitle": "See add, edit, complete, delete, offline, and recovery events in order.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "scrollable": true,
            "density": "comfortable",
            "theme": {
              "canvas": "#F7F8F4",
              "surface": "#FFFFFF",
