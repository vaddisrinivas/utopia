              "statusInfo": "#DDEAF7",
              "statusSuccess": "#E3EFD7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE0DD"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1120,
              "narrowPadding": 14,
              "widePadding": 28
            }
          },
          "components": [
            {
              "id": "checklist-language-card",
              "kind": "widget",
              "widget": "recordReviewCard",
              "title": "Language and behavior",
              "props": {
                "title": "Language and behavior",
                "subtitle": "English and Russian labels are included.",
                "badge": "2 languages",
                "emoji": "Aa",
                "items": [
                  {
                    "title": "English",
                    "detail": "Default labels and saved states",
                    "status": "ready"
                  },
                  {
                    "title": "Russian",
                    "detail": "Core checklist labels included",
                    "status": "ready"
                  },
                  {
                    "title": "Multiline notes",
                    "detail": "Release-note requirement preserved",
                    "status": "ready"
                  }
                ],
                "actions": []
              }
            },
            {
              "id": "checklist-settings-editor",
              "kind": "widget",
              "widget": "formCard",
              "title": "Defaults",
              "query": {
                "collections": [
                  "checklist_list"
                ],
                "limit": 20
              },
              "props": {
                "fields": [
                  {
                    "id": "list_type",
                    "label": "Default type",
                    "type": "text"
                  },
                  {
                    "id": "language",
                    "label": "Language",
                    "type": "text"
                  },
                  {
                    "id": "pinned",
                    "label": "Pinned",
                    "type": "text"
                  }
                ],
                "submitLabel": "Save defaults",
                "emptyText": "Defaults are saved locally."
              }
            }
          ]
        }
      }
    }
  }
}
