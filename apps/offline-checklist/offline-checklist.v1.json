      "defaultScreen": "today",
      "navigation": {
        "items": [
          {
            "screen": "today",
            "label": "$l:checklist.today",
            "icon": "check"
          },
          {
            "screen": "lists",
            "label": "Lists",
            "icon": "list"
          },
          {
            "screen": "completed",
            "label": "Done",
            "icon": "check"
          },
          {
            "screen": "history",
            "label": "History",
            "icon": "rotate-ccw"
          },
          {
            "screen": "settings",
            "label": "Settings",
            "icon": "settings"
          }
        ]
      },
      "screens": {
        "today": {
          "title": "$l:checklist.today",
          "subtitle": "$l:checklist.subtitle",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "scrollable": true,
            "density": "compact",
            "theme": {
              "canvas": "#F7F8F4",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E7EBDD",
              "ink": "#1B2118",
              "muted": "#66715E",
              "accent": "#4E6B2E",
              "accentContrast": "#FFFFFF",
              "border": "#D3DCC5",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEAF7",
              "statusSuccess": "#E3EFD7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE0DD"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1120,
              "narrowPadding": 14,
              "widePadding": 28
            }
          },
          "components": [
            {
              "id": "checklist-primary-list",
              "kind": "widget",
              "widget": "quickAddList",
              "title": "$l:checklist.today",
              "query": {
                "collections": [
                  "checklist_item"
                ],
                "limit": 200
              },
              "props": {
                "collection": "checklist_item",
                "checkedField": "checked",
                "positionField": "position",
                "editable": true,
                "deletable": true,
                "autoSaveEdits": true,
                "placeholder": "$l:checklist.placeholder",
                "emptyText": "$l:checklist.empty",
                "noteField": "notes",
                "notePlaceholder": "$l:checklist.addNote",
                "copy": {
                  "newItem": "$l:checklist.newItem",
                  "addItem": "$l:checklist.addItem",
                  "added": "$l:checklist.added",
                  "enterItem": "$l:checklist.enterItem",
                  "addNote": "$l:checklist.addNote",
                  "edit": "$l:checklist.edit",
                  "editItem": "$l:checklist.editItem",
                  "editName": "$l:checklist.editName",
                  "editNote": "$l:checklist.editNote",
                  "done": "$l:checklist.done",
                  "doneEditing": "$l:checklist.doneEditing",
                  "delete": "$l:checklist.delete",
                  "deleteItem": "$l:checklist.deleteItem",
                  "confirmDelete": "$l:checklist.confirmDelete",
                  "saved": "$l:checklist.saved",
                  "deleted": "$l:checklist.deleted"
                },
                "suggestions": [
                  {
                    "title": "Buy milk",
                    "values": {
                      "section": "Shopping",
                      "list_type": "shopping",
                      "checked": false,
                      "position": 10
                    }
                  },
                  {
                    "title": "Call pharmacy",
                    "values": {
                      "section": "Daily",
                      "list_type": "daily",
                      "checked": false,
                      "position": 20
                    }
                  }
                ],
                "commandPolicy": {
                  "autosave": "change",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 10000
                  },
                  "offline": "local",
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 86400000
                  },
                  "accessibleStatus": {
                    "enabled": true
                  }
                }
              }
            },
            {
              "id": "checklist-open-count",
              "kind": "metric",
              "title": "Open items",
              "query": {
                "collections": [
                  "checklist_item"
                ],
                "limit": 200
              },
              "props": {
                "emptyText": "No open items."
              }
            },
            {
              "id": "checklist-offline-status",
              "kind": "widget",
              "widget": "recordContentCard",
              "title": "Offline status",
              "props": {
                "title": "Offline status",
                "subtitle": "Ready without network",
                "body": "Changes save locally first and stay visible after restart. Sync is outside this tiny reference app.",
                "badge": "local",
                "emoji": "OK",
                "chips": [
                  {
                    "label": "Autosave",
                    "value": "on change"
                  },
                  {
                    "label": "Undo",
                    "value": "available"
                  },
                  {
                    "label": "Network",
                    "value": "not required"
                  }
                ],
                "actions": []
              }
            }
          ]
        },
        "lists": {
          "title": "Lists",
          "subtitle": "Keep daily tasks, shopping, trip, and custom lists separate without adding friction.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "scrollable": true,
            "density": "comfortable",
            "theme": {
              "canvas": "#F7F8F4",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E7EBDD",
              "ink": "#1B2118",
              "muted": "#66715E",
              "accent": "#4E6B2E",
              "accentContrast": "#FFFFFF",
              "border": "#D3DCC5",
              "danger": "#B42318",
              "dangerContrast": "#FFFFFF",
              "statusInfo": "#DDEAF7",
              "statusSuccess": "#E3EFD7",
              "statusWarning": "#FFF0C7",
              "statusError": "#FCE0DD"
            },
            "responsive": {
              "breakpoint": 720,
              "maxContentWidth": 1120,
              "narrowPadding": 14,
              "widePadding": 28
            }
          },
          "components": [
            {
              "id": "checklist-list-switcher",
              "kind": "widget",
              "widget": "horizontalRecordCarousel",
              "title": "Pinned lists",
              "query": {
                "collections": [
                  "checklist_list"
                ],
                "limit": 100
              },
              "props": {
                "collection": "checklist_list",
                "titleField": "title",
                "subtitleFields": [
                  "list_type",
                  "language"
                ],
                "emptyText": "Create a daily or shopping list."
              }
            },
            {
              "id": "checklist-list-editor",
              "kind": "widget",
              "widget": "formCard",
              "title": "List setup",
              "query": {
                "collections": [
                  "checklist_list"
                ],
                "limit": 100
              },
              "props": {
                "fields": [
                  {
                    "id": "title",
                    "label": "List name",
                    "type": "text"
                  },
                  {
                    "id": "list_type",
                    "label": "Type",
                    "type": "text"
                  },
                  {
                    "id": "language",
                    "label": "Language",
                    "type": "text"
                  },
                  {
                    "id": "position",
                    "label": "Order",
                    "type": "number"
                  }
                ],
                "submitLabel": "Save list",
                "emptyText": "List setup stays local."
              }
            },
            {
              "id": "checklist-section-shelf",
              "kind": "widget",
              "widget": "groupedRecordShelf",
              "title": "Items by section",
              "query": {
                "collections": [
                  "checklist_item"
                ],
                "limit": 200
              },
              "props": {
                "collection": "checklist_item",
                "groupBy": "section",
                "subtitleFields": [
                  "checked",
                  "notes"
                ],
                "emptyText": "No sectioned items yet."
              }
            }
          ]
        },
        "completed": {
          "title": "Completed",
          "subtitle": "Review finished items and reopen mistakes without hunting through history.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "scrollable": true,
            "density": "comfortable",
            "theme": {
              "canvas": "#F7F8F4",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E7EBDD",
              "ink": "#1B2118",
              "muted": "#66715E",
              "accent": "#4E6B2E",
              "accentContrast": "#FFFFFF",
              "border": "#D3DCC5",
              "danger": "#B42318",
