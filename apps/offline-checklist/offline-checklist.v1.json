                "collections": [
                  "checklist_item"
                ],
                "limit": 50
              },
              "props": {
                "emptyText": "No local changes yet."
              }
            }
          ]
        },
        "settings": {
          "title": "Settings",
          "subtitle": "Choose language, default list behavior, and recovery expectations.",
          "shell": {
            "layoutMode": "collectionWorkspace",
            "scrollable": true,
            "density": "comfortable",
            "theme": {
              "canvas": "#F7F8F4",
              "surface": "#FFFFFF",
              "surfaceMuted": "#E7EBDD",
