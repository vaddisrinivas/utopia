{
  "schemaVersion": "wonder.app-package.v2",
  "id": "offline-checklist",
  "version": "2.0.0",
  "collections": {
    "checklist_item": {
      "id": "checklist_item",
      "fields": {
        "checked": {
          "type": "boolean",
          "required": true,
          "indexed": true
        },
        "section": {
          "type": "text",
          "indexed": true
        },
        "position": {
          "type": "number",
          "indexed": true
        },
        "notes": {
          "type": "text"
        },
        "list_id": {
          "type": "text",
          "indexed": true
        },
        "list_type": {
          "type": "text",
          "indexed": true
        },
        "due_context": {
          "type": "text"
        },
        "updated_offline": {
          "type": "boolean",
          "indexed": true
        }
      }
    },
    "checklist_list": {
      "id": "checklist_list",
      "fields": {
        "list_type": {
          "type": "text",
          "indexed": true
        },
        "pinned": {
          "type": "boolean",
          "indexed": true
        },
        "language": {
          "type": "text",
          "indexed": true
        },
        "position": {
          "type": "number",
          "indexed": true
        }
      }
    },
    "checklist_event": {
      "id": "checklist_event",
      "fields": {
        "item_id": {
          "type": "text",
          "indexed": true
        },
        "event_type": {
          "type": "text",
          "indexed": true
        },
        "happened_at": {
          "type": "timestamp",
          "indexed": true
        },
        "offline": {
          "type": "boolean",
          "indexed": true
        }
      }
    }
  },
  "queries": {
    "checklist-items": {
      "from": "checklist_item",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "open-items": {
      "from": "checklist_item",
      "where": {
        "op": "eq",
        "field": "checked",
        "value": false
      },
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "completed-items": {
      "from": "checklist_item",
      "where": {
        "op": "eq",
        "field": "checked",
        "value": true
      },
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "checklist-lists": {
      "from": "checklist_list",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "checklist-events": {
      "from": "checklist_event",
      "orderBy": [
        {
          "field": "happened_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "checklist-items": {
      "id": "checklist-items",
      "query": "checklist-items",
      "mode": "list",
      "fields": [
        "title",
        "checked",
        "section",
        "position",
        "notes",
        "list_type"
      ]
    },
    "open-items": {
      "id": "open-items",
      "query": "open-items",
      "mode": "list",
      "fields": [
        "title",
        "checked",
        "section",
        "notes"
      ]
    },
    "completed-items": {
      "id": "completed-items",
      "query": "completed-items",
      "mode": "list",
      "fields": [
        "title",
        "checked",
        "section",
        "notes"
      ]
    },
    "checklist-lists": {
      "id": "checklist-lists",
      "query": "checklist-lists",
      "mode": "list",
      "fields": [
        "title",
        "list_type",
        "pinned",
        "language"
      ]
    },
    "checklist-events": {
      "id": "checklist-events",
      "query": "checklist-events",
      "mode": "timeline",
      "fields": [
        "title",
        "item_id",
        "event_type",
        "happened_at",
        "offline"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "daily-tasks",
    "checklist-notes",
    "shopping-list-use",
    "offline-operation",
    "automatic-saving",
    "quick-add-delete",
    "english-russian-language-support"
  ],
  "presentation": {
    "label": "Offline Checklist",
    "homeSurface": "today",
    "surfaces": [
      {
        "id": "today",
        "label": "Today",
        "icon": "check",
        "collections": [
          "checklist_item"
        ],
        "views": [
          "open-items"
        ]
      },
      {
        "id": "lists",
        "label": "Lists",
        "icon": "list",
        "collections": [
          "checklist_list",
          "checklist_item"
        ],
        "views": [
          "checklist-lists",
          "checklist-items"
        ]
      },
      {
        "id": "completed",
        "label": "Done",
        "icon": "check",
        "collections": [
          "checklist_item"
        ],
        "views": [
          "completed-items"
        ]
      },
      {
        "id": "history",
        "label": "History",
        "icon": "rotate-ccw",
        "collections": [
          "checklist_event"
        ],
        "views": [
          "checklist-events"
        ]
      },
      {
        "id": "settings",
        "label": "Settings",
        "icon": "settings",
        "collections": [
          "checklist_list",
          "checklist_item"
        ],
        "views": [
          "checklist-lists",
          "checklist-items"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "check",
      "tone": "moss",
      "accent": "#4E6B2E",
      "canvas": "#F7F8F4"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "localization": {
        "defaultLocale": "en",
        "fallbackLocale": "en",
        "messages": {
          "en": {
            "checklist.title": "Offline Checklist",
