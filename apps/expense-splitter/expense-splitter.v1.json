{
  "schemaVersion": "wonder.app-package.v2",
  "id": "expense-splitter",
  "version": "2.0.0",
  "collections": {
    "group": {
      "id": "group",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "currency": {
          "type": "text",
          "indexed": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "person": {
      "id": "person",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "key": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "email": {
          "type": "text",
          "indexed": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "weight": {
          "type": "number"
        },
        "updated_at": {
          "type": "timestamp",
          "indexed": true
        }
      }
    },
    "split": {
      "id": "split",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "person_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "expense_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "category": {
          "type": "text",
          "indexed": true
        },
        "paid_amount": {
          "type": "number",
          "required": true
        },
        "share_amount": {
          "type": "number",
          "required": true
        },
        "expense_date": {
          "type": "timestamp",
          "indexed": true
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "settlement_summary": {
      "id": "settlement_summary",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "settlements": {
          "type": "json"
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "indexed": true
        }
      }
    }
  },
  "queries": {
    "groups": {
      "from": "group",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 25
    },
    "people": {
      "from": "person",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 50
    },
    "splits": {
      "from": "split",
      "orderBy": [
        {
          "field": "expense_date",
          "direction": "desc"
        },
        {
          "field": "id",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "summary": {
      "from": "settlement_summary",
      "orderBy": [
        {
          "field": "id",
          "direction": "asc"
        }
      ],
      "limit": 1
    }
  },
  "views": {
    "groups": {
      "id": "groups",
      "query": "groups",
      "mode": "list",
      "fields": [
        "title",
        "currency",
        "status"
      ]
    },
    "people": {
      "id": "people",
      "query": "people",
      "mode": "list",
      "fields": [
        "title",
        "paid_total",
        "owed_total",
        "balance"
      ]
    },
    "splits": {
      "id": "splits",
      "query": "splits",
      "mode": "table",
      "fields": [
        "title",
        "person_id",
        "expense_id",
        "paid_amount",
        "share_amount",
        "category"
      ]
    },
    "summary": {
      "id": "summary",
      "query": "summary",
      "mode": "table",
      "fields": [
        "title",
        "settlements"
      ]
    }
  },
  "computedFields": [
    {
      "id": "paid_total",
      "collection": "person",
      "dependsOn": [],
      "expression": {
        "group_sum": {
          "rows": {
            "var": "queries.splits.rows"
          },
          "groupBy": "person_id",
          "equals": {
            "var": [
              "record.key",
              "record.id"
            ]
          },
          "value": "paid_amount"
        }
      }
    },
    {
      "id": "owed_total",
      "collection": "person",
      "dependsOn": [],
      "expression": {
        "group_sum": {
          "rows": {
            "var": "queries.splits.rows"
          },
          "groupBy": "person_id",
          "equals": {
            "var": [
              "record.key",
              "record.id"
            ]
          },
          "value": "share_amount"
        }
      }
    },
    {
      "id": "balance",
      "collection": "person",
      "dependsOn": [
        "paid_total",
        "owed_total"
      ],
      "expression": {
        "-": [
          {
            "var": "computed.paid_total"
          },
          {
            "var": "computed.owed_total"
          }
        ]
      }
    },
    {
      "id": "settlements",
      "collection": "settlement_summary",
      "dependsOn": [],
      "expression": {
        "balance_transfers": {
          "rows": {
            "var": "queries.splits.rows"
          },
          "participant": "person_id",
          "paid": "paid_amount",
          "owed": "share_amount"
        }
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "grouped-person-balances",
    "deterministic-minimized-settlements",
    "package-only-expression-proof",
    "offline-expense-entry",
    "category-summary"
  ],
