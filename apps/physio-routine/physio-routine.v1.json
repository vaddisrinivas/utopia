{
  "schemaVersion": "wonder.app-package.v2",
  "id": "physio-routine",
  "version": "2.0.0",
  "collections": {
    "care_plan": {
      "id": "care_plan",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "body_area": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "clinician": {
          "type": "text"
        },
        "target_sessions_per_week": {
          "type": "number",
          "required": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "precautions": {
          "type": "text"
        },
        "adherence_target": {
          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "routine_session": {
      "id": "routine_session",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "care_plan_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "started_at": {
          "type": "timestamp",
          "indexed": true
        },
        "finished_at": {
          "type": "timestamp",
          "indexed": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "pain_before": {
          "type": "number"
        },
        "pain_after": {
          "type": "number"
        },
        "pain_change": {
          "type": "number"
        },
        "confidence_after": {
          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "exercise_log": {
      "id": "exercise_log",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "session_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "exercise": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "sets": {
          "type": "number",
          "required": true
        },
        "reps": {
          "type": "number",
          "required": true
        },
        "hold_seconds": {
          "type": "number"
        },
        "total_repetitions": {
          "type": "number"
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "discomfort": {
          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "active-plans": {
      "from": "care_plan",
      "where": {
        "op": "eq",
        "field": "status",
        "value": "active"
      },
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 20
    },
    "open-sessions": {
      "from": "routine_session",
      "where": {
        "op": "neq",
        "field": "status",
        "value": "finished"
      },
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 20
    },
    "recent-sessions": {
      "from": "routine_session",
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "exercise-history": {
      "from": "exercise_log",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 200
    }
  },
  "views": {
    "plans": {
      "id": "plans",
      "query": "active-plans",
      "mode": "list",
      "fields": [
        "title",
        "body_area",
        "clinician",
        "target_sessions_per_week",
        "status"
      ]
    },
    "sessions": {
      "id": "sessions",
      "query": "recent-sessions",
      "mode": "timeline",
      "fields": [
        "title",
        "care_plan_id",
        "pain_before",
        "pain_after",
        "pain_change",
        "status"
      ]
    },
    "exercises": {
      "id": "exercises",
      "query": "exercise-history",
      "mode": "table",
      "fields": [
        "exercise",
        "sets",
        "reps",
        "hold_seconds",
        "total_repetitions",
        "status",
        "discomfort"
      ]
    }
  },
  "computedFields": [
    {
      "id": "pain_change",
      "collection": "routine_session",
      "dependsOn": [],
      "expression": {
        "-": [
          {
            "var": [
              "record.pain_after",
              0
            ]
          },
          {
            "var": [
              "record.pain_before",
              0
            ]
          }
        ]
      }
    },
    {
      "id": "total_repetitions",
      "collection": "exercise_log",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "var": "record.sets"
          },
          {
            "var": "record.reps"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "package-validates",
    "computed-pain-change",
    "computed-repetition-total",
    "generic-step-flow-definition",
    "generic-duration-timer-definition",
    "background-foreground-observe",
    "restart-recovery-confirmed-elapsed",
    "uncertain-elapsed-review-required",
    "completed-session-record",
    "generic-widget-only",
    "gold-from-scratch-presentation",
    "gold-active-routine-workspace",
    "gold-safety-feedback-history"
  ],
