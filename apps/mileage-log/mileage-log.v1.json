          "type": "number"
        },
        "active": {
          "type": "boolean",
          "indexed": true
        },
        "position": {
          "type": "number",
          "indexed": true
        }
      }
    },
    "mileage_preference": {
      "id": "mileage_preference",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "unit": {
          "type": "text",
          "indexed": true
        },
        "currency": {
          "type": "text",
          "indexed": true
        },
        "default_rate": {
          "type": "number"
        },
        "tax_year": {
          "type": "text",
          "indexed": true
        },
        "position": {
          "type": "number",
          "indexed": true
        }
      }
    }
  },
  "queries": {
    "trips": {
      "from": "trip",
      "orderBy": [
        {
          "field": "date",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "business-trips": {
      "from": "trip",
      "where": {
        "field": "trip_type",
        "op": "eq",
        "value": "business"
      },
      "orderBy": [
        {
          "field": "date",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "vehicles": {
      "from": "vehicle",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 50
    },
    "preferences": {
      "from": "mileage_preference",
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 10
    }
  },
  "views": {
    "trips": {
      "id": "trips",
      "query": "trips",
      "mode": "table",
      "fields": [
        "title",
        "date",
        "vehicle_id",
        "trip_type",
        "start_odometer",
        "end_odometer",
        "distance",
        "rate",
        "reimbursement",
        "expense_amount"
      ]
    },
    "business": {
      "id": "business",
      "query": "business-trips",
      "mode": "table",
      "fields": [
        "title",
        "date",
        "vehicle_id",
        "distance",
        "reimbursement"
      ]
    },
    "vehicles": {
      "id": "vehicles",
      "query": "vehicles",
      "mode": "list",
      "fields": [
        "title",
        "unit",
        "default_rate",
        "starting_odometer",
        "active"
      ]
    }
  },
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "distance-derived-from-odometer",
