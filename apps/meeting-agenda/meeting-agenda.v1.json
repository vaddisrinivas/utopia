{
  "schemaVersion": "wonder.app-package.v2",
  "id": "meeting-agenda",
  "version": "2.0.0",
  "collections": {
    "agenda_item": {
      "id": "agenda_item",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "position": {
          "type": "number",
          "indexed": true
        },
        "owner": {
          "type": "text",
          "indexed": true
        },
        "notes": {
          "type": "text"
        },
        "meeting_id": {
          "type": "text",
          "indexed": true
        },
        "duration_minutes": {
          "type": "number",
          "indexed": true
        },
        "decision": {
          "type": "text",
          "indexed": true
        },
        "follow_up_status": {
          "type": "text",
          "indexed": true
        },
        "due_at": {
          "type": "timestamp",
          "indexed": true
        },
        "blocked": {
          "type": "boolean",
          "indexed": true
        }
      }
    },
    "meeting_record": {
      "id": "meeting_record",
      "fields": {
        "position": {
          "type": "number",
          "indexed": true
        },
        "meeting_date": {
          "type": "timestamp",
          "indexed": true
        },
        "facilitator": {
          "type": "text",
          "indexed": true
        },
        "purpose": {
          "type": "text"
        },
        "status": {
          "type": "text",
          "indexed": true
        }
      }
    },
    "agenda_event": {
      "id": "agenda_event",
      "fields": {
        "agenda_item_id": {
          "type": "text",
          "indexed": true
        },
        "event_type": {
          "type": "text",
          "indexed": true
        },
        "happened_at": {
          "type": "timestamp",
          "indexed": true
        },
        "owner": {
          "type": "text",
          "indexed": true
        },
        "note": {
          "type": "text"
        },
        "offline": {
          "type": "boolean",
          "indexed": true
        }
      }
    }
  },
  "queries": {
    "agenda_item-records": {
      "from": "agenda_item",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "prep-items": {
      "from": "agenda_item",
      "where": {
        "op": "neq",
        "field": "follow_up_status",
        "value": "done"
      },
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "follow-up-items": {
      "from": "agenda_item",
      "where": {
        "op": "neq",
        "field": "follow_up_status",
        "value": "none"
      },
      "orderBy": [
        {
          "field": "owner",
          "direction": "asc"
        },
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "owner-load": {
      "from": "agenda_item",
      "orderBy": [
        {
          "field": "owner",
          "direction": "asc"
        },
        {
          "field": "duration_minutes",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "agenda-history": {
      "from": "agenda_event",
      "orderBy": [
        {
          "field": "happened_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "meeting-records": {
      "from": "meeting_record",
      "orderBy": [
        {
          "field": "meeting_date",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "agenda_item-records": {
      "id": "agenda_item-records",
      "query": "agenda_item-records",
      "mode": "list",
      "fields": [
        "title",
        "position",
        "owner",
        "notes",
        "duration_minutes",
        "decision",
        "follow_up_status"
      ]
    },
    "prep-items": {
      "id": "prep-items",
      "query": "prep-items",
      "mode": "list",
      "fields": [
        "title",
        "owner",
        "position",
        "duration_minutes"
      ]
    },
    "follow-up-items": {
      "id": "follow-up-items",
      "query": "follow-up-items",
      "mode": "board",
      "groupBy": "owner",
      "fields": [
        "title",
        "owner",
        "decision",
        "follow_up_status",
        "due_at"
      ]
    },
    "owner-load": {
      "id": "owner-load",
      "query": "owner-load",
      "mode": "chart",
      "fields": [
        "owner",
        "duration_minutes"
      ]
    },
    "agenda-history": {
      "id": "agenda-history",
      "query": "agenda-history",
      "mode": "timeline",
      "fields": [
        "title",
        "event_type",
        "owner",
        "happened_at",
        "note"
      ]
    },
    "meeting-records": {
      "id": "meeting-records",
      "query": "meeting-records",
      "mode": "list",
      "fields": [
        "title",
        "meeting_date",
        "facilitator",
        "purpose",
        "status"
      ]
    }
  },
  "rules": [
    {
      "id": "agenda-follow-up-workflow",
      "trigger": {
        "kind": "query_transition",
        "query": "follow-up-items",
        "transition": "enter"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": "review_agenda_follow_up"
      },
      "mode": "suggest",
      "maxRunsPerEvent": 12
    }
  ],
  "capabilities": [
    "records.write",
    "calendar.create",
    "notifications.schedule",
    "file.export"
  ],
  "acceptanceTests": [
    "meeting-agenda-create-edit-detail",
    "meeting-agenda-order-owner-oracle",
    "meeting-agenda-follow-up-review",
    "meeting-agenda-offline-recovery"
  ],
  "presentation": {
    "label": "Meeting Agenda",
    "homeSurface": "home",
    "visualIdentity": {
      "icon": "list",
      "tone": "facilitator",
      "accent": "#B84A3A",
      "canvas": "#F7F5EF",
      "secondaryAccent": "#284B63"
    },
    "render": {
      "authoringWave": "gpt55-gold-wave2a",
      "presentation": "recreated-from-scratch",
      "runtimeBoundary": "generic-widgets-only"
    },
    "surfaces": [
      {
        "id": "home",
        "label": "Agenda",
        "icon": "list",
        "collections": [
          "agenda_item",
          "meeting_record"
        ],
        "views": [
          "agenda_item-records"
