{
  "schemaVersion": "wonder.app-package.v2",
  "id": "maintenance-parts",
  "version": "2.0.0",
  "collections": {
    "maintenance_part": {
      "id": "maintenance_part",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "position": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "asset": {
          "type": "text",
          "indexed": true
        },
        "quantity": {
          "type": "number",
          "indexed": true
        },
        "notes": {
          "type": "text"
        },
        "reorder_point": {
          "type": "number",
          "indexed": true
        },
        "priority": {
          "type": "text",
          "indexed": true
        },
        "stock_status": {
          "type": "text",
          "indexed": true
        },
        "location": {
          "type": "text",
          "indexed": true
        },
        "supplier": {
          "type": "text",
          "indexed": true
        },
        "unit_cost": {
          "type": "number"
        },
        "compatibility": {
          "type": "text"
        },
        "next_service_at": {
          "type": "timestamp",
          "indexed": true
        }
      }
    },
    "maintenance_asset": {
      "id": "maintenance_asset",
      "fields": {
        "position": {
          "type": "number",
          "indexed": true
        },
        "asset_tag": {
          "type": "text",
          "indexed": true
        },
        "location": {
          "type": "text",
          "indexed": true
        },
        "service_status": {
          "type": "text",
          "indexed": true
        },
        "next_service_at": {
          "type": "timestamp",
          "indexed": true
        }
      }
    },
    "part_event": {
      "id": "part_event",
      "fields": {
        "part_id": {
          "type": "text",
          "indexed": true
        },
        "asset": {
          "type": "text",
          "indexed": true
        },
        "event_type": {
          "type": "text",
          "indexed": true
        },
        "quantity_before": {
          "type": "number"
        },
        "quantity_after": {
          "type": "number"
        },
        "happened_at": {
          "type": "timestamp",
          "indexed": true
        },
        "offline": {
          "type": "boolean",
          "indexed": true
        },
        "note": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "maintenance_part-records": {
      "from": "maintenance_part",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "reorder-parts": {
      "from": "maintenance_part",
      "where": {
        "op": "eq",
        "field": "stock_status",
        "value": "reorder"
      },
      "orderBy": [
        {
          "field": "priority",
          "direction": "asc"
        },
        {
          "field": "asset",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "parts-by-asset": {
      "from": "maintenance_part",
      "orderBy": [
        {
          "field": "asset",
          "direction": "asc"
        },
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "maintenance-assets": {
      "from": "maintenance_asset",
      "orderBy": [
        {
          "field": "position",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "part-events": {
      "from": "part_event",
      "orderBy": [
        {
          "field": "happened_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "maintenance_part-records": {
      "id": "maintenance_part-records",
      "query": "maintenance_part-records",
      "mode": "list",
      "fields": [
        "title",
        "asset",
        "quantity",
        "reorder_point",
        "priority",
        "stock_status",
        "location",
        "supplier"
      ]
    },
    "reorder-parts": {
      "id": "reorder-parts",
      "query": "reorder-parts",
      "mode": "list",
      "fields": [
        "title",
        "asset",
        "quantity",
        "reorder_point",
        "priority",
        "location"
      ]
    },
    "parts-by-asset": {
      "id": "parts-by-asset",
      "query": "parts-by-asset",
      "mode": "board",
      "groupBy": "asset",
      "fields": [
        "title",
        "quantity",
        "priority",
        "stock_status"
      ]
    },
    "maintenance-assets": {
      "id": "maintenance-assets",
      "query": "maintenance-assets",
      "mode": "list",
      "fields": [
        "title",
        "asset_tag",
        "location",
        "service_status",
        "next_service_at"
      ]
    },
    "part-events": {
      "id": "part-events",
      "query": "part-events",
      "mode": "timeline",
      "fields": [
        "title",
        "asset",
        "event_type",
        "quantity_before",
        "quantity_after",
        "happened_at"
      ]
    }
  },
  "rules": [
    {
      "id": "parts-reorder-workflow",
      "trigger": {
        "kind": "query_transition",
        "query": "reorder-parts",
        "transition": "enter"
      },
      "effect": {
        "kind": "propose_operation",
        "operation": "review_parts_reorder"
      },
      "mode": "suggest",
      "maxRunsPerEvent": 12
    }
  ],
  "capabilities": [
    "records.write",
    "notifications.schedule",
    "file.export"
  ],
  "acceptanceTests": [
    "maintenance-parts-create-edit-detail",
    "maintenance-parts-reorder-oracle",
    "maintenance-parts-asset-review",
    "maintenance-parts-offline-recovery"
  ],
  "presentation": {
    "label": "Maintenance Parts List",
    "homeSurface": "home",
    "visualIdentity": {
      "icon": "wrench",
      "tone": "workbench",
      "accent": "#2D6270",
      "canvas": "#F2F6F5",
      "secondaryAccent": "#8B5E34"
    },
    "render": {
      "authoringWave": "gpt55-gold-wave2a",
      "presentation": "recreated-from-scratch",
      "runtimeBoundary": "generic-widgets-only"
    },
    "surfaces": [
