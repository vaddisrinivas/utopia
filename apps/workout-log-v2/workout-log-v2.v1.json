          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "routine_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "started_at": {
          "type": "timestamp",
          "indexed": true
        },
        "finished_at": {
          "type": "timestamp",
          "indexed": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "effort": {
          "type": "number"
        },
        "body_weight": {
          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "set_log": {
      "id": "set_log",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "session_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "exercise": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "set_number": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "reps": {
          "type": "number",
          "required": true
        },
        "weight": {
          "type": "number",
          "required": true
        },
        "distance": {
          "type": "number"
        },
        "duration_seconds": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "completed_at": {
          "type": "timestamp",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "active-routines": {
      "from": "routine",
      "where": {
        "op": "eq",
        "field": "status",
        "value": "active"
      },
      "orderBy": [
        {
          "field": "last_completed_at",
          "direction": "desc"
        }
      ],
      "limit": 50
    },
    "open-sessions": {
      "from": "workout_session",
      "where": {
        "op": "neq",
        "field": "status",
        "value": "finished"
      },
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 20
    },
    "recent-sessions": {
      "from": "workout_session",
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "recent-sets": {
      "from": "set_log",
      "orderBy": [
        {
          "field": "completed_at",
          "direction": "desc"
        }
      ],
      "limit": 200
    }
  },
  "views": {
    "routines": {
      "id": "routines",
      "query": "active-routines",
      "mode": "list",
      "fields": [
        "title",
        "goal",
        "level",
        "estimated_minutes",
        "status"
      ]
    },
    "sessions": {
      "id": "sessions",
      "query": "recent-sessions",
      "mode": "timeline",
      "fields": [
        "title",
        "routine_id",
        "started_at",
        "finished_at",
        "status",
        "effort"
      ]
    },
    "sets": {
      "id": "sets",
      "query": "recent-sets",
      "mode": "table",
      "fields": [
        "exercise",
        "set_number",
        "reps",
        "weight",
        "volume",
        "completed_at"
      ]
    }
  },
  "computedFields": [
    {
      "id": "volume",
      "collection": "set_log",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "var": "record.reps"
          },
          {
            "var": "record.weight"
          }
        ]
      }
    },
    {
      "id": "estimated_one_rep_max",
      "collection": "set_log",
      "dependsOn": [
        "volume"
      ],
      "expression": {
        "*": [
          {
            "var": "record.weight"
          },
          {
            "+": [
              1,
              {
                "/": [
                  {
                    "var": "record.reps"
                  },
                  30
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "package-validates",
    "computed-set-volume",
    "generic-step-flow-definition",
