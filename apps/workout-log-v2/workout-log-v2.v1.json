          "type": "json",
          "required": true
        },
        "goal": {
          "type": "text",
          "indexed": true
        },
        "level": {
          "type": "text",
          "indexed": true
        },
        "estimated_minutes": {
          "type": "number"
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "last_completed_at": {
          "type": "timestamp",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "workout_session": {
      "id": "workout_session",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
