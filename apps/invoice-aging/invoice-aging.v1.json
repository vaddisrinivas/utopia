{
  "schemaVersion": "wonder.app-package.v2",
  "id": "invoice-aging",
  "version": "2.0.0",
  "collections": {
    "primary": {
      "id": "primary",
      "fields": {
        "client": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "amount": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "issued_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "due_at": {
          "type": "timestamp",
          "required": true,
          "indexed": false
        },
        "as_of": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "status": {
          "type": "text",
          "required": false,
          "indexed": false
        },
        "days_since_issue": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "terms_days": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "overdue_days": {
          "type": "number"
        },
        "age_bucket": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "invoice-records": {
      "from": "primary",
      "orderBy": [
        {
          "field": "client",
          "direction": "desc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "overview": {
      "id": "overview",
      "query": "invoice-records",
      "mode": "list",
      "fields": [
        "client",
        "amount",
        "issued_at",
        "due_at",
        "terms_days",
        "days_since_issue",
        "days_outstanding",
        "overdue_days",
        "age_bucket",
        "status"
      ]
    }
  },
  "computedFields": [
    {
      "id": "days_since_issue",
      "collection": "primary",
      "dependsOn": [],
      "expression": {
        "date_diff": {
          "start": {
            "var": "record.issued_at"
          },
          "end": {
            "var": "record.as_of"
          },
          "unit": "days",
          "inputKind": "date",
          "timezone": "UTC",
          "onMissing": "error",
          "onInvalid": "error",
          "onEndBeforeStart": "error"
        }
      }
    },
    {
      "id": "days_outstanding",
      "collection": "primary",
      "dependsOn": [],
      "expression": {
        "date_diff": {
          "start": {
            "var": "record.due_at"
          },
          "end": {
            "var": "record.as_of"
          },
          "unit": "days",
          "inputKind": "date",
          "timezone": "UTC",
          "onMissing": "error",
          "onInvalid": "error",
          "onEndBeforeStart": "negative"
        }
      }
    },
    {
      "id": "overdue_days",
      "collection": "primary",
      "dependsOn": [
        "days_outstanding"
      ],
      "expression": {
        "if": [
          {
            ">": [
              {
                "var": "computed.days_outstanding"
              },
              0
            ]
          },
          {
            "var": "computed.days_outstanding"
          },
          0
        ]
      }
    },
    {
      "id": "age_bucket",
      "collection": "primary",
      "dependsOn": [
        "overdue_days"
      ],
      "expression": {
        "if": [
          {
            ">": [
              {
                "var": "computed.overdue_days"
              },
              90
            ]
          },
          "90+",
          {
            ">": [
              {
                "var": "computed.overdue_days"
              },
              60
            ]
          },
          "61-90",
          {
            ">": [
              {
                "var": "computed.overdue_days"
              },
              30
            ]
          },
          "31-60",
          {
            ">": [
              {
                "var": "computed.overdue_days"
              },
              0
            ]
          },
          "1-30",
          "current"
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "invoice-aging-schema-validates",
    "invoice-aging-defining-task",
    "invoice-aging-computed-fields-deterministic",
    "invoice-aging-age-buckets-deterministic",
    "invoice-aging-generic-ui-only"
  ],
  "presentation": {
    "label": "Invoice Aging",
    "homeSurface": "overview",
    "surfaces": [
      {
        "id": "overview",
        "label": "Aging desk",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "capture",
        "label": "Record invoice",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "reports",
        "label": "Aging report",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "history",
        "label": "History",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      },
      {
        "id": "settings",
        "label": "Settings",
        "collections": [
          "primary"
        ],
        "views": [
          "overview"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "hourglass",
      "tone": "amber",
      "accent": "#8F2E2B",
      "canvas": "#FAF7F5",
      "identity": "A collections cockpit that puts overdue exposure, client priority, and next follow-up in the first viewport.",
      "typography": {
        "heading": "collections desk",
        "body": "aging ledger"
      },
      "rationale": "Quiet graphite and red status accents make risk visible without copying invoice-review blue or fuel green."
