                  "autosave": "blur",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 10000
                  },
                  "offline": "queue",
                  "validation": {
                    "mode": "submit",
                    "requiredFields": [
                      "client",
                      "amount",
                      "issued_at",
                      "due_at",
                      "as_of",
                      "terms_days"
                    ]
                  },
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 604800000
                  },
                  "accessibleStatus": {
                    "enabled": true,
                    "labels": {
                      "pending": "Saving changes",
                      "saved": "Changes saved",
                      "error": "Fix highlighted fields",
                      "queued": "Saved offline",
