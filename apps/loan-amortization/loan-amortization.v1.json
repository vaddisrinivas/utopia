{
  "schemaVersion": "wonder.app-package.v2",
  "id": "loan-amortization",
  "version": "1.0.0",
  "collections": {
    "loan": {
      "id": "loan",
      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "principal": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "annual_rate_percent": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "payment": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "period_label": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "loans": {
      "from": "loan",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "loans": {
      "id": "loans",
      "query": "loans",
      "mode": "table",
      "fields": [
        "title",
        "principal",
        "annual_rate_percent",
        "payment",
        "period_interest",
        "principal_payment",
        "remaining_principal"
      ]
    }
  },
  "computedFields": [
    {
      "id": "period_interest",
      "collection": "loan",
      "dependsOn": [],
      "expression": {
        "/": [
          {
            "*": [
              {
                "var": "record.principal"
              },
              {
                "var": "record.annual_rate_percent"
              }
            ]
          },
          1200
        ]
      }
    },
    {
      "id": "principal_payment",
      "collection": "loan",
      "dependsOn": [
        "period_interest"
      ],
      "expression": {
        "-": [
          {
            "var": "record.payment"
          },
          {
            "var": "computed.period_interest"
          }
        ]
      }
    },
    {
      "id": "remaining_principal",
      "collection": "loan",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            "<=": [
              {
                "-": [
                  {
                    "var": "record.principal"
                  },
                  {
                    "var": "record.payment"
                  }
                ]
              },
              0
            ]
          },
          0,
          {
            "-": [
              {
                "var": "record.principal"
              },
              {
                "var": "record.payment"
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "principal-rate-payment-inputs-are-required",
    "monthly-interest-is-principal-times-annual-rate-over-1200",
    "principal-payment-is-payment-minus-period-interest",
    "remaining-principal-floors-at-zero",
    "full-amortization-schedule-and-payment-formula-are-explicit-boundary"
  ],
