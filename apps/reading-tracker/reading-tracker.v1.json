{
  "schemaVersion": "wonder.app-package.v2",
  "id": "reading-tracker",
  "version": "2.0.0",
  "collections": {
    "book": {
      "id": "book",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "author": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "isbn": {
          "type": "text",
          "indexed": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "total_pages": {
          "type": "number",
          "required": true
        },
        "pages_read": {
          "type": "number",
          "required": true,
          "indexed": true
        },
        "started_at": {
          "type": "timestamp",
          "indexed": true
        },
        "finished_at": {
          "type": "timestamp",
          "indexed": true
        },
        "rating": {
          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    },
    "reading_session": {
      "id": "reading_session",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "book_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "started_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "finished_at": {
          "type": "timestamp",
          "indexed": true
        },
        "start_page": {
          "type": "number",
          "required": true
        },
        "end_page": {
          "type": "number",
          "required": true
        },
        "minutes": {
          "type": "number"
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "current-books": {
      "from": "book",
      "where": {
        "field": "status",
        "op": "eq",
        "value": "reading"
      },
      "orderBy": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "limit": 30
    },
    "library": {
      "from": "book",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 200
    },
    "sessions": {
      "from": "reading_session",
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 200
    }
  },
  "views": {
    "current": {
      "id": "current",
      "query": "current-books",
      "mode": "list",
      "fields": [
        "title",
        "author",
        "pages_read",
        "total_pages",
        "progress_ratio",
        "started_at"
      ]
    },
    "library": {
      "id": "library",
      "query": "library",
      "mode": "table",
      "fields": [
        "title",
        "author",
        "status",
        "pages_read",
        "total_pages",
        "progress_ratio",
        "rating"
      ]
    },
    "sessions": {
      "id": "sessions",
      "query": "sessions",
      "mode": "timeline",
      "fields": [
        "title",
        "book_id",
        "started_at",
        "finished_at",
        "start_page",
        "end_page",
        "pages_completed",
        "minutes"
      ]
    }
  },
  "computedFields": [
    {
      "id": "progress_ratio",
      "collection": "book",
      "dependsOn": [],
      "expression": {
        "if": [
          {
            ">": [
              {
                "var": "record.total_pages"
              },
              0
            ]
          },
          {
            "/": [
              {
                "var": "record.pages_read"
              },
              {
                "var": "record.total_pages"
              }
            ]
          },
          0
        ]
      }
    },
    {
      "id": "pages_completed",
      "collection": "reading_session",
      "dependsOn": [],
      "expression": {
        "-": [
          {
            "var": "record.end_page"
          },
          {
            "var": "record.start_page"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "package-validates",
    "computed-reading-progress",
    "computed-session-pages",
    "generic-widget-only",
    "gold-product-shell",
    "gold-screen-navigation",
    "gold-empty-error-offline-recovery-states",
    "restart-recovery-confirmed-elapsed",
    "uncertain-elapsed-review-required",
    "gpt55-gold-wave3b-rebuild",
    "reading-progress-oracle-preserved",
    "reading-first-viewport-resume"
  ],
  "presentation": {
    "label": "Reading Tracker",
    "homeSurface": "resume",
    "surfaces": [
      {
        "id": "resume",
        "label": "Resume",
        "icon": "book-open",
        "collections": [
          "book",
          "reading_session"
        ],
        "views": [
          "current",
          "library"
        ]
      },
      {
        "id": "library",
        "label": "Library",
        "icon": "search",
        "collections": [
          "book",
          "reading_session"
        ],
        "views": [
          "current",
          "library"
        ]
      },
      {
        "id": "journal",
        "label": "Journal",
        "icon": "edit-3",
        "collections": [
          "book",
          "reading_session"
        ],
        "views": [
          "sessions"
        ]
      },
      {
        "id": "stats",
        "label": "Stats",
        "icon": "bar-chart",
        "collections": [
          "book",
          "reading_session"
        ],
        "views": [
          "current",
          "library"
        ]
      },
      {
        "id": "settings",
        "label": "Privacy",
        "icon": "settings",
        "collections": [
          "book",
          "reading_session"
        ],
        "views": [
          "current",
          "library"
        ]
      }
    ],
    "visualIdentity": {
      "icon": "book-open",
