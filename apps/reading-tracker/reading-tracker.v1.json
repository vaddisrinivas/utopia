                "persistedSession": true,
                "confirmUncertainElapsed": true,
                "completionRecord": {
                  "collection": "reading_session",
                  "title": "Timed reading session",
                  "properties": {
                    "notes": "Timer completed"
                  }
                }
              }
            },
            {
              "id": "reading-log-session-action",
              "kind": "action",
              "title": "Log reading session",
