            {
              "id": "reading-progress-control",
              "kind": "widget",
              "widget": "valueControl",
              "title": "Pages read",
              "query": {
                "collections": [
                  "book"
                ],
                "match": "reading",
                "limit": 1
              },
              "props": {
                "collection": "book",
                "valueField": "pages_read",
                "recordId": "book-primary",
                "recordTitle": "Current book",
                "initialValue": 0,
                "step": 5,
                "min": 0,
                "precision": 0,
                "unit": "pages",
                "commandPolicy": {
                  "autosave": "manual",
                  "optimistic": true,
                  "undo": {
                    "enabled": true,
                    "windowMs": 300000
                  },
                  "confirmation": {
                    "required": false,
                    "message": "Apply Page progress?"
                  },
                  "offline": "queue",
                  "validation": {
                    "mode": "submit",
                    "requiredFields": [
                      "pages_read"
                    ]
                  },
                  "draftPersistence": {
                    "enabled": true,
                    "scope": "local"
                  },
                  "restartRecovery": {
                    "enabled": true,
                    "maxAgeMs": 604800000
                  },
                  "accessibleStatus": {
                    "enabled": true,
                    "labels": {
                      "pending": "Saving page progress",
                      "saved": "Page progress saved",
                      "error": "Page progress save failed",
                      "queued": "Page progress queued offline",
                      "undone": "Page progress undone",
                      "cancelled": "Page progress cancelled"
                    }
                  }
                }
              }
            },
            {
              "id": "reading-timer",
              "kind": "widget",
              "widget": "durationTimer",
              "title": "Reading timer",
