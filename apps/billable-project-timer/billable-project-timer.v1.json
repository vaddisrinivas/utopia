{
  "schemaVersion": "wonder.app-package.v2",
  "id": "billable-project-timer",
  "version": "2.0.0",
  "collections": {
    "client": {
      "id": "client",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "default_rate": {
          "type": "number"
        },
        "currency": {
          "type": "text"
        },
        "status": {
          "type": "text",
          "indexed": true
        },
        "contact": {
          "type": "text"
        },
        "rounding_policy": {
          "type": "text"
        }
      }
    },
    "billable_entry": {
      "id": "billable_entry",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "client_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "project": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "task": {
          "type": "text",
          "indexed": true
        },
        "started_at": {
          "type": "timestamp",
          "indexed": true
        },
        "ended_at": {
          "type": "timestamp",
          "indexed": true
        },
        "duration_minutes": {
          "type": "number",
          "required": true
        },
        "hourly_rate": {
          "type": "number",
          "required": true
        },
        "billable_amount": {
          "type": "number"
        },
        "invoice_status": {
          "type": "text",
          "indexed": true
        },
        "timer_status": {
          "type": "text",
          "indexed": true
        },
        "sync_status": {
          "type": "text",
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "active-clients": {
      "from": "client",
      "where": {
        "op": "eq",
        "field": "status",
        "value": "active"
      },
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 50
    },
    "running-entry": {
      "from": "billable_entry",
      "where": {
        "op": "eq",
        "field": "timer_status",
        "value": "running"
      },
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 1
    },
    "today-entries": {
      "from": "billable_entry",
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "uninvoiced": {
      "from": "billable_entry",
      "where": {
        "op": "eq",
        "field": "invoice_status",
        "value": "uninvoiced"
      },
      "orderBy": [
        {
          "field": "started_at",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "client-rates": {
      "from": "client",
      "orderBy": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    }
  },
  "views": {
    "clients": {
      "id": "clients",
      "query": "active-clients",
      "mode": "table",
      "fields": [
        "title",
        "default_rate",
        "currency",
        "status",
        "rounding_policy"
      ]
    },
    "recent": {
      "id": "recent",
      "query": "today-entries",
      "mode": "timeline",
      "fields": [
        "title",
        "client_id",
        "project",
        "task",
        "duration_minutes",
        "hourly_rate",
        "billable_amount",
        "invoice_status"
      ]
    },
    "uninvoiced": {
      "id": "uninvoiced",
      "query": "uninvoiced",
      "mode": "table",
      "fields": [
        "project",
        "task",
        "duration_minutes",
        "hourly_rate",
        "billable_amount",
        "invoice_status"
      ]
    }
  },
  "computedFields": [
    {
      "id": "billable_amount",
      "collection": "billable_entry",
      "dependsOn": [],
      "expression": {
        "*": [
          {
            "/": [
              {
                "var": "record.duration_minutes"
              },
              60
            ]
          },
          {
            "var": "record.hourly_rate"
          }
        ]
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "persisted-project-duration-timer",
    "background-foreground-observe",
    "restart-recovery-confirmed-elapsed",
    "uncertain-elapsed-review-required",
    "completed-session-record",
    "computed-billable-amount",
    "generic-uninvoiced-entry-table",
    "gold-from-scratch-presentation",
    "gold-active-session-workspace",
    "gold-completion-review-history"
  ],
