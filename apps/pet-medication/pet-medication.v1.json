{
  "schemaVersion": "wonder.app-package.v2",
  "id": "pet-medication",
  "version": "2.0.0",
  "collections": {
    "medication": {
      "id": "medication",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "pet_name": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "dose": {
          "type": "text",
          "required": true
        },
        "route": {
          "type": "text",
          "indexed": true
        },
        "prescriber": {
          "type": "text"
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "as_of": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "schedule": {
          "type": "json",
          "required": true
        },
        "instructions": {
          "type": "text"
        }
      }
    },
    "dose_log": {
      "id": "dose_log",
      "fields": {
        "id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "collection": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "updated_at": {
          "type": "timestamp",
          "required": true,
          "indexed": true
        },
        "properties": {
          "type": "json",
          "required": true
        },
        "medication_id": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "pet_name": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "scheduled_at": {
          "type": "timestamp",
          "indexed": true
        },
        "given_at": {
          "type": "timestamp",
          "indexed": true
        },
        "status": {
          "type": "text",
          "required": true,
          "indexed": true
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "queries": {
    "active-medications": {
      "from": "medication",
      "where": {
        "field": "status",
        "op": "eq",
        "value": "active"
      },
      "orderBy": [
        {
          "field": "pet_name",
          "direction": "asc"
        },
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "limit": 100
    },
    "dose-history": {
      "from": "dose_log",
      "orderBy": [
        {
          "field": "scheduled_at",
          "direction": "desc"
        }
      ],
      "limit": 200
    }
  },
  "views": {
    "medications": {
      "id": "medications",
      "query": "active-medications",
      "mode": "list",
      "fields": [
        "pet_name",
        "title",
        "dose",
        "route",
        "next_dose",
        "instructions"
      ]
    },
    "history": {
      "id": "history",
      "query": "dose-history",
      "mode": "table",
      "fields": [
        "pet_name",
        "title",
        "scheduled_at",
        "given_at",
        "status",
        "notes"
      ]
    }
  },
  "computedFields": [
    {
      "id": "next_dose",
      "collection": "medication",
      "dependsOn": [],
      "expression": {
        "recurrence_next": {
          "schedule": {
            "var": "record.schedule"
          },
          "after": {
            "var": "record.as_of"
          },
          "budget": {
            "maxOccurrences": 1,
            "maxIterations": 64,
            "maxRuleEvaluations": 128,
            "maxLookaheadDays": 365,
            "maxExclusions": 32,
            "maxOverrides": 32
          }
        }
      }
    },
    {
      "id": "dose_window",
      "collection": "medication",
      "dependsOn": [
        "next_dose"
      ],
      "expression": {
        "recurrence_expand": {
          "schedule": {
            "var": "record.schedule"
          },
          "after": {
            "var": "record.as_of"
          },
          "limit": 7,
          "budget": {
            "maxOccurrences": 7,
            "maxIterations": 128,
            "maxRuleEvaluations": 256,
            "maxLookaheadDays": 365,
            "maxExclusions": 32,
            "maxOverrides": 32
          }
        }
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "package-validates",
    "recurrence-next-dose",
    "recurrence-dose-window",
    "generic-widget-only",
    "gold-product-shell",
    "gold-screen-navigation",
    "gold-empty-error-offline-recovery-states",
    "restart-recovery-confirmed-elapsed",
    "uncertain-elapsed-review-required",
    "gpt55-gold-wave3b-rebuild",
    "pet-doseboard-first-viewport",
    "pet-recurrence-oracle-preserved"
  ],
