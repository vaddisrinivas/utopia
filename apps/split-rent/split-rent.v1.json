{
  "schemaVersion": "wonder.app-package.v2",
  "id": "split-rent",
  "version": "1.0.0",
  "collections": {
    "participant": {
      "id": "participant",
      "fields": {
        "weight": { "type": "number", "required": true },
        "notes": { "type": "text" }
      }
    },
    "rent_plan": {
      "id": "rent_plan",
      "fields": {
        "total_rent": { "type": "number", "required": true },
        "status": { "type": "text", "indexed": true }
      }
    }
  },
  "queries": {
    "participants": {
      "from": "participant",
      "orderBy": [{ "field": "id", "direction": "asc" }],
      "limit": 50
    },
    "plans": {
      "from": "rent_plan",
      "orderBy": [{ "field": "id", "direction": "asc" }],
      "limit": 10
    }
  },
  "views": {
    "participants": {
      "id": "participants",
      "query": "participants",
      "mode": "list",
      "fields": ["title", "weight", "notes"]
    },
    "plans": {
      "id": "plans",
      "query": "plans",
      "mode": "table",
      "fields": ["title", "total_rent", "allocations"]
    }
  },
  "computedFields": [
    {
      "id": "allocations",
      "collection": "rent_plan",
      "dependsOn": [],
      "expression": {
        "allocate_weighted": {
          "rows": { "var": "queries.participants.rows" },
          "key": "id",
          "weight": "weight",
          "total": { "var": "record.total_rent" }
        }
      }
    }
  ],
  "rules": [],
  "capabilities": [],
  "acceptanceTests": [
    "weighted-rent-allocation",
    "exact-remainder-distribution",
    "package-only-expression-proof"
  ],
  "presentation": {
    "label": "Split Rent",
    "homeSurface": "home",
    "surfaces": [
      {
        "id": "home",
        "label": "Plan",
        "collections": ["participant", "rent_plan"],
        "views": ["participants", "plans"]
      }
    ],
    "visualIdentity": {
      "icon": "home",
      "tone": "moss",
      "accent": "#237A57",
      "canvas": "#F7FAF8"
    },
    "ui": {
      "schemaVersion": "a2ui.v0_9",
      "defaultScreen": "home",
      "screens": {
        "home": {
          "title": "Split Rent",
          "subtitle": "Allocate rent by room, income, or any agreed weight.",
          "components": [
            {
              "kind": "recordList",
              "title": "Participants",
              "query": { "collections": ["participant"], "limit": 50 },
              "props": {
                "emptyText": "Add participants and weights.",
                "subtitleFields": ["weight", "notes"]
              }
            },
            {
              "kind": "widget",
              "widget": "dataTable",
              "title": "Allocation",
              "query": { "collections": ["rent_plan"], "limit": 1 },
              "props": {
                "itemsFromRecordField": "allocations",
                "columns": [
                  { "key": "key", "label": "Participant" },
                  { "key": "weight", "label": "Weight" },
                  { "key": "amount", "label": "Rent" }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
