  "queries": {
    "active-habits": {
      "from": "habit",
      "limit": 100,
      "orderBy": [
        {
          "direction": "asc",
          "field": "sort_order"
        }
      ],
      "where": {
        "field": "archived",
        "op": "neq",
        "value": true
      }
    },
    "habit-insights": {
      "from": "habit",
      "limit": 50,
      "orderBy": [
        {
          "direction": "desc",
          "field": "score_percent"
        }
      ]
    },
    "recent-checkins": {
      "from": "habit_checkin",
      "limit": 120,
      "orderBy": [
        {
          "direction": "desc",
          "field": "checked_at"
        }
      ]
    },
    "today-habits": {
      "from": "habit",
      "limit": 100,
      "orderBy": [
        {
          "direction": "asc",
          "field": "sort_order"
        }
      ],
      "where": {
        "field": "status",
        "op": "neq",
        "value": "paused"
      }
    }
  },
  "rules": [
    {
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "record_habit_checkin"
        }
      },
      "id": "habit-checkin-proposes-history-update",
      "maxRunsPerEvent": 1,
      "mode": "suggest",
      "trigger": {
        "kind": "operation"
      }
    },
    {
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "schedule_habit_reminders"
        }
      },
      "id": "habit-reminder-schedule-proposal",
      "maxRunsPerEvent": 1,
      "mode": "suggest",
      "trigger": {
        "kind": "schedule"
      }
    },
    {
      "effect": {
        "kind": "propose_operation",
        "operation": {
          "kind": "custom",
          "tool": "export_habit_data"
        }
      },
      "id": "habit-export-proposal",
      "maxRunsPerEvent": 1,
      "mode": "suggest",
      "trigger": {
        "kind": "operation"
      }
    }
  ],
  "schemaVersion": "wonder.app-package.v2",
  "version": "1.0.0",
  "views": {
    "habits": {
      "fields": [
        "title",
        "cadence",
        "target_per_week",
        "current_streak",
        "score_percent"
      ],
      "id": "habits",
      "mode": "table",
      "query": "active-habits"
    },
    "history": {
      "fields": [
        "title",
        "habit_id",
        "checked_at",
        "value",
        "mood"
      ],
      "id": "history",
      "mode": "calendar",
      "query": "recent-checkins"
    },
    "insights": {
      "fields": [
        "title",
        "current_streak",
        "score_percent"
      ],
      "id": "insights",
      "mode": "chart",
      "query": "habit-insights"
    },
    "settings": {
      "fields": [
        "title",
        "status",
        "reminder_time",
        "archived"
      ],
      "id": "settings",
      "mode": "list",
      "query": "active-habits"
    },
    "today": {
      "fields": [
        "title",
        "cadence",
        "current_streak",
        "target_per_week"
      ],
      "id": "today",
      "mode": "list",
      "query": "today-habits"
    }
  }
